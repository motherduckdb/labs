      "title": "Requests by submission channel, 2012–2022",
      "sql": "SELECT strftime(created_date, '%Y') AS yr, CAST(SUM(CASE WHEN open_data_channel_type = 'PHONE' THEN 1 ELSE 0 END) AS DOUBLE) AS phone, CAST(SUM(CASE WHEN open_data_channel_type = 'ONLINE' THEN 1 ELSE 0 END) AS DOUBLE) AS online, CAST(SUM(CASE WHEN open_data_channel_type = 'MOBILE' THEN 1 ELSE 0 END) AS DOUBLE) AS mobile FROM \"sample_data\".\"nyc\".\"service_requests\" WHERE created_date >= '2012-01-01' AND created_date < '2023-01-01' GROUP BY 1 ORDER BY 1",
