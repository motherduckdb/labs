      "title": "Median days to close, 2018–2022",
      "sql": "SELECT agency, CAST(COUNT(*) AS DOUBLE) AS requests, printf('%.1f', MEDIAN(date_diff('hour', created_date, closed_date)) / 24.0) AS median_days, printf('%.1f', 100.0 * SUM(CASE WHEN closed_date IS NULL THEN 1 ELSE 0 END) / COUNT(*)) AS pct_open FROM \"sample_data\".\"nyc\".\"service_requests\" WHERE created_date >= '2018-01-01' AND created_date < '2023-01-01' GROUP BY 1 HAVING COUNT(*) > 100000 ORDER BY MEDIAN(date_diff('hour', created_date, closed_date)) DESC LIMIT 11",
