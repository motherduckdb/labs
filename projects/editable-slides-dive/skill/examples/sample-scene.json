    {
      "id": "chart-trend",
      "type": "chart",
      "name": "Chart: revenue trend",
      "parent": "group-4",
      "x": 96,
      "y": 440,
      "w": 1248,
      "h": 360,
      "z": 60,
      "opacity": 1,
      "sql": "SELECT strftime(d, '%Y-%m') AS month, COALESCE(SUM(CAST(s.revenue AS DOUBLE)), 0) AS revenue, COALESCE(SUM(CAST(s.orders AS DOUBLE)), 0) AS orders FROM generate_series(DATE '2024-01-01', DATE '2024-12-01', INTERVAL 1 MONTH) AS t(d) LEFT JOIN \"my_db\".\"main\".\"monthly_sales\" s ON date_trunc('month', s.order_date) = t.d GROUP BY 1 ORDER BY 1",
      "chart": {
        "kind": "line",
        "stacked": false,
        "x": {
          "key": "month",
          "type": "category",
          "label": "",
          "tickAngle": 0,
          "tickFormat": "none"
        },
        "y": {
          "label": "Revenue (USD)",
          "domain": "zero",
          "tickFormat": "compact"
        },
        "series": [
          {
            "key": "revenue",
            "label": "Revenue",
            "color": "#0777b3"
          }
        ],
        "style": {
          "lineType": "linear",
          "strokeWidth": 2,
          "dot": false
        },
        "grid": {
          "show": true,
          "dash": "3 3"
        },
        "legend": {
          "show": false,
          "position": "top"
        },
        "tooltip": {
          "show": true
        }
