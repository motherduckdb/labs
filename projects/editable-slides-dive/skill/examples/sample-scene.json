      "w": 1248,
      "h": 380,
      "z": 90,
      "opacity": 1,
      "sql": "SELECT 'Q' || CAST(quarter(order_date) AS VARCHAR) AS q, SUM(CASE WHEN region = 'West' THEN CAST(revenue AS DOUBLE) ELSE 0 END) AS west_revenue, SUM(CASE WHEN region = 'East' THEN CAST(revenue AS DOUBLE) ELSE 0 END) AS east_revenue, SUM(CASE WHEN region = 'South' THEN CAST(revenue AS DOUBLE) ELSE 0 END) AS south_revenue, SUM(CASE WHEN region = 'North' THEN CAST(revenue AS DOUBLE) ELSE 0 END) AS north_revenue FROM \"my_db\".\"main\".\"monthly_sales\" GROUP BY 1 ORDER BY 1",
