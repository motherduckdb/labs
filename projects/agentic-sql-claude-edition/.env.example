# OpenRouter (LLM access). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# MotherDuck token (data warehouse). https://app.motherduck.com → Settings → Access Tokens
MOTHERDUCK_TOKEN=

# MotherDuck database name to build/query (optional; defaults to agentic_sql_claude)
MD_DATABASE=agentic_sql_claude
