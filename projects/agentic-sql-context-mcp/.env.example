# OpenRouter (LLM access). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# MotherDuck token (data warehouse). https://app.motherduck.com → Settings → Access Tokens
MOTHERDUCK_TOKEN=

# MotherDuck database name to build/query (optional; defaults to agentic_sql_claude)
MD_DATABASE=agentic_sql_claude

# MotherDuck MCP server base URL (optional; defaults to https://api.motherduck.com)
# MOTHERDUCK_API_URL=

# Guides migration (asm guides-load): topic prefix + access level for the
# published context guides. Topics are plain labels (topic = <prefix>/<domain>),
# NOT paths. access="user" (default) writes personal guides — the only kind a
# service-account token can write; "organization" needs an admin token.
DABSTEP_GUIDES_PREFIX=dabstep
DABSTEP_GUIDES_ACCESS=user
