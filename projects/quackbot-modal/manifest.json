{
  "display_information": {
    "name": "Quackbot"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "quackbot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "files:write",
        "reactions:write",
        "im:history",
        "im:read",
        "im:write",
        "channels:history",
        "groups:history",
        "mpim:history",
        "users:read",
        "assistant:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://motherduck--quackbot-modal-web.modal.run/slack/events",
      "bot_events": [
        "app_mention",
        "message.im",
        "assistant_thread_started",
        "assistant_thread_context_changed"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://motherduck--quackbot-modal-web.modal.run/slack/interactive"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
