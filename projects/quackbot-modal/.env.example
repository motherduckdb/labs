# --- Slack (HTTP Events API) ---
# Bot token for the installed Slack app (starts with xoxb-).
# Slack → your app → OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# Signing secret used to verify every inbound Slack request (HMAC + 5-min
# replay window). Socket Mode never needed this; the HTTP Events API does.
# Slack → your app → Basic Information → App Credentials.
SLACK_SIGNING_SECRET=

# --- MotherDuck ---
# MotherDuck token for querying and writing guides/dives.
# Note: create_guide/update_guide and save_dive are writes, so use a standard
# write-capable PAT rather than a read scaling token (read-only by design).
MOTHERDUCK_TOKEN=

# Optional. Defaults to the MotherDuck staging API. Set to
# https://api.motherduck.com to point at production.
MOTHERDUCK_API_URL=

# --- LLM (Modal Kimi K3) ---
# REQUIRED. A proxy-token pair from `modal workspace proxy-tokens create`,
# DOT-JOINED into one value: `wk-xxxx.ws-yyyy`. Modal's quickstart shows the
# same pair as separate `Modal-Key` / `Modal-Secret` headers; the endpoint
# accepts either, and one bearer keeps this to a single env var. A colon
# instead of a dot does not work.
MODAL_INFERENCE_KEY=

# REQUIRED. Base URL of the endpoint; `/chat/completions` is appended. Get it
# from `modal endpoint list` or the Modal dashboard — it is per-workspace, so
# there is no default and none can be invented. The worker refuses to start
# without it (src/worker.ts REQUIRED_ENV) and getChatCompletionsUrl throws.
# This briefly defaulted to Modal's multi-tenant Shared API; that host needs an
# entitlement this workspace lacks, so the "default" was a silent 401.
MODAL_INFERENCE_BASE_URL=https://motherduck--ep-kimi-k3-server.us-west.modal.direct/v1

# There is deliberately NO model variable. The endpoint above serves exactly one
# model, and the model id (`MODEL_ID` in src/core/llm-client.ts) sits alongside
# the cost table, the reasoning-effort dialect and the `reasoning_content`
# echo-back that are all specific to Kimi K3. `MODAL_INFERENCE_MODEL` used to be
# here; it selected none of those, so all it could do was put a different
# vendor's name on Kimi-priced cost rows. Moving to another model means a new
# base URL and matching edits in llm-client.ts, made together.

# --- Conversation state (PlanetScale Postgres) ---
# PlanetScale Postgres connection string. TLS is required.
DATABASE_URL=

# Comma-separated list of databases available by default (e.g. per channel
# before any channel-specific override is set).
QUACKBOT_DATABASES=

# Optional: reasoning effort for the LLM turn. Passed straight through as
# `reasoning_effort`, which accepts exactly none|minimal|low|medium|high|xhigh|max.
# `none` really does switch thinking off, and is worth using: reasoning bills at
# the full $15/MTok completion rate. Default when unset or unrecognised: low.
QUACKBOT_THINKING_LEVEL=

# Optional: set to 1 to append the Gemini dive-guide supplement to
# get_dive_guide results. Default OFF — the supplement was benchmarked for
# Gemini (PR #81 Phase 3) and is unmeasured on Kimi K3.
QUACKBOT_DIVE_SUPPLEMENT=
