#!/usr/bin/env python3
"""mdsql "<SQL>": SQL through the broker's guard. `heal_lake.*` is your sandbox clone; the healer's own
state and the scenario world config are not reachable. Every statement is logged."""
import json
import os
import sys
import urllib.request

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__); sys.exit(0)
sql = " ".join(sys.argv[1:])
req = urllib.request.Request(os.environ["HEAL_BROKER_URL"] + "/sql", data=json.dumps({"sql": sql}).encode(), method="POST",
                             headers={"X-Heal-Token": os.environ["HEAL_BROKER_TOKEN"], "Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=600) as r:
        out = json.loads(r.read())
except urllib.error.HTTPError as e:
    out = json.loads(e.read() or b"{}")
if "error" in out:
    print("ERROR:", out["error"]); sys.exit(1)
cols, rows = out["columns"], out["rows"]
if cols:
    w = [min(60, max([len(str(c))] + [len(str(r[i])) for r in rows])) for i, c in enumerate(cols)]
    print(" | ".join(str(c).ljust(w[i]) for i, c in enumerate(cols)))
    print("-+-".join("-" * x for x in w))
    for r in rows:
        print(" | ".join(str(v)[:60].ljust(w[i]) for i, v in enumerate(r)))
    print(f"({len(rows)} rows{', truncated at 200' if len(rows) == 200 else ''}) {out.get('note', '')}")
else:
    print("OK", out.get("note", ""))
