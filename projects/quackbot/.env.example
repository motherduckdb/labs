# --- Slack (Socket Mode) ---
# Bot token for the installed Slack app (starts with xoxb-).
# Slack → your app → OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# App-level token with the connections:write scope, used for Socket Mode
# (starts with xapp-). Slack → your app → Basic Information → App-Level Tokens.
SLACK_APP_TOKEN=xapp-...

# --- MotherDuck ---
# MotherDuck token for querying and (optionally) writing to the context layer.
# Note: update_context_layer is a write, so a standard PAT may be required
# rather than a read scaling token, which is read-only by design.
MOTHERDUCK_TOKEN=

# --- LLM (via OpenRouter) ---
OPENROUTER_API_KEY=

# Optional. Defaults to google/gemini-3-flash-preview if unset.
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Optional. Defaults to the MotherDuck staging API. Set to
# https://api.motherduck.com to point at production.
MOTHERDUCK_API_URL=

# --- Conversation state (PlanetScale Postgres) ---
# PlanetScale Postgres connection string. TLS is required.
DATABASE_URL=

# Comma-separated list of databases available by default (e.g. per channel
# before any channel-specific override is set).
QUACKBOT_DATABASES=

# Optional: reasoning effort for the LLM turn (none|minimal|low|medium|high|xhigh).
# Default: medium.
QUACKBOT_THINKING_LEVEL=
