# MotherDuck — always required. The scripts connect with `md:` and read the token
# from this env var (matching the Flight Postgres-ingest cookbook).
MOTHERDUCK_TOKEN=your-md-token
MD_DATABASE=multishop_commerce

# The ready-made dataset, as a public share. attach_share.py / seed_postgres.py read
# this; leave it unset to use the bundled default share.
# MD_SHARE_URL=md:_share/multishop_commerce/ac3d36cc-f295-4c66-bf13-371b998f12e8

# ── Postgres (the "before") ───────────────────────────────────────────────────
# The ingest scripts match the cookbook: credentials come from the environment and
# the attach uses an empty connection string (no password in SQL). Provide EITHER
# the cookbook's pg_* vars — the exact names a `pg` Flights secret injects, so the
# scripts drop into a Flight unchanged…
# pg_HOST=your-postgres-host
# pg_PORT=5432
# pg_DATABASE=your_database
# pg_USER=readonly_user
# pg_PASSWORD=your_password
# pg_SSLMODE=require
# …OR a single POSTGRES_URL (also used by benchmark.py and the webapp):
POSTGRES_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# MotherDuck Postgres wire endpoint (used by benchmark.py).
MD_PG_HOST=pg.us-east-1-aws.motherduck.com
MD_PG_PORT=5432
MD_PG_USER=motherduck
