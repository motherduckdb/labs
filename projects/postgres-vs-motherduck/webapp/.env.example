# ── Environment for the webapp ────────────────────────────────────────────────
# Local:  copy to `.env`  (cp .env.example .env)
# Vercel: add each of these under Project → Settings → Environment Variables.
#         The MOTHERDUCK_TOKEN is a secret — mark it as such.

# ── Required ──────────────────────────────────────────────────────────────────

# Your remote Postgres (the "before") — standard connection string.
POSTGRES_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# MotherDuck (the "after"), via its Postgres wire-protocol endpoint.
# The token IS the password; the username can be any non-empty string.
# MD_DATABASE is the database the app reads — the attached public share (run
# `uv run pipeline/attach_share.py` once) or your own load. See lib/db.ts.
MOTHERDUCK_TOKEN=your-md-token
MD_PG_HOST=pg.us-east-1-aws.motherduck.com
MD_DATABASE=multishop_commerce

# ── Optional (sensible defaults in lib/db.ts) ─────────────────────────────────

MD_PG_PORT=5432
MD_PG_USER=motherduck                      # any non-empty username; token is the credential
# MD_SHARE_URL=md:_share/multishop_commerce/ac3d36cc-f295-4c66-bf13-371b998f12e8  # override the dataset share
# POSTGRES_SSL=true                        # set "false" to disable TLS for a local/plain Postgres
