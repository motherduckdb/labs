# Required ---------------------------------------------------------------

# A MotherDuck READ SCALING token. Read-only by nature; safe to run a large
# fleet of concurrent sessions on a single token. Generate one in the
# MotherDuck UI (Settings → Tokens → Read Scaling). A normal access token also
# works for local dev, but read scaling is what makes the fan-out safe.
MOTHERDUCK_TOKEN=

# OpenRouter API key (the LLM is called via OpenRouter's OpenAI-compatible API).
OPENROUTER_API_KEY=

# Optional ---------------------------------------------------------------

# MotherDuck API base. Defaults to staging in lib/motherduck-env.ts — staging
# is the target deployment: it serves the guides tools (get_guide/list_guides)
# and extra catalog discovery (list_views/list_macros) that prod doesn't have
# yet. The app degrades gracefully against prod (those tools just don't
# appear), but MOTHERDUCK_TOKEN must match the environment the URL points at.
# MOTHERDUCK_API_URL=https://api.motherduck.com

# LLM model id (OpenRouter). Default google/gemini-3-flash-preview.
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# Pin the OpenRouter upstream provider to stabilize prompt caching.
# OPENROUTER_PROVIDER=Google AI Studio

# Reasoning level on startup: none | minimal | low | medium | high | xhigh.
# Defaults to `none` (raw reasoning is kept out of the UI). Client-read, so the
# NEXT_PUBLIC_ prefix is required and changing it needs a rebuild.
# NEXT_PUBLIC_DEFAULT_THINKING_LEVEL=none

# Master kill switch for the controllog telemetry feed (JSONL on disk).
# NEXT_PUBLIC_DISABLE_LOGGING=1
