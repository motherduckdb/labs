// fees_base.malloy
// Base source over the DuckDB "fees" table: each row is a FEE RULE that
// applies when its (nullable) characteristics match a transaction.

source: fees_base is duckdb.table('fees') extend {

  //-------------------------------------------------------------------
  // Derived dimensions (NEW names only — no redefinition of columns)
  //-------------------------------------------------------------------

  // Human-readable account-type bucket count (list column).
  dimension: account_type_count is len!number(account_type)
  dimension: applies_to_all_account_types is len!number(account_type) = 0

  // Same idea for aci / mcc list columns: empty list / null = applies to all.
  dimension: aci_count is len!number(aci)
  dimension: applies_to_all_aci is len!number(aci) = 0

  dimension: mcc_count is len!number(merchant_category_code)
  dimension: applies_to_all_mcc is len!number(merchant_category_code) = 0

  // Capture-delay speed bucket (faster = pricier per the manual).
  dimension: capture_speed_bucket is
    pick 'immediate'   when capture_delay = 'immediate'
    pick 'fast (<3d)'  when capture_delay = '<3'
    pick 'medium (3-5d)' when capture_delay = '3-5'
    pick 'slow (>5d)'  when capture_delay = '>5'
    pick 'manual'      when capture_delay = 'manual'
    else 'unspecified'

  // Channel inferred from card-scheme / intracountry — intracountry is the
  // boolean-as-double in this dataset (1.0 = domestic, 0.0 = cross-border,
  // null = applies to both).
  dimension: is_intracountry_rule is intracountry = 1
  dimension: is_crossborder_rule  is intracountry = 0
  dimension: intracountry_label is
    pick 'domestic'     when intracountry = 1
    pick 'cross-border' when intracountry = 0
    else 'either'

  dimension: credit_label is
    pick 'credit' when is_credit = true
    pick 'debit'  when is_credit = false
    else 'either'

  // Fixed-amount tiering, useful for distributions.
  dimension: fixed_amount_tier is
    pick 'free'          when fixed_amount = 0
    pick '<= 0.05'       when fixed_amount <= 0.05
    pick '0.05 - 0.10'   when fixed_amount <= 0.10
    pick '0.10 - 0.25'   when fixed_amount <= 0.25
    pick '0.25 - 0.50'   when fixed_amount <= 0.50
    else '> 0.50'

  // Rate is expressed as basis-point-ish integer (divided by 10000).
  dimension: rate_pct is rate / 100.0      // percent
  dimension: rate_fraction is rate / 10000.0

  dimension: rate_tier is
    pick 'zero'        when rate = 0
    pick '<= 0.5%'     when rate <= 50
    pick '0.5% - 1%'   when rate <= 100
    pick '1% - 2%'     when rate <= 200
    pick '2% - 3%'     when rate <= 300
    else '> 3%'

  // Example fee on a EUR 100 transaction:  fixed + rate * 100 / 10000.
  dimension: example_fee_eur_100 is fixed_amount + rate * 100.0 / 10000.0

  //-------------------------------------------------------------------
  // Measures
  //-------------------------------------------------------------------

  measure: rule_count is count()
  measure: distinct_rule_ids is count(ID)
  measure: distinct_card_schemes is count(card_scheme)

  measure: credit_rule_count is count() { where: is_credit = true }
  measure: debit_rule_count  is count() { where: is_credit = false }
  measure: intracountry_rule_count is count() { where: intracountry = 1 }
  measure: crossborder_rule_count  is count() { where: intracountry = 0 }

  measure: avg_fixed_amount is avg(fixed_amount)
  measure: min_fixed_amount is min(fixed_amount)
  measure: max_fixed_amount is max(fixed_amount)
  measure: total_fixed_amount is sum(fixed_amount)

  measure: avg_rate_bp is avg(rate)            // basis-point-ish (rate/10000)
  measure: avg_rate_pct is avg(rate) / 100.0
  measure: min_rate_bp is min(rate)
  measure: max_rate_bp is max(rate)

  measure: avg_example_fee_eur_100 is avg(fixed_amount + rate * 100.0 / 10000.0)
  measure: avg_example_fee_eur_1000 is avg(fixed_amount + rate * 1000.0 / 10000.0)
}
