// Fee rules table: each row is ONE pricing rule that may match a transaction
// based on card_scheme, account_type, capture_delay, fraud level, monthly
// volume, MCC, credit flag, ACI, and intracountry flag. The effective fee is
// `fixed_amount + rate * transaction_value / 10000`. NULL on a rule field
// means the rule applies to all values of that field (wildcard).
source: fees_base is duckdb.table('fees') extend {

  // ---------- Dimensions ----------

  // Stable, human-readable label for the account category list. Useful for
  // grouping when the raw list column is awkward to display.
  dimension: account_type_label is array_to_string!string(account_type, ',')

  // Same idea for ACI list and MCC list — flattened to string for grouping.
  dimension: aci_label is array_to_string!string(aci, ',')
  dimension: mcc_label is array_to_string!string(merchant_category_code, ',')

  // Wildcard indicators (NULL in the rule = "applies to all values"). These
  // are handy for understanding rule specificity.
  dimension: is_wildcard_account_type   is account_type is null
  dimension: is_wildcard_capture_delay  is capture_delay is null
  dimension: is_wildcard_fraud_level    is monthly_fraud_level is null
  dimension: is_wildcard_volume         is monthly_volume is null
  dimension: is_wildcard_mcc            is merchant_category_code is null
  dimension: is_wildcard_credit         is is_credit is null
  dimension: is_wildcard_aci            is aci is null
  dimension: is_wildcard_intracountry   is intracountry is null

  // Number of non-wildcard fields — a rough proxy for "how specific" the rule
  // is (higher = matches fewer transactions but with more precise pricing).
  dimension: rule_specificity is
      (pick 0 when account_type is null else 1)
    + (pick 0 when capture_delay is null else 1)
    + (pick 0 when monthly_fraud_level is null else 1)
    + (pick 0 when monthly_volume is null else 1)
    + (pick 0 when merchant_category_code is null else 1)
    + (pick 0 when is_credit is null else 1)
    + (pick 0 when aci is null else 1)
    + (pick 0 when intracountry is null else 1)

  // Intracountry flag as a readable label.
  dimension: scope is
    pick 'domestic'      when intracountry = 1
    pick 'international' when intracountry = 0
    else 'any'

  // Rate expressed as a percentage of the transaction value (rate is in
  // basis-points-of-10000, i.e. rate/10000 = fraction, *100 = percent).
  dimension: rate_pct is rate / 100.0

  // Fee on a hypothetical EUR 100 transaction — a quick comparability metric.
  dimension: fee_on_100eur is fixed_amount + rate * 100.0 / 10000.0

  // ---------- Measures ----------

  measure: rule_count is count()

  measure: scheme_count       is count(card_scheme)
  measure: capture_delay_count is count(capture_delay)
  measure: fraud_level_count   is count(monthly_fraud_level)
  measure: volume_tier_count   is count(monthly_volume)

  // Fixed-amount stats (EUR per transaction).
  measure: avg_fixed_amount is fixed_amount.avg()
  measure: min_fixed_amount is fixed_amount.min()
  measure: max_fixed_amount is fixed_amount.max()
  measure: sum_fixed_amount is fixed_amount.sum()

  // Rate stats (raw rate units, divide by 10000 for the multiplier).
  measure: avg_rate is rate.avg()
  measure: min_rate is rate.min()
  measure: max_rate is rate.max()

  // Same in percent for readability.
  measure: avg_rate_pct is rate_pct.avg()
  measure: max_rate_pct is rate_pct.max()

  // Effective fee on a EUR 100 transaction.
  measure: avg_fee_on_100eur is fee_on_100eur.avg()
  measure: max_fee_on_100eur is fee_on_100eur.max()

  // Counts by transaction type — useful for sanity checks and segmentation.
  measure: credit_rule_count is count() { where: is_credit = true }
  measure: debit_rule_count  is count() { where: is_credit = false }
  measure: domestic_rule_count      is count() { where: intracountry = 1 }
  measure: international_rule_count is count() { where: intracountry = 0 }

  // ---------- Views ----------

  view: by_scheme is {
    group_by: card_scheme
    aggregate: rule_count, avg_fixed_amount, avg_rate_pct, avg_fee_on_100eur
    order_by: rule_count desc
  }

  view: by_capture_delay is {
    group_by: capture_delay
    aggregate: rule_count, avg_fixed_amount, avg_rate_pct, avg_fee_on_100eur
    order_by: avg_fee_on_100eur desc
  }

  view: by_fraud_level is {
    group_by: monthly_fraud_level
    aggregate: rule_count, avg_fee_on_100eur
    order_by: avg_fee_on_100eur desc
  }

  view: by_volume_tier is {
    group_by: monthly_volume
    aggregate: rule_count, avg_fee_on_100eur
    order_by: avg_fee_on_100eur desc
  }

  view: by_scope is {
    group_by: scope
    aggregate: rule_count, avg_fixed_amount, avg_rate_pct, avg_fee_on_100eur
  }

  view: by_credit is {
    group_by: is_credit
    aggregate: rule_count, avg_fee_on_100eur
  }

  view: by_aci is {
    group_by: aci_label
    aggregate: rule_count, avg_fee_on_100eur
    order_by: avg_fee_on_100eur desc
  }
}
