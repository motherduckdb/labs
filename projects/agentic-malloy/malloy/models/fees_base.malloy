source: fees_base is duckdb.table('fees') extend {
  primary_key: ID

  // -- wildcard flags: empty list (not NULL) = "applies to all" for list fields; NULL for scalars
  dimension: applies_all_account_types is len!number(account_type) = 0
  dimension: applies_all_mccs is len!number(merchant_category_code) = 0
  dimension: applies_all_acis is len!number(aci) = 0
  dimension: applies_all_capture_delays is capture_delay is null
  dimension: applies_all_fraud_levels is monthly_fraud_level is null
  dimension: applies_all_volumes is monthly_volume is null
  dimension: applies_all_credit is is_credit is null
  dimension: applies_all_intracountry is intracountry is null

  // -- intracountry stored as 0/1 DOUBLE with NULL wildcard
  dimension: domestic_only is intracountry = 1
  dimension: international_only is intracountry = 0

  // -- rate is in basis points: fee = fixed_amount + rate * value / 10000
  dimension: rate_fraction is rate / 10000.0
  dimension: rate_pct is rate / 100.0

  // -- parsed numeric bounds of the volume tier strings (k=1e3, m=1e6); null max = unbounded
  dimension: monthly_volume_min_eur is
    pick 0 when monthly_volume = '<100k'
    pick 100000 when monthly_volume = '100k-1m'
    pick 1000000 when monthly_volume = '1m-5m'
    pick 5000000 when monthly_volume = '>5m'
    else null
  dimension: monthly_volume_max_eur is
    pick 100000 when monthly_volume = '<100k'
    pick 1000000 when monthly_volume = '100k-1m'
    pick 5000000 when monthly_volume = '1m-5m'
    else null

  // -- parsed numeric bounds of the fraud tier strings, in percent; null max = unbounded
  dimension: fraud_level_min_pct is
    pick 0 when monthly_fraud_level = '<7.2%'
    pick 7.2 when monthly_fraud_level = '7.2%-7.7%'
    pick 7.7 when monthly_fraud_level = '7.7%-8.3%'
    pick 8.3 when monthly_fraud_level = '>8.3%'
    else null
  dimension: fraud_level_max_pct is
    pick 7.2 when monthly_fraud_level = '<7.2%'
    pick 7.7 when monthly_fraud_level = '7.2%-7.7%'
    pick 8.3 when monthly_fraud_level = '7.7%-8.3%'
    else null

  measure: rule_count is count()

  measure: avg_fixed_amount is fixed_amount.avg()
  measure: min_fixed_amount is fixed_amount.min()
  measure: max_fixed_amount is fixed_amount.max()
  measure: total_fixed_amount is fixed_amount.sum()

  measure: avg_rate is rate.avg()
  measure: min_rate is rate.min()
  measure: max_rate is rate.max()
  measure: total_rate is rate.sum()
}
