source: fees_base is duckdb.table('fees') extend {
  // transaction_value is the notional the variable rate applies to;
  // fee = fixed_amount + rate * transaction_value / 10000
  // parameterized so callers can compute fee at any notional
  // (default 0 => fee equals fixed_amount only)

  // --- derived dimensions ---
  // wildcard encoding: list fields use empty list (len=0); scalar fields use NULL
  dimension: applies_to_all_account_types is len!number(account_type) = 0
  dimension: applies_to_all_mccs is len!number(merchant_category_code) = 0
  dimension: applies_to_all_acis is len!number(aci) = 0
  dimension: applies_to_all_schemes is card_scheme is null
  dimension: applies_to_all_capture_delay is capture_delay is null
  dimension: applies_to_all_fraud_level is monthly_fraud_level is null
  dimension: applies_to_all_volume is monthly_volume is null
  dimension: applies_to_all_credit is is_credit is null
  dimension: applies_to_all_intracountry is intracountry is null

  // rate is stored as basis-points/10000 multiplier; expose as effective fraction
  dimension: rate_fraction is rate / 10000.0

  // intracountry stored as 0/1 double; expose readable flag (null = applies to all)
  dimension: is_intracountry is pick true when intracountry = 1 pick false when intracountry = 0 else null

  // --- measures over fixed_amount ---
  measure: rule_count is count()
  measure: total_fixed_amount is fixed_amount.sum()
  measure: avg_fixed_amount is fixed_amount.avg()
  measure: min_fixed_amount is fixed_amount.min()
  measure: max_fixed_amount is fixed_amount.max()

  // --- measures over rate ---
  measure: total_rate is rate.sum()
  measure: avg_rate is rate.avg()
  measure: min_rate is rate.min()
  measure: max_rate is rate.max()

  // --- standard views ---
  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_credit is {
    group_by: is_credit
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_capture_delay is {
    group_by: capture_delay
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_monthly_volume is {
    group_by: monthly_volume
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_monthly_fraud_level is {
    group_by: monthly_fraud_level
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }
}
