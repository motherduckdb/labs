##! experimental.parameters

// Fee ruleset. `notional` = a hypothetical transaction value (EUR) used to
// evaluate the two-part tariff fee = fixed_amount + rate * value / 10000.
source: fees_base(notional::number is null) is duckdb.table('fees') extend {

  // ---- wildcard-encoding helpers (empty list = "applies to all") ----
  dimension:
    applies_to_all_account_types is len!number(account_type) = 0
    applies_to_all_mccs          is len!number(merchant_category_code) = 0
    applies_to_all_acis          is len!number(aci) = 0
    // scalar wildcard fields use NULL = "applies to all"
    applies_to_all_capture_delay is capture_delay is null
    applies_to_all_fraud_level   is monthly_fraud_level is null
    applies_to_all_volume        is monthly_volume is null
    applies_to_all_credit        is is_credit is null
    applies_to_all_intracountry  is intracountry is null

  // ---- readable derived dimensions ----
  dimension:
    intracountry_label is pick 'domestic' when intracountry = 1
                           pick 'international' when intracountry = 0
                           else 'all'
    credit_label is pick 'credit' when is_credit = true
                      pick 'debit' when is_credit = false
                      else 'all'
    // number of account types / mccs / acis a rule constrains (0 = all)
    account_type_count is len!number(account_type)
    mcc_count is len!number(merchant_category_code)
    aci_count is len!number(aci)

  // ---- per-rule fee at the supplied notional transaction value ----
  dimension:
    fee_at_notional is fixed_amount + rate * notional / 10000

  // ---- measures ----
  measure:
    rule_count is count()
    fee_id_count is count(ID)

    // fixed_amount (EUR per transaction) — full aggregation set
    total_fixed_amount is fixed_amount.sum()
    avg_fixed_amount   is fixed_amount.avg()
    min_fixed_amount   is fixed_amount.min()
    max_fixed_amount   is fixed_amount.max()

    // rate (variable, /10000) — full aggregation set
    total_rate is rate.sum()
    avg_rate   is rate.avg()
    min_rate   is rate.min()
    max_rate   is rate.max()

    // fee at the parameterized notional value across the matching rule set
    total_fee_at_notional is fee_at_notional.sum()
    avg_fee_at_notional   is fee_at_notional.avg()
    min_fee_at_notional   is fee_at_notional.min()
    max_fee_at_notional   is fee_at_notional.max()

  // ---- reusable slices ----
  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_credit is {
    group_by: credit_label
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }

  view: by_intracountry is {
    group_by: intracountry_label
    aggregate: rule_count, avg_fixed_amount, avg_rate
  }
}
