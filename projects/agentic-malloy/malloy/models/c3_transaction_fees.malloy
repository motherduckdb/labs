// Fact×rule wildcard match: each transaction (with match keys materialized by
// c2_payments_enriched.match_keys) fans out to EVERY fee rule it satisfies.
// Wildcard encoding — list fields empty (len=0) = "applies to all"; scalar
// fields NULL = "applies to all". Every match field carries a wildcard branch.

// thin keyed wrapper so join_many can dedupe symmetric aggregates on fee ID
source: fees_rules is duckdb.table('fees') extend {
  primary_key: ID
}

source: c3_transaction_fees is c2_payments_enriched -> match_keys extend {

  // multi-rule fan-out: one row per (transaction, matching fee rule)
  join_many: rule is fees_rules on
        (rule.card_scheme is null or rule.card_scheme = card_scheme)
    and (len!number(rule.account_type) = 0
         or list_contains!boolean(rule.account_type, account_type))
    and (rule.capture_delay is null or rule.capture_delay = capture_delay_band)
    and (rule.monthly_fraud_level is null
         or rule.monthly_fraud_level = monthly_fraud_level_band)
    and (rule.monthly_volume is null or rule.monthly_volume = monthly_volume_band)
    and (len!number(rule.merchant_category_code) = 0
         or list_contains!boolean(rule.merchant_category_code, merchant_category_code))
    and (rule.is_credit is null or rule.is_credit = is_credit)
    and (len!number(rule.aci) = 0 or list_contains!boolean(rule.aci, aci))
    and (rule.intracountry is null or rule.intracountry = intracountry_value)

  // per (txn,rule) two-part tariff: fee = fixed_amount + rate * value / 10000
  dimension: fee is rule.fixed_amount + rule.rate * eur_amount / 10000

  measure:
    txn_count is count(psp_reference)          // distinct txns — safe across fan-out
    matched_rule_count is rule.count()          // (txn,rule) fan-out grain
    applicable_fee_id_count is rule.ID.count()  // distinct matched fee IDs

    // fee aggregations computed at the joined (rule) grain
    total_fees is rule.sum(rule.fixed_amount + rule.rate * eur_amount / 10000)
    avg_fee_per_match is rule.avg(rule.fixed_amount + rule.rate * eur_amount / 10000)
    min_fee_per_match is min(rule.fixed_amount + rule.rate * eur_amount / 10000)
    max_fee_per_match is max(rule.fixed_amount + rule.rate * eur_amount / 10000)

  // ---- enumerations (exclude phantom unmatched left-join rows: rule.ID null) ----
  view: applicable_fee_ids is {
    where: rule.ID is not null
    group_by: fee_id is rule.ID
    order_by: fee_id
  }

  view: affected_merchants is {
    where: rule.ID is not null
    group_by: merchant
    order_by: merchant
  }

  // ---- total-fee rollups (each txn's fee summed across its matching rules) ----
  view: total_fees_by_merchant is {
    group_by: merchant
    aggregate: txn_count, matched_rule_count, total_fees
    order_by: merchant
  }

  view: total_fees_by_merchant_month is {
    group_by: merchant, `month`
    aggregate: txn_count, total_fees
    order_by: merchant, `month`
  }

  view: total_fees_by_merchant_day is {
    group_by: merchant, day_of_year
    aggregate: txn_count, total_fees
    order_by: merchant, day_of_year
  }

  // ---- per (txn,rule) detail row with its fee ----
  view: transaction_rule_fees is {
    select:
      psp_reference, merchant, day_of_year, `month`,
      card_scheme, aci, eur_amount,
      fee_id is rule.ID,
      fee
    order_by: psp_reference
  }
}
