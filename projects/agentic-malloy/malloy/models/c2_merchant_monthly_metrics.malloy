// Per-merchant, per-natural-month volume + fraud-rate, mapped onto fee-rule bands.
// Built as a query-result source so the band labels are REAL columns usable
// downstream for fee-rule join_many matching (monthly_volume / monthly_fraud_level).
source: c2_merchant_monthly_metrics is payments_base -> {
  group_by: merchant, `year`, transaction_month
  aggregate:
    monthly_volume_amount is total_amount         // SUM(eur_amount) in the natural month
    monthly_transaction_count is transaction_count
    monthly_avg_amount is avg_amount
    monthly_fraud_amount is fraud_amount
    monthly_fraud_volume_rate is fraud_volume_rate  // fraud volume / total volume
} extend {
  // numeric monthly volume -> fee-rule banded string (exact rule domain)
  dimension: monthly_volume_band is
    pick '<100k' when monthly_volume_amount < 100000
    pick '100k-1m' when monthly_volume_amount < 1000000
    pick '1m-5m' when monthly_volume_amount < 5000000
    else '>5m'

  // fraud-volume ratio -> fee-rule banded string (thresholds 7.2/7.7/8.3 %)
  dimension: monthly_fraud_band is
    pick '<7.2%' when monthly_fraud_volume_rate < 0.072
    pick '7.2%-7.7%' when monthly_fraud_volume_rate < 0.077
    pick '7.7%-8.3%' when monthly_fraud_volume_rate < 0.083
    else '>8.3%'

  view: by_merchant_month is {
    group_by:
      merchant,
      `year`,
      transaction_month,
      monthly_volume_band,
      monthly_fraud_band,
      monthly_volume_amount,
      monthly_transaction_count,
      monthly_avg_amount,
      monthly_fraud_amount,
      monthly_fraud_volume_rate
  }
}
