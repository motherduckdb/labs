##! experimental.parameters

// ── Value universes: element domains for the list-typed rule fields, so a
//    list dimension (ACI / MCC / account_type) can become a GROUP-BY key.
//    Derived from the data, not hardcoded. ──────────────────────────────
source: aci_universe is duckdb.table('payments') -> { group_by: aci }
source: account_type_universe is duckdb.table('merchants') -> { group_by: account_type }

// ── Core rule-side scenario source: fee at a parameterized notional across
//    matching fee rules, ranked by card scheme, with wildcard-aware
//    characteristic FILTERS (a null param = "don't constrain this field").
//    Wildcard rule encoding: list field empty (len=0) OR scalar NULL = all. ─
source: c4_fee_scenarios(
  notional::number is null,
  acct::string is null,
  mcc_val::number is null,
  aci_val::string is null,
  credit::boolean is null,
  intracountry_val::number is null
) is fees_base(notional is notional) extend {

  // every characteristic carries a wildcard branch + a "param unset" branch
  dimension: matches_filters is
        (acct is null or len!number(account_type) = 0
           or list_contains!boolean(account_type, acct))
    and (mcc_val is null or len!number(merchant_category_code) = 0
           or list_contains!boolean(merchant_category_code, mcc_val))
    and (aci_val is null or len!number(aci) = 0
           or list_contains!boolean(aci, aci_val))
    and (credit is null or is_credit is null or is_credit = credit)
    and (intracountry_val is null or intracountry is null
           or intracountry = intracountry_val)

  // full aggregation set of the per-rule fee at the parameterized notional
  measure:
    matching_rule_count is count()
    total_fee is fee_at_notional.sum()
    avg_fee   is fee_at_notional.avg()
    min_fee   is fee_at_notional.min()
    max_fee   is fee_at_notional.max()

  view: scenario_by_card_scheme is {
    where: matches_filters
    group_by: card_scheme
    aggregate: matching_rule_count, total_fee, avg_fee, min_fee, max_fee
    order_by: avg_fee
  }

  view: scenario_by_credit is {
    where: matches_filters
    group_by: credit_label
    aggregate: matching_rule_count, total_fee, avg_fee, min_fee, max_fee
  }

  view: scenario_summary is {
    where: matches_filters
    aggregate: matching_rule_count, total_fee, avg_fee, min_fee, max_fee
  }
}

// ── ACI ranking: root at the ACI value universe, cross-join the rules and
//    keep those whose aci list is wildcard OR contains the candidate. Fee is
//    aggregated at the JOINED (rule) grain — correct across join_cross. ─────
source: c4_fee_by_aci(
  notional::number is null,
  scheme::string is null,
  acct::string is null,
  mcc_val::number is null,
  credit::boolean is null,
  intracountry_val::number is null
) is aci_universe extend {
  join_cross: rule is fees_base(notional is notional)
  where:
        (len!number(rule.aci) = 0 or list_contains!boolean(rule.aci, aci))
    and (scheme is null or rule.card_scheme = scheme)
    and (acct is null or len!number(rule.account_type) = 0
           or list_contains!boolean(rule.account_type, acct))
    and (mcc_val is null or len!number(rule.merchant_category_code) = 0
           or list_contains!boolean(rule.merchant_category_code, mcc_val))
    and (credit is null or rule.is_credit is null or rule.is_credit = credit)
    and (intracountry_val is null or rule.intracountry is null
           or rule.intracountry = intracountry_val)

  view: by_aci is {
    group_by: aci
    aggregate:
      matching_rule_count is rule.count()
      total_fee is rule.fee_at_notional.sum()
      avg_fee   is rule.fee_at_notional.avg()
      min_fee   is rule.fee_at_notional.min()
      max_fee   is rule.fee_at_notional.max()
    order_by: avg_fee
  }
}

// ── MCC ranking: root at the full MCC reference universe (element domain of
//    fees.merchant_category_code), cross-join + wildcard-match the rules. ───
source: c4_fee_by_mcc(
  notional::number is null,
  scheme::string is null,
  acct::string is null,
  aci_val::string is null,
  credit::boolean is null,
  intracountry_val::number is null
) is merchant_category_codes_base extend {
  join_cross: rule is fees_base(notional is notional)
  where:
        (len!number(rule.merchant_category_code) = 0
           or list_contains!boolean(rule.merchant_category_code, mcc_code))
    and (scheme is null or rule.card_scheme = scheme)
    and (acct is null or len!number(rule.account_type) = 0
           or list_contains!boolean(rule.account_type, acct))
    and (aci_val is null or len!number(rule.aci) = 0
           or list_contains!boolean(rule.aci, aci_val))
    and (credit is null or rule.is_credit is null or rule.is_credit = credit)
    and (intracountry_val is null or rule.intracountry is null
           or rule.intracountry = intracountry_val)

  view: by_mcc is {
    group_by: mcc_code, description
    aggregate:
      matching_rule_count is rule.count()
      total_fee is rule.fee_at_notional.sum()
      avg_fee   is rule.fee_at_notional.avg()
      min_fee   is rule.fee_at_notional.min()
      max_fee   is rule.fee_at_notional.max()
    order_by: max_fee desc
  }
}

// ── Account-type ranking: root at the account-type universe, wildcard-match. ─
source: c4_fee_by_account_type(
  notional::number is null,
  scheme::string is null,
  mcc_val::number is null,
  aci_val::string is null,
  credit::boolean is null,
  intracountry_val::number is null
) is account_type_universe extend {
  join_cross: rule is fees_base(notional is notional)
  where:
        (len!number(rule.account_type) = 0
           or list_contains!boolean(rule.account_type, account_type))
    and (scheme is null or rule.card_scheme = scheme)
    and (mcc_val is null or len!number(rule.merchant_category_code) = 0
           or list_contains!boolean(rule.merchant_category_code, mcc_val))
    and (aci_val is null or len!number(rule.aci) = 0
           or list_contains!boolean(rule.aci, aci_val))
    and (credit is null or rule.is_credit is null or rule.is_credit = credit)
    and (intracountry_val is null or rule.intracountry is null
           or rule.intracountry = intracountry_val)

  view: by_account_type is {
    group_by: account_type
    aggregate:
      matching_rule_count is rule.count()
      total_fee is rule.fee_at_notional.sum()
      avg_fee   is rule.fee_at_notional.avg()
      min_fee   is rule.fee_at_notional.min()
      max_fee   is rule.fee_at_notional.max()
    order_by: avg_fee
  }
}
