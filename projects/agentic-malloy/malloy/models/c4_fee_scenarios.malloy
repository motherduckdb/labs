// c4_fee_scenarios.malloy
// "Average scenario" fee model — hypothetical per-rule fees at canonical
// transaction values, INDEPENDENT of actual payment volume.
//
// Fee formula (manual §5): fee = fixed_amount + rate * value / 10000.
// NULL on a rule field = wildcard (applies to all values).
//
// Used to answer questions like:
//   * "which card scheme is cheapest in the average scenario at X EUR?"
//   * "most expensive ACI / MCC at X EUR?"
//   * "average fee for (scheme, account_type, MCC) at X EUR?"
//
// NOTE: Malloy can't parametrize a dimension by a runtime value, so we
// pre-bake the fee dimensions at the transaction values the train set
// asks for (50, 100, 1000, 4321, 50000). Add more as needed.

// ---------------------------------------------------------------------------
// Helper #1 — rules exploded by ACI letter (one row per (rule, ACI letter)).
// A NULL aci list on a rule means "applies to all ACIs", so we expand it
// to all 7 letters so the rule contributes to every ACI bucket.
// Used for "group BY ACI" questions; never join this to anything else
// (the explosion changes the rule-grain).
// ---------------------------------------------------------------------------
source: c4_fee_rules_by_aci is duckdb.sql("""
  SELECT
    "ID"                       AS rule_id,
    card_scheme,
    account_type,
    capture_delay,
    monthly_fraud_level,
    monthly_volume,
    merchant_category_code,
    is_credit,
    intracountry,
    fixed_amount,
    rate,
    unnest(COALESCE(aci, ['A','B','C','D','E','F','G'])) AS aci_letter
  FROM fees
""") extend {

  dimension: fee_on_50eur    is fixed_amount + rate * 50.0    / 10000.0
  dimension: fee_on_100eur   is fixed_amount + rate * 100.0   / 10000.0
  dimension: fee_on_1000eur  is fixed_amount + rate * 1000.0  / 10000.0
  dimension: fee_on_4321eur  is fixed_amount + rate * 4321.0  / 10000.0
  dimension: fee_on_50000eur is fixed_amount + rate * 50000.0 / 10000.0

  measure: rule_count           is count()
  measure: avg_fee_on_50eur     is fee_on_50eur.avg()
  measure: avg_fee_on_100eur    is fee_on_100eur.avg()
  measure: avg_fee_on_1000eur   is fee_on_1000eur.avg()
  measure: avg_fee_on_4321eur   is fee_on_4321eur.avg()
  measure: avg_fee_on_50000eur  is fee_on_50000eur.avg()
  measure: max_fee_on_100eur    is fee_on_100eur.max()
  measure: min_fee_on_100eur    is fee_on_100eur.min()

  // "For a credit transaction of 100 EUR on GlobalCard, most expensive ACI?"
  view: by_aci_at_100_credit_globalcard is {
    where:
      card_scheme = 'GlobalCard'
      and (is_credit is null or is_credit = true)
    group_by: aci_letter
    aggregate: avg_fee_on_100eur, rule_count
    order_by: avg_fee_on_100eur desc, aci_letter asc
  }

  view: by_aci_at_100 is {
    group_by: aci_letter
    aggregate: avg_fee_on_100eur, rule_count
    order_by: avg_fee_on_100eur desc
  }
}

// ---------------------------------------------------------------------------
// Helper #2 — rules exploded by MCC value (one row per (rule, MCC number)).
// We skip wildcards (rules with NULL mcc): they add a constant to every MCC
// average so they don't change the RANKING — which is what these
// "most expensive MCC at X EUR" questions ask for.
// ---------------------------------------------------------------------------
source: c4_fee_rules_by_mcc is duckdb.sql("""
  SELECT
    "ID" AS rule_id,
    card_scheme,
    account_type,
    capture_delay,
    monthly_fraud_level,
    monthly_volume,
    aci,
    is_credit,
    intracountry,
    fixed_amount,
    rate,
    unnest(merchant_category_code) AS mcc_number
  FROM fees
  WHERE merchant_category_code IS NOT NULL
""") extend {

  join_one: mcc_lookup is merchant_category_codes_base
    on mcc_number::string = mcc_lookup.mcc

  dimension: fee_on_50eur    is fixed_amount + rate * 50.0    / 10000.0
  dimension: fee_on_100eur   is fixed_amount + rate * 100.0   / 10000.0
  dimension: fee_on_1000eur  is fixed_amount + rate * 1000.0  / 10000.0
  dimension: fee_on_4321eur  is fixed_amount + rate * 4321.0  / 10000.0
  dimension: fee_on_50000eur is fixed_amount + rate * 50000.0 / 10000.0
  dimension: mcc_description is mcc_lookup.description

  measure: rule_count           is count()
  measure: avg_fee_on_50eur     is fee_on_50eur.avg()
  measure: avg_fee_on_100eur    is fee_on_100eur.avg()
  measure: avg_fee_on_1000eur   is fee_on_1000eur.avg()
  measure: avg_fee_on_50000eur  is fee_on_50000eur.avg()

  // "Most expensive MCC for a 50 000 EUR transaction, in general."
  view: by_mcc_at_50000 is {
    group_by: mcc_number, mcc_description
    aggregate: avg_fee_on_50000eur, rule_count
    order_by: avg_fee_on_50000eur desc, mcc_number asc
  }

  view: by_mcc_at_1000 is {
    group_by: mcc_number, mcc_description
    aggregate: avg_fee_on_1000eur, rule_count
    order_by: avg_fee_on_1000eur desc
  }
}

// ---------------------------------------------------------------------------
// Main scenario source. Rule-grain (one row per fee rule). Carries the
// canonical fee-at-value dimensions plus convenience scheme/credit/scope
// rollups. Filter via list_contains!boolean(...) when restricting to a
// specific account_type / MCC / ACI list value.
// ---------------------------------------------------------------------------
source: c4_fee_scenarios is fees_base extend {

  // Fee per rule at canonical transaction values.
  // (fee_on_100eur already defined in fees_base.)
  dimension: fee_on_50eur    is fixed_amount + rate * 50.0    / 10000.0
  dimension: fee_on_1000eur  is fixed_amount + rate * 1000.0  / 10000.0
  dimension: fee_on_4321eur  is fixed_amount + rate * 4321.0  / 10000.0
  dimension: fee_on_50000eur is fixed_amount + rate * 50000.0 / 10000.0

  // Averages across the matching rule subset.
  measure: avg_fee_on_50eur    is fee_on_50eur.avg()
  measure: avg_fee_on_1000eur  is fee_on_1000eur.avg()
  measure: avg_fee_on_4321eur  is fee_on_4321eur.avg()
  measure: avg_fee_on_50000eur is fee_on_50000eur.avg()
  // avg_fee_on_100eur already defined in fees_base.

  // Min / max for "cheapest rule / most expensive rule" questions.
  measure: min_fee_on_50eur    is fee_on_50eur.min()
  measure: max_fee_on_50eur    is fee_on_50eur.max()
  measure: min_fee_on_100eur   is fee_on_100eur.min()
  measure: min_fee_on_1000eur  is fee_on_1000eur.min()
  measure: max_fee_on_1000eur  is fee_on_1000eur.max()
  measure: min_fee_on_4321eur  is fee_on_4321eur.min()
  measure: max_fee_on_4321eur  is fee_on_4321eur.max()
  measure: min_fee_on_50000eur is fee_on_50000eur.min()
  measure: max_fee_on_50000eur is fee_on_50000eur.max()

  // -------------------------------------------------------------------------
  // Views: "average scenario" cheapest / most-expensive scheme at the
  // canonical transaction values.
  // -------------------------------------------------------------------------
  view: by_scheme_at_50 is {
    group_by: card_scheme
    aggregate: avg_fee_on_50eur, rule_count
    order_by: avg_fee_on_50eur asc
  }

  view: by_scheme_at_100 is {
    group_by: card_scheme
    aggregate: avg_fee_on_100eur, rule_count
    order_by: avg_fee_on_100eur asc
  }

  view: by_scheme_at_1000 is {
    group_by: card_scheme
    aggregate: avg_fee_on_1000eur, rule_count
    order_by: avg_fee_on_1000eur asc
  }

  view: by_scheme_at_4321 is {
    group_by: card_scheme
    aggregate: avg_fee_on_4321eur, rule_count
    order_by: avg_fee_on_4321eur desc
  }

  // Credit-only scheme comparison (e.g. "credit txn of 1000 EUR on NexPay").
  view: by_scheme_credit_at_1000 is {
    where: is_credit = true
    group_by: card_scheme
    aggregate: avg_fee_on_1000eur, rule_count
    order_by: avg_fee_on_1000eur asc
  }
}
