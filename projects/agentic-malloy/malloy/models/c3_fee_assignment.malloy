// c3_fee_assignment.malloy
// Central fact × rule matching source.
//
// Hard requirement from the prior failure: every column referenced in the
// `join_many ... on` predicate MUST be a real local column on the source
// being extended — NOT a pass-through dimension reached through another
// join. We therefore:
//   1. extend payments_enriched with a month_num + merchant_month_key
//      dimension and a join_one to merchant_monthly_context,
//   2. then PROJECT (`->`) every matching attribute (account_type,
//      merchant_mcc, capture_delay_rule, monthly_volume_bucket,
//      monthly_fraud_bucket, …) as a REAL local column —
//      → source `fee_match_facts`,
//   3. then extend that flat source with `join_many: rules` whose `on`
//      predicate only references columns now physically present on
//      `fee_match_facts`.
//
// Fee per (txn × matched rule) pair = fixed_amount + rate * eur_amount / 10000.
// Wildcards (per the column profile):
//   - list cols on fees (account_type, merchant_category_code, aci):
//       empty list ⇒ "applies to all"   → len!number(col)=0 OR list_contains(...)
//   - scalar cols on fees (capture_delay, monthly_volume, monthly_fraud_level,
//       is_credit, intracountry):
//       NULL ⇒ "applies to all"          → col is null OR col = <fact value>

// ───────────────────────────────────────────────────────────────────────
// 1+2. Flat fact rows with EVERY matching attribute materialized locally.
// ───────────────────────────────────────────────────────────────────────
source: fee_match_facts is payments_enriched extend {

  // Month number derived from day_of_year via the 2023 boundary table.
  // (Deliberately avoids date_add/make_date arithmetic which broke before.)
  dimension: month_num is
    pick 1  when day_of_year <= 31
    pick 2  when day_of_year <= 59
    pick 3  when day_of_year <= 90
    pick 4  when day_of_year <= 120
    pick 5  when day_of_year <= 151
    pick 6  when day_of_year <= 181
    pick 7  when day_of_year <= 212
    pick 8  when day_of_year <= 243
    pick 9  when day_of_year <= 273
    pick 10 when day_of_year <= 304
    pick 11 when day_of_year <= 334
    else 12

  dimension: fm_merchant_month_key is concat(merchant, '|', month_num::string)

  // Picks up the monthly volume/fraud bucket strings (already shaped to the
  // exact fee-rule vocabulary in merchant_monthly_context).
  join_one: mctx is merchant_monthly_context
    on fm_merchant_month_key = mctx.merchant_month_key

} -> {
  // PROJECTION: turn every attribute reached through joins into a REAL
  // local column on the resulting source.
  select:
    psp_reference
    merchant
    card_scheme
    eur_amount
    is_credit
    is_intracountry
    aci
    has_fraudulent_dispute
    day_of_year
    `year`
    hour_of_day
    issuing_country
    acquirer_country
    shopper_interaction
    acct_type                  is account_type            // merchants.account_type
    account_type_label         is account_type_label
    merchant_mcc_int           is merchant_mcc            // merchants.MCC (INT)
    mcc_description            is mcc_description
    capture_delay_rule_local   is capture_delay_rule      // mapped to fee vocab
    month_num                  is month_num
    monthly_volume_bucket_local is mctx.monthly_volume_bucket
    monthly_fraud_bucket_local  is mctx.monthly_fraud_bucket
}

// ───────────────────────────────────────────────────────────────────────
// 3. The big fact × rule match. join_many fans out each transaction to
//    EVERY fee rule whose criteria it satisfies. All `on` predicates
//    reference only fee_match_facts' OWN columns plus rules.* — no
//    second-hop aliases.
// ───────────────────────────────────────────────────────────────────────
source: fee_match is fee_match_facts extend {

  join_many: rules is fees_base on
        rules.card_scheme = card_scheme
    and (rules.is_credit is null or rules.is_credit = is_credit)
    and (rules.intracountry is null
         or (rules.intracountry = 1 and is_intracountry)
         or (rules.intracountry = 0 and not is_intracountry))
    and (rules.capture_delay is null
         or rules.capture_delay = capture_delay_rule_local)
    and (rules.monthly_volume is null
         or rules.monthly_volume = monthly_volume_bucket_local)
    and (rules.monthly_fraud_level is null
         or rules.monthly_fraud_level = monthly_fraud_bucket_local)
    and (len!number(rules.account_type) = 0
         or list_contains!boolean(rules.account_type, acct_type))
    and (len!number(rules.merchant_category_code) = 0
         or list_contains!boolean(rules.merchant_category_code, merchant_mcc_int))
    and (len!number(rules.aci) = 0
         or list_contains!boolean(rules.aci, aci))

  // ── Per-pair fee (fact + rule columns mixed). ───────────────────────
  dimension: pair_fee_eur       is rules.fixed_amount + rules.rate * eur_amount / 10000.0
  dimension: pair_fee_on_100eur is rules.fixed_amount + rules.rate * 100.0       / 10000.0

  // ── Pair-grain aggregates (asymmetric — qualified with rules.*). ────
  measure: total_fee_eur is
    rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000.0)
  measure: matched_volume_eur is rules.sum(eur_amount)
  measure: avg_pair_fee_eur is
    rules.avg(rules.fixed_amount + rules.rate * eur_amount / 10000.0)

  // ── Symmetric counts (safe across join_many). ───────────────────────
  measure: pair_count        is count()                     // pairs (txn × rule)
  measure: txn_count         is count(psp_reference)        // distinct txns
  measure: matched_rule_count is count(rules.ID)            // distinct rule IDs

  // ── End-to-end views: rule applicability ────────────────────────────
  view: applicable_rules_by_merchant_year is {
    where: `year` = 2023
    group_by: merchant, rule_id is rules.ID
    aggregate: pair_count
    order_by: merchant, rule_id
  }

  view: applicable_rules_by_merchant_month is {
    where: `year` = 2023
    group_by: merchant, month_num, rule_id is rules.ID
    aggregate: pair_count
    order_by: merchant, month_num, rule_id
  }

  view: applicable_rules_by_merchant_day is {
    where: `year` = 2023
    group_by: merchant, day_of_year, rule_id is rules.ID
    aggregate: pair_count
    order_by: merchant, day_of_year, rule_id
  }

  view: merchants_affected_by_rule is {
    where: `year` = 2023
    group_by: rule_id is rules.ID, merchant
    aggregate: pair_count
    order_by: rule_id, merchant
  }

  // ── End-to-end views: total fees paid ───────────────────────────────
  view: total_fees_by_merchant_year is {
    where: `year` = 2023
    group_by: merchant
    aggregate: total_fee_eur, txn_count
    order_by: merchant
  }

  view: total_fees_by_merchant_month is {
    where: `year` = 2023
    group_by: merchant, month_num
    aggregate: total_fee_eur, txn_count
    order_by: merchant, month_num
  }

  view: total_fees_by_merchant_day is {
    where: `year` = 2023
    group_by: merchant, day_of_year
    aggregate: total_fee_eur, txn_count
    order_by: merchant, day_of_year
  }

  view: total_fees_by_merchant_card_scheme is {
    where: `year` = 2023
    group_by: merchant, card_scheme
    aggregate: total_fee_eur, txn_count
    order_by: merchant, card_scheme
  }

  view: total_fees_by_merchant_month_card_scheme is {
    where: `year` = 2023
    group_by: merchant, month_num, card_scheme
    aggregate: total_fee_eur, txn_count
    order_by: merchant, month_num, card_scheme
  }

  view: total_fees_by_merchant_aci is {
    where: `year` = 2023
    group_by: merchant, aci
    aggregate: total_fee_eur, txn_count
    order_by: merchant, aci
  }

  view: total_fees_by_merchant_month_aci is {
    where: `year` = 2023
    group_by: merchant, month_num, aci
    aggregate: total_fee_eur, txn_count
    order_by: merchant, month_num, aci
  }

  // ── What-if support: rule-rate override ────────────────────────────
  // Expose per-rule matched volume so the agent can compute the delta of
  // a rate change as:  delta = (new_rate - rules.rate) * matched_volume / 10000.
  view: matched_volume_by_merchant_year_rule is {
    where: `year` = 2023
    group_by: merchant, rule_id is rules.ID, rule_rate is rules.rate, rule_fixed_amount is rules.fixed_amount
    aggregate: matched_volume_eur, pair_count
    order_by: merchant, rule_id
  }

  view: matched_volume_by_merchant_month_rule is {
    where: `year` = 2023
    group_by: merchant, month_num, rule_id is rules.ID, rule_rate is rules.rate, rule_fixed_amount is rules.fixed_amount
    aggregate: matched_volume_eur, pair_count
    order_by: merchant, month_num, rule_id
  }
}

// ───────────────────────────────────────────────────────────────────────
// What-if: STEER all traffic to a different card scheme.
// Same predicate as `fee_match` but with the card_scheme equality dropped,
// so each transaction fans out to matching rules of EVERY card scheme.
// Group by rules.card_scheme to see what the merchant would pay under each.
// ───────────────────────────────────────────────────────────────────────
source: fee_match_any_scheme is fee_match_facts extend {

  join_many: rules is fees_base on
        (rules.is_credit is null or rules.is_credit = is_credit)
    and (rules.intracountry is null
         or (rules.intracountry = 1 and is_intracountry)
         or (rules.intracountry = 0 and not is_intracountry))
    and (rules.capture_delay is null
         or rules.capture_delay = capture_delay_rule_local)
    and (rules.monthly_volume is null
         or rules.monthly_volume = monthly_volume_bucket_local)
    and (rules.monthly_fraud_level is null
         or rules.monthly_fraud_level = monthly_fraud_bucket_local)
    and (len!number(rules.account_type) = 0
         or list_contains!boolean(rules.account_type, acct_type))
    and (len!number(rules.merchant_category_code) = 0
         or list_contains!boolean(rules.merchant_category_code, merchant_mcc_int))
    and (len!number(rules.aci) = 0
         or list_contains!boolean(rules.aci, aci))

  measure: total_fee_eur is
    rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000.0)
  measure: txn_count is count(psp_reference)

  view: total_fees_by_merchant_year_steered_scheme is {
    where: `year` = 2023
    group_by: merchant, rule_card_scheme is rules.card_scheme
    aggregate: total_fee_eur, txn_count
    order_by: merchant, rule_card_scheme
  }

  view: total_fees_by_merchant_month_steered_scheme is {
    where: `year` = 2023
    group_by: merchant, month_num, rule_card_scheme is rules.card_scheme
    aggregate: total_fee_eur, txn_count
    order_by: merchant, month_num, rule_card_scheme
  }
}
