source: c2_payments_enriched is payments_base extend {

  // merchant profile (30-row dim; no PK declared → explicit on, qualify `merchant`)
  join_one: merchant_profile is merchants_base
    on merchant = merchant_profile.merchant

  // MCC code → description lookup (integer code match)
  join_one: mcc is merchant_category_codes_base
    on merchant_profile.merchant_category_code = mcc.mcc_code

  // merchant × natural-month bands (one row per merchant×month → join_one)
  join_one: monthly is c1_merchant_monthly
    on merchant = monthly.merchant and `month` = monthly.`month`

  // ---- rule-match keys surfaced as real dimensions (transaction grain) ----
  dimension:
    account_type             is merchant_profile.account_type
    account_type_description is merchant_profile.account_type_description
    merchant_category_code   is merchant_profile.merchant_category_code
    mcc_description          is mcc.description
    capture_delay_band       is merchant_profile.capture_delay_band
    // 1 = domestic, 0 = international — matches fees.intracountry encoding
    intracountry_value       is pick 1 when is_domestic else 0
    monthly_volume_band      is monthly.monthly_volume_band
    monthly_fraud_level_band is monthly.monthly_fraud_level_band

  // ---- discriminating count/amount splits (routing) ----
  measure:
    international_count  is count() { where: not is_domestic }
    international_amount is eur_amount.sum() { where: not is_domestic }

  // ---- per-transaction match-key surface (project; keys are row-specific) ----
  view: match_keys is {
    select:
      psp_reference
      merchant
      `year`
      `month`
      day_of_year
      card_scheme
      account_type
      merchant_category_code
      mcc_description
      aci
      capture_delay_band
      is_credit
      intracountry_value
      monthly_volume_band
      monthly_fraud_level_band
      eur_amount
  }

  // keys grouped (intracountry_value / is_credit / card_scheme / aci are
  // GROUP_BY dims here so they discriminate rows — never collapsed to a flag)
  view: by_merchant_month_keys is {
    group_by:
      merchant
      `month`
      account_type
      merchant_category_code
      capture_delay_band
      monthly_volume_band
      monthly_fraud_level_band
      card_scheme
      aci
      is_credit
      intracountry_value
    aggregate:
      transaction_count
      total_amount
      avg_amount
    order_by: merchant, `month`
  }

  // distribution of domestic vs international per merchant (routing lever)
  view: by_merchant_routing is {
    group_by: merchant, routing_type
    aggregate: transaction_count, total_amount, avg_amount
    order_by: merchant
  }
}
