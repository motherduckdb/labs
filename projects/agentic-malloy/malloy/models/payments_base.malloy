// payments_base.malloy
// Base source over the raw `payments` table.
// NO joins here — only dimensions + measures derived from columns of `payments`.
//
// Grain: one row per payment attempt (psp_reference is unique — 138,236 distinct).
// All amounts are in EUR. year is constant 2023 in the data.

source: payments_base is duckdb.table('payments') extend {

  primary_key: psp_reference

  // ---------------------------------------------------------------
  // DIMENSIONS — derived only (raw columns are already visible)
  // ---------------------------------------------------------------

  // Synthetic transaction date built from year + day_of_year (2023 only in data).
  dimension: transaction_date is
    (@2023-01-01 + (day_of_year - 1) day)::date

  dimension: transaction_month is transaction_date.month
  dimension: transaction_quarter is transaction_date.quarter
  dimension: transaction_week is transaction_date.week

  // Hour bucket label
  dimension: time_of_day is
    pick 'night'   when hour_of_day < 6
    pick 'morning' when hour_of_day < 12
    pick 'afternoon' when hour_of_day < 18
    else 'evening'

  // Channel: Ecommerce vs POS already exists as shopper_interaction.
  // Local vs cross-border acquiring (manual §5.1.1: local = issuer country == acquirer country).
  dimension: is_intracountry is issuing_country = acquirer_country
  dimension: acquiring_scope is
    pick 'domestic' when issuing_country = acquirer_country
    else 'cross_border'

  // IP/issuer mismatch — a common fraud signal.
  dimension: ip_issuer_mismatch is
    ip_country is not null and ip_country != issuing_country

  // Credit vs debit label
  dimension: credit_or_debit is
    pick 'credit' when is_credit
    else 'debit'

  // ACI human-readable label (manual §4)
  dimension: aci_label is
    pick 'Card present - Non-authenticated'        when aci = 'A'
    pick 'Card present - Authenticated'            when aci = 'B'
    pick 'Tokenized card with mobile device'       when aci = 'C'
    pick 'Card Not Present - Card On File'         when aci = 'D'
    pick 'Card Not Present - Recurring Bill'       when aci = 'E'
    pick 'Card Not Present - 3-D Secure'           when aci = 'F'
    pick 'Card Not Present - Non-3-D Secure'       when aci = 'G'
    else 'Unknown'

  // Coarse ACI grouping: card-present vs card-not-present
  dimension: aci_channel is
    pick 'card_present'     when aci = 'A' | 'B'
    pick 'tokenized_mobile' when aci = 'C'
    pick 'card_not_present' when aci = 'D' | 'E' | 'F' | 'G'
    else 'unknown'

  // Eur amount buckets (range 0.50 .. 4811.76)
  dimension: amount_bucket is
    pick 'micro (<10)'      when eur_amount < 10
    pick 'small (10-50)'    when eur_amount < 50
    pick 'medium (50-250)'  when eur_amount < 250
    pick 'large (250-1000)' when eur_amount < 1000
    else 'xlarge (1000+)'

  // ---------------------------------------------------------------
  // MEASURES
  // ---------------------------------------------------------------

  measure: transaction_count is count()
  measure: distinct_shoppers is count(email_address)
  measure: distinct_cards    is count(card_number)
  measure: distinct_ips      is count(ip_address)
  measure: distinct_merchants is count(merchant)

  // Money — symmetric within this single source.
  measure: total_eur     is eur_amount.sum()
  measure: avg_eur       is eur_amount.avg()
  measure: min_eur       is eur_amount.min()
  measure: max_eur       is eur_amount.max()

  // Counts of outcomes
  measure: fraud_count is count() { where: has_fraudulent_dispute }
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: approved_count is count() { where: not is_refused_by_adyen }

  measure: fraud_eur is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: refused_eur is eur_amount.sum() { where: is_refused_by_adyen }

  // Rates — defined as fractions of total (0..1). Format at display time.
  measure: fraud_rate is fraud_count / transaction_count
  measure: refusal_rate is refused_count / transaction_count
  measure: authorization_rate is approved_count / transaction_count

  // Volume-weighted fraud rate (manual §7: "ratio of fraudulent volume over total volume").
  measure: fraud_volume_rate is fraud_eur / total_eur

  // Channel-specific helpers
  measure: ecom_count is count() { where: shopper_interaction = 'Ecommerce' }
  measure: pos_count  is count() { where: shopper_interaction = 'POS' }
  measure: credit_count is count() { where: is_credit }
  measure: debit_count  is count() { where: not is_credit }

  measure: domestic_count is count() { where: issuing_country = acquirer_country }
  measure: cross_border_count is count() { where: issuing_country != acquirer_country }
  measure: cross_border_rate is cross_border_count / transaction_count

  // ---------------------------------------------------------------
  // Handy reusable views
  // ---------------------------------------------------------------

  view: by_merchant is {
    group_by: merchant
    aggregate:
      transaction_count
      total_eur
      fraud_rate
      refusal_rate
    order_by: transaction_count desc
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_eur, fraud_rate
    order_by: transaction_count desc
  }

  view: by_aci is {
    group_by: aci, aci_label
    aggregate: transaction_count, total_eur, fraud_rate, refusal_rate
    order_by: transaction_count desc
  }

  view: by_month is {
    group_by: transaction_month
    aggregate: transaction_count, total_eur, fraud_rate
    order_by: transaction_month
  }

  view: by_hour is {
    group_by: hour_of_day
    aggregate: transaction_count, total_eur, fraud_rate
    order_by: hour_of_day
  }

  view: by_country_pair is {
    group_by: issuing_country, acquirer_country
    aggregate: transaction_count, total_eur, fraud_rate
    order_by: transaction_count desc
  }
}
