source: payments_base is duckdb.table('payments') extend {
  primary_key: psp_reference

  // calendar reconstructed from year + day_of_year (%j needs 3-digit day)
  dimension: txn_date is
    strptime!timestamp(concat(`year`::string, lpad!string(day_of_year::string, 3, '0')), '%Y%j')::date
  dimension: txn_month is txn_date.month
  dimension: month_num is month(txn_date)

  // domestic = issuer country equals acquiring country
  dimension: is_intracountry is issuing_country = acquirer_country
  // 0/1 form for matching fees.intracountry (stored as number there)
  dimension: intracountry_num is pick 1 when issuing_country = acquirer_country else 0

  measure: transaction_count is count()
  measure: total_amount is eur_amount.sum()
  measure: avg_amount is eur_amount.avg()
  measure: min_amount is eur_amount.min()
  measure: max_amount is eur_amount.max()

  measure: merchant_count is count(merchant)
  measure: card_count is count(card_number)
  measure: email_count is count(email_address)
  measure: scheme_count is count(card_scheme)

  measure: fraud_count is count() { where: has_fraudulent_dispute }
  measure: fraud_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: fraud_rate_by_count is fraud_count / transaction_count
  // fraud level per docs = fraudulent volume / total volume
  measure: fraud_rate_by_volume is fraud_amount / total_amount

  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: refusal_rate is refused_count / transaction_count
  measure: accepted_count is count() { where: not is_refused_by_adyen }

  measure: credit_count is count() { where: is_credit }
  measure: credit_share is credit_count / transaction_count
  measure: credit_amount is eur_amount.sum() { where: is_credit }

  measure: intracountry_count is count() { where: issuing_country = acquirer_country }
  measure: intracountry_share is intracountry_count / transaction_count
  measure: intracountry_amount is eur_amount.sum() { where: issuing_country = acquirer_country }

  view: by_merchant is {
    group_by: merchant
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume, refusal_rate
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
  }

  view: by_aci is {
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount, fraud_count, fraud_amount
  }

  view: by_issuing_country is {
    group_by: issuing_country
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_month is {
    group_by: txn_month
    aggregate: transaction_count, total_amount, avg_amount, fraud_amount, fraud_rate_by_volume
    order_by: txn_month asc
  }

  // natural-month totals per merchant: input to volume/fraud fee-tier matching
  view: merchant_monthly is {
    group_by: merchant, txn_month
    aggregate: total_amount, fraud_amount, fraud_rate_by_volume, transaction_count
    order_by: merchant asc, txn_month asc
  }

  view: by_device_type is {
    group_by: device_type
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_shopper_interaction is {
    group_by: shopper_interaction
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
  }
}
