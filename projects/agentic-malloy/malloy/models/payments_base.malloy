source: payments_base is duckdb.table('payments') extend {

  // --- derived dimensions (only NEW names; never redefine table columns) ---

  // year(1,1) + offset days -> calendar date; enables month/day slicing
  dimension: transaction_date is make_date!date(`year`, 1, 1) + (day_of_year - 1) days
  dimension: transaction_month is transaction_date.month

  // domestic transaction: issuer country equals acquirer country
  dimension: is_intracountry is issuing_country = acquirer_country

  // fee variable-base helper (rate * value / 10000 is added to a fixed amount elsewhere)
  dimension: amount_basis_points is eur_amount / 10000

  // --- measures: full standard aggregation set over eur_amount + counts ---

  measure: transaction_count is count()

  measure: total_amount is eur_amount.sum()
  measure: avg_amount is eur_amount.avg()
  measure: min_amount is eur_amount.min()
  measure: max_amount is eur_amount.max()

  // fraud subset (filtered aggregates)
  measure: fraud_transaction_count is count() { where: has_fraudulent_dispute }
  measure: fraud_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  // fraud rate as ratio of fraudulent volume to total volume (manual fraud-band measure)
  measure: fraud_volume_rate is eur_amount.sum() { where: has_fraudulent_dispute } / eur_amount.sum()
  measure: fraud_count_rate is count() { where: has_fraudulent_dispute } / count()

  // refusal / credit / channel subsets
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: refusal_rate is count() { where: is_refused_by_adyen } / count()
  measure: credit_count is count() { where: is_credit }
  measure: credit_amount is eur_amount.sum() { where: is_credit }
  measure: intracountry_count is count() { where: is_intracountry }
  measure: intracountry_amount is eur_amount.sum() { where: is_intracountry }

  measure: distinct_merchants is count(merchant)
  measure: distinct_cards is count(card_number)

  // --- reusable views ---

  view: by_merchant is {
    group_by: merchant
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_aci is {
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_month is {
    group_by: transaction_month
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_issuing_country is {
    group_by: issuing_country
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: fraud_overview is {
    group_by: merchant
    aggregate: transaction_count, total_amount, fraud_transaction_count, fraud_amount, fraud_volume_rate
  }
}
