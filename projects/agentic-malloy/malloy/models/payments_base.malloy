// payments_base.malloy
// Base semantic model for the `payments` transaction table.
// Adds derived dimensions (timestamps, geography flags, account-type labels,
// ACI labels) and the core KPI measures called out in the Merchant Manual:
// authorization rate, fraud rate, refusal rate, transaction counts/volume.
// NO joins here — join logic belongs in payments.malloy.

source: payments_base is duckdb.table('payments') extend {

  //--------------------------------------------------------------------------
  // Derived time dimensions
  //--------------------------------------------------------------------------
  // day_of_year + year → an actual date (Jan 1 of `year` + (day_of_year - 1) days).
  dimension: transaction_date is
    (make_date!date(`year`, 1, 1) + (day_of_year - 1) day)::date

  dimension: transaction_timestamp is
    (transaction_date::timestamp
      + hour_of_day hour
      + minute_of_hour minute)

  dimension: transaction_month is transaction_date.month
  dimension: transaction_quarter is transaction_date.quarter
  dimension: transaction_week is transaction_date.week

  // Rough time-of-day buckets
  dimension: time_of_day is
    pick 'night'   when hour_of_day < 6
    pick 'morning' when hour_of_day < 12
    pick 'afternoon' when hour_of_day < 18
    else 'evening'

  //--------------------------------------------------------------------------
  // Geography / routing
  //--------------------------------------------------------------------------
  // "Local acquiring" (section 5.1.1): issuer country == acquirer country.
  dimension: is_intracountry is issuing_country = acquirer_country
  dimension: is_cross_border is issuing_country != acquirer_country

  // IP/issuer mismatch — a common fraud signal.
  dimension: ip_issuer_mismatch is ip_country != issuing_country

  //--------------------------------------------------------------------------
  // ACI label (section 4)
  //--------------------------------------------------------------------------
  dimension: aci_label is
    pick 'Card present - Non-authenticated'         when aci = 'A'
    pick 'Card Present - Authenticated'             when aci = 'B'
    pick 'Tokenized card with mobile device'        when aci = 'C'
    pick 'Card Not Present - Card On File'          when aci = 'D'
    pick 'Card Not Present - Recurring Bill'        when aci = 'E'
    pick 'Card Not Present - 3-D Secure'            when aci = 'F'
    pick 'Card Not Present - Non-3-D Secure'        when aci = 'G'
    else 'Unknown'

  dimension: is_card_present is aci ? 'A' | 'B'
  dimension: is_card_not_present is aci ? 'D' | 'E' | 'F' | 'G'
  dimension: is_3d_secure is aci = 'F'

  //--------------------------------------------------------------------------
  // Transaction type / amount buckets
  //--------------------------------------------------------------------------
  dimension: credit_or_debit is
    pick 'credit' when is_credit
    else 'debit'

  dimension: amount_bucket is
    pick 'micro (<10)'      when eur_amount < 10
    pick 'small (10-50)'    when eur_amount < 50
    pick 'medium (50-200)'  when eur_amount < 200
    pick 'large (200-1000)' when eur_amount < 1000
    else 'xlarge (>=1000)'

  //--------------------------------------------------------------------------
  // Card BIN as string (BINs are conventionally 6-digit codes)
  //--------------------------------------------------------------------------
  dimension: card_bin_str is card_bin::string

  //==========================================================================
  // MEASURES
  //==========================================================================

  // Volumes
  measure: transaction_count is count()
  measure: unique_shoppers is count(email_address)
  measure: unique_cards is count(card_number)
  measure: unique_merchants is count(merchant)

  measure: total_eur_amount is eur_amount.sum()
  measure: avg_eur_amount is eur_amount.avg()
  measure: median_eur_amount is eur_amount.avg()
  measure: max_eur_amount is eur_amount.max()
  measure: min_eur_amount is eur_amount.min()

  // Authorization / refusal (manual §8.2 KPIs)
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: authorized_count is count() { where: not is_refused_by_adyen }
  measure: refusal_rate is refused_count / count()
  measure: authorization_rate is authorized_count / count()

  // Fraud (manual §7: fraud = fraudulent volume / total volume)
  measure: fraud_count is count() { where: has_fraudulent_dispute }
  measure: fraud_rate is fraud_count / count()
  measure: fraud_eur_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: fraud_volume_rate is fraud_eur_amount / eur_amount.sum()

  // Cross-border vs local mix (manual §5.1.1)
  measure: intracountry_count is count() { where: is_intracountry }
  measure: cross_border_count is count() { where: is_cross_border }
  measure: intracountry_share is intracountry_count / count()

  // Credit vs debit mix (credit is typically more expensive)
  measure: credit_count is count() { where: is_credit }
  measure: credit_share is credit_count / count()

  // 3-D Secure adoption
  measure: three_ds_count is count() { where: is_3d_secure }
  measure: three_ds_share is three_ds_count / count()
}
