source: payments_base is duckdb.table('payments') extend {

  // year is always 2023; build calendar date from day-of-year (natural months)
  dimension: transaction_date is @2023-01-01 + (day_of_year - 1) day
  dimension: transaction_month is transaction_date.month

  // domestic vs international: issuer country == acquirer country
  dimension: is_intracountry is issuing_country = acquirer_country

  // volume / value
  measure: transaction_count is count()
  measure: total_amount is eur_amount.sum()
  measure: avg_amount is eur_amount.avg()
  measure: min_amount is eur_amount.min()
  measure: max_amount is eur_amount.max()

  // fraud
  measure: fraudulent_count is count() { where: has_fraudulent_dispute }
  measure: fraudulent_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: fraud_rate is fraudulent_amount / nullif!number(total_amount, 0)  // ratio of fraud volume to total volume

  // authorization outcome
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: refusal_rate is refused_count / nullif!number(transaction_count, 0)

  // credit / debit split
  measure: credit_count is count() { where: is_credit }
  measure: credit_amount is eur_amount.sum() { where: is_credit }
  measure: debit_amount is eur_amount.sum() { where: not is_credit }

  // domestic split
  measure: intracountry_count is count() { where: is_intracountry }
  measure: intracountry_amount is eur_amount.sum() { where: is_intracountry }

  view: by_merchant is {
    group_by: merchant
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate
  }

  view: by_aci is {
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_issuing_country is {
    group_by: issuing_country
    aggregate: transaction_count, total_amount, avg_amount
  }

  view: by_device_type is {
    group_by: device_type
    aggregate: transaction_count, total_amount, fraud_rate
  }

  view: by_month is {
    group_by: transaction_month
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate
    order_by: transaction_month
  }

  // per-merchant per natural-month volume (basis for fee monthly_volume bands)
  view: monthly_volume_per_merchant is {
    group_by: merchant, transaction_month
    aggregate: total_amount, transaction_count
    order_by: merchant, transaction_month
  }

  // per-merchant per natural-month fraud ratio (basis for fee monthly_fraud_level bands)
  view: monthly_fraud_per_merchant is {
    group_by: merchant, transaction_month
    aggregate: total_amount, fraudulent_amount, fraud_rate
    order_by: merchant, transaction_month
  }

  view: fraud_overview is {
    group_by: merchant
    aggregate: transaction_count, total_amount, fraudulent_count, fraudulent_amount, fraud_rate
  }
}
