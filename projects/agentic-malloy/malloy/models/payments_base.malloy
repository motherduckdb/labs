// payments_base.malloy
// Base source over the raw payments table. NO joins here — only
// dimensions and measures derived from columns in this table.
// Domain notes (from column profile + Merchant Manual):
//   - year is always 2023; day_of_year ∈ [1..365] → derive a real date.
//   - aci ∈ {A..G} per the ACI section of the manual.
//   - shopper_interaction ∈ {Ecommerce, POS}.
//   - "intracountry" (per fee rules) ≡ issuing_country = acquirer_country.

source: payments_base is duckdb.table('payments') extend {
  primary_key: psp_reference

  //
  // ── Derived time dimensions ─────────────────────────────────────────
  //
  // day_of_year + year → real DATE; 2023-01-01 + (day_of_year - 1) days.
  dimension: transaction_date is
    date_add!date(make_date!date(`year`, 1, 1), day_of_year - 1, 'day')

  dimension: transaction_month is transaction_date.month
  dimension: transaction_quarter is transaction_date.quarter
  dimension: transaction_week is transaction_date.week
  dimension: day_of_week is dayofweek!number(transaction_date)

  dimension: time_of_day_bucket is
    pick 'night'   when hour_of_day < 6
    pick 'morning' when hour_of_day < 12
    pick 'afternoon' when hour_of_day < 18
    else 'evening'

  //
  // ── Derived business dimensions ─────────────────────────────────────
  //
  // Local acquiring per manual §5.1.1: issuer country = acquirer country.
  dimension: is_intracountry is issuing_country = acquirer_country
  dimension: is_crossborder is issuing_country != acquirer_country

  // IP vs issuing country mismatch — a fraud signal.
  dimension: ip_issuer_mismatch is
    ip_country is not null and ip_country != issuing_country

  // ACI human label per manual §4.
  dimension: aci_label is
    pick 'Card present - Non-authenticated'        when aci = 'A'
    pick 'Card Present - Authenticated'            when aci = 'B'
    pick 'Tokenized card with mobile device'       when aci = 'C'
    pick 'Card Not Present - Card On File'         when aci = 'D'
    pick 'Card Not Present - Recurring Bill Pmt'   when aci = 'E'
    pick 'Card Not Present - 3-D Secure'           when aci = 'F'
    pick 'Card Not Present - Non-3-D Secure'       when aci = 'G'
    else 'Unknown'

  // Card-present vs card-not-present grouping by ACI.
  dimension: is_card_present is aci = 'A' or aci = 'B'
  dimension: is_card_not_present is aci = 'D' or aci = 'E' or aci = 'F' or aci = 'G'
  dimension: is_3d_secure is aci = 'F'

  // Outcome flags
  dimension: is_successful is not is_refused_by_adyen
  dimension: credit_or_debit is pick 'credit' when is_credit else 'debit'

  //
  // ── Volume / count measures ─────────────────────────────────────────
  //
  measure: transaction_count is count()
  measure: unique_shoppers is count(email_address)
  measure: unique_cards is count(card_number)
  measure: unique_ips is count(ip_address)

  measure: total_eur is eur_amount.sum()
  measure: avg_eur is eur_amount.avg()
  measure: median_eur is eur_amount.avg()
  measure: max_eur is eur_amount.max()
  measure: min_eur is eur_amount.min()

  //
  // ── Outcome-segmented counts/volumes (filtered aggregates) ─────────
  //
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: approved_count is count() { where: not is_refused_by_adyen }
  measure: fraud_count   is count() { where: has_fraudulent_dispute }

  measure: refused_eur  is eur_amount.sum() { where: is_refused_by_adyen }
  measure: approved_eur is eur_amount.sum() { where: not is_refused_by_adyen }
  measure: fraud_eur    is eur_amount.sum() { where: has_fraudulent_dispute }

  //
  // ── Rates (KPIs from manual §8.2) ──────────────────────────────────
  //
  measure: authorization_rate is approved_count / count()      // higher is better
  measure: refusal_rate       is refused_count  / count()
  measure: fraud_rate         is fraud_count    / count()      // by count
  measure: fraud_volume_rate  is fraud_eur / nullif!number(total_eur, 0)  // by € (manual §7)

  //
  // ── Mix measures ───────────────────────────────────────────────────
  //
  measure: credit_count       is count() { where: is_credit }
  measure: credit_share       is credit_count / count()
  measure: intracountry_count is count() { where: is_intracountry }
  measure: intracountry_share is intracountry_count / count()
  measure: ecommerce_count    is count() { where: shopper_interaction = 'Ecommerce' }
  measure: ecommerce_share    is ecommerce_count / count()
}
