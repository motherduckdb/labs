// payments_base.malloy
// Base semantic source over the payments fact table.
// Grain: one row per payment (psp_reference). No joins here.

source: payments_base is duckdb.table('payments') extend {

  //------------------------------------------------------------------
  // Derived dimensions
  //------------------------------------------------------------------

  // Calendar — payments only carry year + day_of_year (+ hour/minute).
  // Build a real DATE so users can filter with @2023-02 / .month etc.
  dimension: transaction_date is make_date!date(`year`, 1, 1) + (day_of_year - 1) day
  dimension: transaction_month is transaction_date.month
  dimension: transaction_quarter is transaction_date.quarter

  // Local acquiring flag: issuer country == acquirer country.
  // Matches fees.intracountry semantics (1.0 = domestic, 0.0 = cross-border).
  dimension: is_intracountry is issuing_country = acquirer_country

  // Cross-border indicator (complement, for convenience)
  dimension: is_cross_border is issuing_country != acquirer_country

  // Approval flag — Adyen acceptance is the inverse of is_refused_by_adyen
  dimension: is_approved is not is_refused_by_adyen

  // ACI groupings (card-present vs card-not-present, per the manual)
  dimension: aci_group is
    pick 'CardPresent'    when aci = 'A' or aci = 'B'
    pick 'Tokenized'      when aci = 'C'
    pick 'CardNotPresent' when aci = 'D' or aci = 'E' or aci = 'F' or aci = 'G'
    else 'Other'

  // Channel — Ecommerce vs POS already in shopper_interaction, expose as channel
  dimension: channel is shopper_interaction

  //------------------------------------------------------------------
  // Symmetric measures (safe across joins)
  //------------------------------------------------------------------

  measure: transaction_count is count()
  measure: distinct_merchants is count(merchant)
  measure: distinct_card_schemes is count(card_scheme)
  measure: distinct_issuing_countries is count(issuing_country)
  measure: distinct_acquirer_countries is count(acquirer_country)
  measure: distinct_card_numbers is count(card_number)

  measure: fraudulent_transaction_count is count() { where: has_fraudulent_dispute }
  measure: refused_transaction_count    is count() { where: is_refused_by_adyen }
  measure: approved_transaction_count   is count() { where: not is_refused_by_adyen }
  measure: credit_transaction_count     is count() { where: is_credit }
  measure: debit_transaction_count      is count() { where: not is_credit }
  measure: intracountry_count           is count() { where: issuing_country = acquirer_country }
  measure: cross_border_count           is count() { where: issuing_country != acquirer_country }
  measure: ecommerce_count              is count() { where: shopper_interaction = 'Ecommerce' }
  measure: pos_count                    is count() { where: shopper_interaction = 'POS' }

  //------------------------------------------------------------------
  // Asymmetric measures — use payments_base.<x>.sum/avg form
  //------------------------------------------------------------------

  measure: total_eur_volume is eur_amount.sum()
  measure: avg_transaction_value is eur_amount.avg()
  measure: min_transaction_value is eur_amount.min()
  measure: max_transaction_value is eur_amount.max()

  measure: fraudulent_eur_volume is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: refused_eur_volume    is eur_amount.sum() { where: is_refused_by_adyen }
  measure: approved_eur_volume   is eur_amount.sum() { where: not is_refused_by_adyen }
  measure: credit_eur_volume     is eur_amount.sum() { where: is_credit }
  measure: debit_eur_volume      is eur_amount.sum() { where: not is_credit }
  measure: intracountry_eur_volume is eur_amount.sum() { where: issuing_country = acquirer_country }
  measure: cross_border_eur_volume is eur_amount.sum() { where: issuing_country != acquirer_country }

  //------------------------------------------------------------------
  // Rate / share measures (use all() for percent-of-group)
  //------------------------------------------------------------------

  // Monthly fraud level = fraudulent volume / total volume (as the manual defines it).
  // Group by merchant + transaction_month upstream to get the per-month value.
  measure: fraud_rate_by_volume is
    eur_amount.sum() { where: has_fraudulent_dispute } / eur_amount.sum()

  measure: fraud_rate_by_count is
    fraudulent_transaction_count / transaction_count

  measure: refusal_rate is
    refused_transaction_count / transaction_count

  measure: approval_rate is
    approved_transaction_count / transaction_count

  measure: credit_share_by_volume is
    credit_eur_volume / total_eur_volume

  measure: intracountry_share_by_volume is
    intracountry_eur_volume / total_eur_volume

  measure: cross_border_share_by_volume is
    cross_border_eur_volume / total_eur_volume

  //------------------------------------------------------------------
  // Reusable views — generic slices of the payments fact.
  // (No fee logic here — that lives in higher-level sources that
  // join the fees rule table onto payments_base.)
  //------------------------------------------------------------------

  view: by_merchant is {
    group_by: merchant
    aggregate:
      transaction_count
      total_eur_volume
      avg_transaction_value
      fraud_rate_by_volume
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate:
      transaction_count
      total_eur_volume
      avg_transaction_value
  }

  view: by_aci is {
    group_by: aci
    aggregate:
      transaction_count
      total_eur_volume
      avg_transaction_value
      fraud_rate_by_volume
  }

  view: by_month is {
    group_by: transaction_month
    aggregate:
      transaction_count
      total_eur_volume
      fraudulent_eur_volume
      fraud_rate_by_volume
    order_by: transaction_month
  }

  // Cross-border profile by issuing country — exposes BOTH the
  // domestic and cross-border legs (and their share) so the ranking
  // isn't collapsed when a country has no same-country acquirer.
  // (e.g. BE/ES/GR/LU/SE have 0 intracountry share because their
  // acquirers aren't in their country; this view shows that fact
  // explicitly rather than tying everyone at 0 on a single metric.)
  view: by_issuing_country is {
    group_by: issuing_country
    aggregate:
      transaction_count
      total_eur_volume
      intracountry_count
      cross_border_count
      intracountry_eur_volume
      cross_border_eur_volume
      intracountry_share_by_volume
    order_by: total_eur_volume desc
  }

  view: by_acquirer_country is {
    group_by: acquirer_country
    aggregate:
      transaction_count
      total_eur_volume
      intracountry_count
      cross_border_count
  }

  view: by_country_pair is {
    group_by:
      issuing_country
      acquirer_country
    aggregate:
      transaction_count
      total_eur_volume
      fraud_rate_by_volume
    order_by: total_eur_volume desc
  }

  // Per-merchant per-month aggregate — the natural grain at which
  // monthly_volume and monthly_fraud_level buckets are computed.
  view: monthly_merchant_profile is {
    group_by:
      merchant
      transaction_month
    aggregate:
      total_eur_volume
      fraudulent_eur_volume
      fraud_rate_by_volume
      transaction_count
    order_by: merchant, transaction_month
  }

  view: by_credit_flag is {
    group_by: is_credit
    aggregate:
      transaction_count
      total_eur_volume
      avg_transaction_value
  }

  view: by_channel is {
    group_by: shopper_interaction
    aggregate:
      transaction_count
      total_eur_volume
      fraud_rate_by_volume
  }

  view: fraud_overview is {
    aggregate:
      transaction_count
      fraudulent_transaction_count
      total_eur_volume
      fraudulent_eur_volume
      fraud_rate_by_volume
      fraud_rate_by_count
  }
}
