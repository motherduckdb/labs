// c3_payments_enriched.malloy — payments fact enriched to fee-matching grain

// per-merchant natural-month aggregates (inputs to volume/fraud fee tiers)
source: merchant_month_stats is payments_base -> {
  group_by: merchant, txn_month
  aggregate:
    month_volume_eur is eur_amount.sum()
    month_fraud_volume_eur is eur_amount.sum() { where: has_fraudulent_dispute }
    // fraud level per docs = fraudulent volume / total volume, in percent
    month_fraud_pct is eur_amount.sum() { where: has_fraudulent_dispute } / eur_amount.sum() * 100
}

// projection MATERIALIZES joined merchant + monthly attributes as real local columns,
// so downstream rule matching can join_many on this source without cross-join scope errors
source: payments_enriched is payments_base extend {
  join_one: m is merchants_base with merchant
  // each payment row hits exactly its own (merchant, month) stats row — no fan-out
  join_one: mm is merchant_month_stats
    on merchant = mm.merchant and txn_month = mm.txn_month
} -> {
  select:
    psp_reference,
    merchant,
    card_scheme,
    `year`,
    hour_of_day,
    minute_of_hour,
    day_of_year,
    is_credit,
    eur_amount,
    ip_country,
    issuing_country,
    device_type,
    ip_address,
    email_address,
    card_number,
    shopper_interaction,
    card_bin,
    has_fraudulent_dispute,
    is_refused_by_adyen,
    aci,
    acquirer_country,
    txn_date,
    txn_month,
    month_num,
    is_intracountry,
    intracountry_num,          // 0/1 form matching fees.intracountry encoding
    merchant_account_type is m.account_type,
    merchant_mcc is m.merchant_category_code,
    merchant_capture_delay is m.capture_delay,
    merchant_capture_delay_bucket is m.capture_delay_bucket,   // fee-rule bucket domain
    monthly_volume_eur is mm.month_volume_eur,
    monthly_fraud_pct is mm.month_fraud_pct
} extend {
  primary_key: psp_reference

  measure: transaction_count is count()
  measure: total_amount is eur_amount.sum()
  measure: avg_amount is eur_amount.avg()
  measure: min_amount is eur_amount.min()
  measure: max_amount is eur_amount.max()
  measure: merchant_count is count(merchant)

  measure: fraud_count is count() { where: has_fraudulent_dispute }
  measure: fraud_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: fraud_rate_by_count is fraud_count / transaction_count
  measure: fraud_rate_by_volume is fraud_amount / total_amount

  measure: credit_count is count() { where: is_credit }
  measure: credit_share is credit_count / transaction_count
  measure: credit_amount is eur_amount.sum() { where: is_credit }

  measure: intracountry_count is count() { where: is_intracountry }
  measure: intracountry_share is intracountry_count / transaction_count
  measure: intracountry_amount is eur_amount.sum() { where: is_intracountry }

  view: avg_value_by_issuing_country is {
    group_by: issuing_country
    aggregate: avg_amount, transaction_count, total_amount
    order_by: avg_amount asc
  }

  view: by_card_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
  }

  view: by_aci is {
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount, fraud_count, fraud_amount
    order_by: aci asc
  }

  view: fraud_by_aci is {
    where: has_fraudulent_dispute
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount
    order_by: total_amount desc
  }

  view: by_month is {
    group_by: txn_month
    aggregate: transaction_count, total_amount, avg_amount, fraud_amount, fraud_rate_by_volume
    order_by: txn_month asc
  }

  view: by_merchant is {
    group_by: merchant, merchant_account_type, merchant_mcc, merchant_capture_delay_bucket
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
    order_by: merchant asc
  }

  // one row per merchant-month: the tier inputs fee rules bucket on
  view: merchant_month_tier_inputs is {
    group_by: merchant, txn_month, monthly_volume_eur, monthly_fraud_pct
    aggregate: transaction_count
    order_by: merchant asc, txn_month asc
  }

  // fee-match-relevant attributes at transaction grain
  view: matching_attributes is {
    select:
      psp_reference, merchant, txn_date, txn_month, day_of_year,
      card_scheme, aci, is_credit, eur_amount,
      issuing_country, acquirer_country, is_intracountry, intracountry_num,
      merchant_account_type, merchant_mcc, merchant_capture_delay_bucket,
      monthly_volume_eur, monthly_fraud_pct,
      has_fraudulent_dispute
    order_by: psp_reference asc
    limit: 10000
  }
}
