// c2_merchant_monthly_context.malloy
// Per-merchant per-month aggregates that derive the fee-rule bucket strings:
//   monthly_volume:       '<100k' | '100k-1m' | '1m-5m' | '>5m'
//   monthly_fraud_level:  '<7.2%' | '7.2%-7.7%' | '7.7%-8.3%' | '>8.3%'
//
// The month is computed arithmetically from day_of_year using the 2023
// (non-leap) month-boundary table — this deliberately AVOIDS any date
// function (date_add / make_date+interval are brittle in DuckDB-via-Malloy
// and broke earlier attempts).  year is constant 2023 per the profile.
//
// Downstream sources can join_one this source on the composite key
// merchant_month_key = concat(merchant, '|', month_num) to pick up the
// rule-shaped bucket strings without re-stating the bucketing logic.

source: merchant_monthly_context is payments_enriched -> {
  group_by:
    merchant
    txn_month_num is
      pick 1  when day_of_year <= 31
      pick 2  when day_of_year <= 59
      pick 3  when day_of_year <= 90
      pick 4  when day_of_year <= 120
      pick 5  when day_of_year <= 151
      pick 6  when day_of_year <= 181
      pick 7  when day_of_year <= 212
      pick 8  when day_of_year <= 243
      pick 9  when day_of_year <= 273
      pick 10 when day_of_year <= 304
      pick 11 when day_of_year <= 334
      else 12
  aggregate:
    monthly_volume_eur  is eur_amount.sum()
    monthly_fraud_eur   is eur_amount.sum() { where: has_fraudulent_dispute }
    monthly_txn_count   is count()
    monthly_fraud_count is count() { where: has_fraudulent_dispute }
} extend {

  // ── Keys ───────────────────────────────────────────────────────────
  // Composite (merchant, month) key materialized as a single string so
  // downstream sources can `join_one ... with merchant_month_key`.
  dimension: merchant_month_key is concat(merchant, '|', txn_month_num::string)
  primary_key: merchant_month_key

  // Human-readable month label, e.g. '2023-07'.
  dimension: txn_month_str is
    concat('2023-', lpad!string(txn_month_num::string, 2, '0'))

  // ── Derived ratios ─────────────────────────────────────────────────
  dimension: monthly_fraud_ratio is
    monthly_fraud_eur / nullif!number(monthly_volume_eur, 0)

  // ── Fee-rule bucket strings (EXACT domain from fees profile) ───────
  // fees.monthly_volume       ∈ {'<100k','100k-1m','1m-5m','>5m'} + NULL=all
  dimension: monthly_volume_bucket is
    pick '<100k'   when monthly_volume_eur < 100000
    pick '100k-1m' when monthly_volume_eur < 1000000
    pick '1m-5m'   when monthly_volume_eur < 5000000
    else '>5m'

  // fees.monthly_fraud_level  ∈ {'<7.2%','7.2%-7.7%','7.7%-8.3%','>8.3%'} + NULL=all
  dimension: monthly_fraud_bucket is
    pick '<7.2%'     when monthly_fraud_ratio < 0.072
    pick '7.2%-7.7%' when monthly_fraud_ratio < 0.077
    pick '7.7%-8.3%' when monthly_fraud_ratio < 0.083
    else '>8.3%'

  // ── Measures over the monthly grain ────────────────────────────────
  measure: month_row_count       is count()
  measure: total_volume_eur      is monthly_volume_eur.sum()
  measure: total_fraud_eur       is monthly_fraud_eur.sum()
  measure: avg_monthly_volume    is monthly_volume_eur.avg()
  measure: avg_monthly_fraud_pct is monthly_fraud_ratio.avg()

  // ── Reusable views ─────────────────────────────────────────────────
  view: listing is {
    select:
      merchant
      txn_month_num
      txn_month_str
      monthly_txn_count
      monthly_fraud_count
      monthly_volume_eur
      monthly_fraud_eur
      monthly_fraud_ratio
      monthly_volume_bucket
      monthly_fraud_bucket
    order_by: merchant, txn_month_num
  }

  view: by_volume_bucket is {
    group_by:  monthly_volume_bucket
    aggregate: month_row_count, avg_monthly_volume
    order_by:  avg_monthly_volume
  }

  view: by_fraud_bucket is {
    group_by:  monthly_fraud_bucket
    aggregate: month_row_count, avg_monthly_fraud_pct
    order_by:  avg_monthly_fraud_pct
  }

  view: merchant_year_summary is {
    group_by:  merchant
    aggregate:
      month_row_count
      total_volume_eur
      total_fraud_eur
      avg_monthly_volume
      avg_monthly_fraud_pct
    order_by: total_volume_eur desc
  }
}
