// Thin reusable entry points over the c1–c5 semantic sources.
// All matching/fee logic lives in the intermediate sources; these only
// name the canonical call shapes so a question is a filter+select on top.
// NOTE: c4_*/c5_* are parameterized sources — supply context/overrides at the
// run site, e.g. `run: c4_fee_rules(transaction_value is 50) -> avg_fee_by_scheme`.

// ---- Average-scenario fee by card scheme (default notional 0; override param) ----
// cheapest scheme: order_by avg_fee asc + limit 1 ; most expensive: avg_fee desc.
query: avg_scenario_fee_by_scheme is c4_fee_rules -> avg_fee_by_scheme

// applicable fee-rule IDs for a supplied scalar characteristic context
// (e.g. account_type + aci) — caller sets the for_* params on the source.
query: fee_rules_for_context is c4_fee_rules -> matching_rule_ids

// per-rule fee detail for a supplied context
query: fee_rule_detail_for_context is c4_fee_rules -> matching_rule_fees

// ---- Cheapest / most expensive ACI in the average scenario (A..G universe) ----
query: avg_scenario_fee_by_aci is c4_fee_by_aci -> ranked

// ---- Cheapest / most expensive MCC in the average scenario ----
query: avg_scenario_fee_by_mcc is c4_fee_by_mcc -> ranked
// average fee per scheme within an MCC (caller filters mcc_value + scheme)
query: avg_scenario_fee_by_mcc_scheme is c4_fee_by_mcc -> avg_fee_by_scheme

// ---- Per-merchant realized fees over a time window (scope merchant + day/month) ----
// applicable fee IDs actually hit by a merchant's transactions in the window.
query: merchant_applicable_fee_ids is c5_transaction_fees -> applicable_fee_ids
// total fees per merchant over the scoped window.
query: merchant_total_fees is c5_transaction_fees -> fees_by_merchant
// one row per transaction with its computed fee.
query: merchant_transaction_fees is c5_transaction_fees -> per_transaction_fee
// merchants whose transactions match a given rule (scope: where fees.ID = X).
query: rule_affected_merchants is c5_transaction_fees -> affected_merchants

// ---- Traffic-steering: total fee per candidate card scheme (scope merchant + time) ----
// min fee: order total_fee asc + limit 1 ; max fee: total_fee desc + limit 1.
query: steering_fee_by_scheme is c5_steering -> fee_by_scheme

// ---- Fraud ACI re-routing: total fee per candidate ACI ----
// scope: merchant + time + has_fraudulent_dispute ; preferred ACI = total_fee asc, aci asc.
query: fraud_aci_rerouting is c5_aci_rerouting -> fee_by_candidate_aci

// ---- Generic transaction slices (pre-fee) for value/volume analytics ----
// average transaction value by issuing country (scope merchant/scheme/time, order asc).
query: avg_value_by_issuing_country is payments_base -> by_issuing_country
query: payments_by_card_scheme is payments_base -> by_card_scheme
query: payments_by_month is payments_base -> by_month
