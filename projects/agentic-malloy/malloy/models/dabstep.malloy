##! experimental.parameters

// thin top layer: named query surfaces over the intermediate sources.
// parameterized shapes (notional fees, rate-change delta, MCC change,
// rule-scope change) are called directly on their sources — see _meta.

// resolved fees at daily grain; refine with merchant / day_of_year / month_num
query: fees_by_merchant_day is transaction_fees -> {
  group_by: merchant, day_of_year
  aggregate: matched_transaction_count, total_fee_amount, avg_fee_amount
  order_by: merchant asc, day_of_year asc
}

query: fees_by_merchant is transaction_fees -> total_fees_by_merchant

query: fees_by_merchant_month is transaction_fees -> total_fees_by_merchant_month

// merchant × applicable rule IDs over its actual traffic; refine with period filters
query: applicable_fee_ids_by_merchant is transaction_fees -> {
  where: rule.ID != null
  group_by: merchant
  nest: fee_ids is {
    group_by: matched_fee_id
    order_by: matched_fee_id asc
    limit: 1000
  }
  order_by: merchant asc
}

// merchants matched by each rule; refine with `where: matched_fee_id = N`
query: merchants_matched_by_fee is transaction_fees -> merchants_for_fee

// counterfactual scheme routing; ascending = cheapest scheme first
query: scheme_steering_ranking is scheme_steering -> scheme_steering_by_merchant

query: scheme_steering_ranking_by_month is
  scheme_steering -> scheme_steering_by_merchant_month

// counterfactual ACI for fraud-flagged traffic; ascending = preferred ACI first
query: fraud_aci_preference is fraud_aci_steering -> aci_steering_by_merchant

query: fraud_aci_preference_by_scheme is fraud_aci_steering -> aci_steering_by_scheme

// conservation guard: unmatched_transaction_count must be 0
query: fee_match_conservation is transaction_fees -> match_coverage

// descriptive slices; refine with merchant / scheme / period
query: avg_amount_by_issuing_country is
  payments_enriched -> avg_amount_by_issuing_country

// rule-matching inputs (merchant-side predicates + monthly buckets) per merchant-month
query: merchant_predicate_profile is payments_enriched -> predicate_profile
