##! experimental.parameters

// candidate scheme universe derived from observed data, never hardcoded
source: card_scheme_universe is payments_base -> { group_by: card_scheme } extend {
  primary_key: card_scheme
}

// transaction × candidate-scheme grid: cross join materialized into a REAL
// local column so the fact×rule join_many stays one join level deep
source: scheme_scenario_grid is payments_enriched extend {
  join_cross: scheme_sweep_src is card_scheme_universe
} -> {
  select: *, candidate_scheme is scheme_sweep_src.card_scheme
} extend {
  dimension: scheme_scenario_key is concat(psp_reference::string, '|', candidate_scheme)
  primary_key: scheme_scenario_key
}

// scheme-steering counterfactual: rematch rules with scheme swept to each
// candidate; every rule field keeps its wildcard branch (NULL / empty list)
source: fee_scheme_steering is scheme_scenario_grid extend {
  join_many: rules is fees_base(notional is null) on
    rules.card_scheme = candidate_scheme
    and (len!number(rules.account_type) = 0
      or list_contains!boolean(rules.account_type, merchant_account_type))
    and (rules.capture_delay is null or rules.capture_delay = capture_delay_bucket)
    and (rules.monthly_fraud_level is null or rules.monthly_fraud_level = fraud_tier)
    and (rules.monthly_volume is null or rules.monthly_volume = volume_tier)
    and (len!number(rules.merchant_category_code) = 0
      or list_contains!boolean(rules.merchant_category_code, merchant_mcc))
    and (rules.is_credit is null or rules.is_credit = is_credit)
    and (len!number(rules.aci) = 0 or list_contains!boolean(rules.aci, aci))
    // rules.intracountry is DOUBLE {0,1,NULL}; intracountry_num is local 0/1
    and (rules.intracountry is null or rules.intracountry = intracountry_num)

  // distinct-key count: safe under both the cross-join and rule fan-outs
  measure: txn_count is count(psp_reference)
  measure: steering_fee_id_count is count(rules.ID)
  // match-grain: computed at rules locality, fan-out intended
  measure: steering_total_fees_eur is
    rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: steering_avg_fee_per_txn is steering_total_fees_eur / txn_count

  // one row per candidate scheme; scope traffic via where refinement
  view: scheme_sweep is {
    group_by: candidate_scheme
    aggregate: txn_count, steering_total_fees_eur, steering_avg_fee_per_txn, steering_fee_id_count
    order_by: steering_total_fees_eur asc, candidate_scheme asc
  }

  view: scheme_sweep_by_merchant is {
    group_by: merchant, candidate_scheme
    aggregate: txn_count, steering_total_fees_eur, steering_avg_fee_per_txn
    order_by: merchant asc, steering_total_fees_eur asc
  }

  view: scheme_sweep_by_month is {
    group_by: month_of_year, candidate_scheme
    aggregate: txn_count, steering_total_fees_eur, steering_avg_fee_per_txn
    order_by: month_of_year asc, steering_total_fees_eur asc
  }

  // candidate = actual collapses the sweep back to true transaction grain
  view: actual_scheme_baseline is {
    where: candidate_scheme = card_scheme
    group_by: card_scheme
    aggregate: txn_count, steering_total_fees_eur, steering_avg_fee_per_txn
    order_by: steering_total_fees_eur asc, card_scheme asc
  }
}
