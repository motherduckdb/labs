// Thin answering surface over the c1–c5 intermediate sources.
// Each entry is a ready-to-run named query; scope it last-mile with
//   run: <name> + { where: … ; order_by: … ; limit: … }
// Parameterized scenarios (average-fee, rate-delta, MCC/scheme/ACI counterfactuals)
// are instantiated directly on their c3/c4/c5 source with args — see _meta usage.

// --- resolved per-transaction fees (actual routing, no overrides) ---

// total fees a merchant accumulates; refine with merchant + day_of_year/transaction_month window
query: total_fees_by_merchant is c4_transaction_fees -> total_fees_by_merchant

// per-(transaction,rule) fee rows — basis for any custom delta / audit
query: transaction_fee_detail is c4_transaction_fees -> transaction_fee_detail

// distinct applicable fee IDs; refine with merchant + period (add overrides on the source for counterfactuals)
query: applicable_fee_ids is c4_transaction_fees -> applicable_fee_ids

// reverse lookup: merchants a fee rule applies to; refine with fee_id (+ period)
query: merchants_by_fee is c4_transaction_fees -> merchants_by_fee

// actual per-scheme fee breakdown (descriptive)
query: fee_by_card_scheme is c4_transaction_fees -> fee_by_card_scheme

// --- counterfactual routing scenarios (no params needed to run) ---

// steering: total/avg fee per candidate card scheme; refine merchant+period, order asc(min)/desc(max), limit 1
query: steer_by_scheme is c5_scheme_steering -> steer_by_scheme

// fraud ACI reallocation: fee per candidate ACI for a merchant's fraudulent txns; order asc + limit 1 (cheapest)
query: fraud_reallocate_by_aci is c5_aci_reallocation -> reallocate_by_aci

// --- descriptive transaction analytics ---

// average transaction value by issuing country; refine merchant/scheme/period, already sorted asc
query: avg_value_by_issuing_country is c1_transactions -> avg_value_by_issuing_country
