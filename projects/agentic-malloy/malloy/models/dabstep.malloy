##! experimental.parameters

// Rulebook surface: fee_rules with a NON-NULL default notional (100 EUR) so every
// fee_at_notional ranking/summary computes out of the box; callers override
// notional (and any match_* filter) per call. All fee_rules views are inherited.
source: fee_rulebook(
  notional::number is 100,
  match_card_scheme::string is null,
  match_account_type::string is null,
  match_mcc::number is null,
  match_capture_delay::string is null,
  match_volume_bucket::string is null,
  match_fraud_bucket::string is null,
  match_is_credit::boolean is null,
  match_aci::string is null,
  match_intracountry::boolean is null
) is fee_rules(
  notional is notional,
  match_card_scheme is match_card_scheme,
  match_account_type is match_account_type,
  match_mcc is match_mcc,
  match_capture_delay is match_capture_delay,
  match_volume_bucket is match_volume_bucket,
  match_fraud_bucket is match_fraud_bucket,
  match_is_credit is match_is_credit,
  match_aci is match_aci,
  match_intracountry is match_intracountry
) extend {
  // per-rule price list at the notional; constrained_field_count separates
  // specific rules (>0) from pure wildcard rules (0) for entity rankings
  view: rules_by_fee_at_notional is {
    where: matches_scenario
    select:
      ID, card_scheme, fixed_amount, rate, fee_at_notional, constrained_field_count
    order_by: fee_at_notional desc
    limit: 1000
  }
}

// Actual-traffic fee surface: transaction_fees pass-through (rule match + fee
// formula live there); adds a calendar-day grain for day-of-year questions.
source: merchant_fees(
  new_rate::number is null,
  new_fixed_amount::number is null
) is transaction_fees(
  new_rate is new_rate,
  new_fixed_amount is new_fixed_amount
) extend {
  view: fees_by_merchant_day is {
    group_by: merchant, txn_date
    aggregate: matched_txn_count, total_fee_amount, avg_fee_amount
    order_by: merchant asc, txn_date asc
  }
}
