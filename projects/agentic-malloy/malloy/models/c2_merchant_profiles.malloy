// Per-merchant × natural-month profile: monthly volume + fraud rate bucketed
// into the EXACT fee-rule band strings, plus the merchant attributes
// (account_type / MCC / capture_delay band) that drive rule applicability.
// Built as a query (aggregate to merchant-month grain) then extended with the
// bucketing dimensions — bands depend on the aggregated totals, so they must
// live in a downstream stage, not on the transaction grain.
source: c2_merchant_profiles is c1_transactions -> {
  group_by:
    merchant,
    transaction_month,
    account_type,
    account_type_label,
    merchant_category_code,
    mcc_description,
    merchant_capture_delay,
    capture_delay_band
  aggregate:
    total_amount,
    fraudulent_amount,
    transaction_count
} extend {

  // monthly fraud rate as a percentage (fee bands are stated in %)
  dimension: fraud_rate is fraudulent_amount / nullif!number(total_amount, 0)
  dimension: fraud_rate_pct is 100 * fraudulent_amount / nullif!number(total_amount, 0)

  // monthly volume bucketed to fees.monthly_volume domain: '<100k','100k-1m','1m-5m','>5m'
  dimension: volume_band is
    pick '<100k'   when total_amount < 100000
    pick '100k-1m' when total_amount >= 100000 and total_amount < 1000000
    pick '1m-5m'   when total_amount >= 1000000 and total_amount < 5000000
    pick '>5m'     when total_amount >= 5000000
    else null

  // monthly fraud rate bucketed to fees.monthly_fraud_level domain:
  // '<7.2%','7.2%-7.7%','7.7%-8.3%','>8.3%'
  dimension: fraud_band is
    pick '<7.2%'     when fraud_rate_pct < 7.2
    pick '7.2%-7.7%' when fraud_rate_pct >= 7.2 and fraud_rate_pct < 7.7
    pick '7.7%-8.3%' when fraud_rate_pct >= 7.7 and fraud_rate_pct < 8.3
    pick '>8.3%'     when fraud_rate_pct >= 8.3
    else null

  measure: profile_rows is count()
  measure: months_covered is count(transaction_month)

  // full merchant-month profile row (thin filter to a merchant/month on top)
  view: monthly_profile is {
    select:
      merchant,
      transaction_month,
      account_type,
      account_type_label,
      merchant_category_code,
      mcc_description,
      merchant_capture_delay,
      capture_delay_band,
      total_amount,
      fraudulent_amount,
      transaction_count,
      fraud_rate,
      fraud_rate_pct,
      volume_band,
      fraud_band
    order_by: merchant, transaction_month
  }

  // distribution of merchant-months across volume bands
  view: by_volume_band is {
    group_by: volume_band
    aggregate: profile_rows, months_covered
  }

  // distribution of merchant-months across fraud bands
  view: by_fraud_band is {
    group_by: fraud_band
    aggregate: profile_rows, months_covered
  }

  // per-merchant band trajectory over the year
  view: by_merchant is {
    group_by: merchant, account_type, merchant_category_code, capture_delay_band
    aggregate: months_covered, total_volume is total_amount.sum()
    nest: monthly_profile
  }
}
