// acquirer_countries_base.malloy
// Reference mapping of acquirer (bank) names to the country in which they acquire.
// Used to resolve the acquirer_country attribute of a payment via its acquirer,
// and to support intracountry (domestic vs cross-border) reasoning.

source: acquirer_countries_base is duckdb.table('acquirer_countries') extend {

  //
  // -- Dimensions --------------------------------------------------------
  //

  // Acquirer (bank) name. Primary lookup key for joining from payments.acquirer.
  // 8 distinct acquirers in the data.
  // (column `acquirer` is exposed as-is)

  // ISO-2 country code where the acquirer operates (FR, GB, IT, NL, US).
  // (column `country_code` is exposed as-is)

  // Friendly label combining acquirer and its country.
  dimension: acquirer_label is concat(acquirer, ' (', country_code, ')')

  // Region grouping for the small set of observed country codes.
  dimension: acquirer_region is
    pick 'Europe'        when country_code ? 'FR' | 'GB' | 'IT' | 'NL'
    pick 'North America' when country_code = 'US'
    else 'Other'

  // Whether the acquirer is located in the Eurozone (rough heuristic over
  // the observed domain — FR, IT, NL are euro; GB, US are not).
  dimension: is_eurozone_acquirer is country_code ? 'FR' | 'IT' | 'NL'

  //
  // -- Measures ----------------------------------------------------------
  //

  // Number of acquirer rows (each row is one acquirer × country mapping).
  measure: acquirer_row_count is count()

  // Distinct acquirer banks present.
  measure: distinct_acquirer_count is count(acquirer)

  // Distinct countries in which any acquirer operates.
  measure: distinct_country_count is count(country_code)

  //
  // -- Views -------------------------------------------------------------
  //

  // Roster of acquirers with their country, ordered alphabetically.
  view: acquirer_directory is {
    select:   acquirer, country_code, acquirer_region
    order_by: acquirer asc
  }

  // How many acquirers operate in each country.
  view: acquirers_by_country is {
    group_by:  country_code
    aggregate: acquirer_row_count
    order_by:  acquirer_row_count desc
  }

  // How many acquirers operate in each derived region.
  view: acquirers_by_region is {
    group_by:  acquirer_region
    aggregate: acquirer_row_count
    order_by:  acquirer_row_count desc
  }
}
