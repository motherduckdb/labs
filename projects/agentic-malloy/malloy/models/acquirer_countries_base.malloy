source: acquirer_countries_base is duckdb.table('acquirer_countries') extend {
  measure: acquirer_count is count(acquirer)
  measure: country_count is count(country_code)
  measure: row_count is count()

  view: by_country is {
    group_by: country_code
    aggregate: acquirer_count
  }

  view: by_acquirer is {
    group_by: acquirer
    aggregate: country_count
  }
}
