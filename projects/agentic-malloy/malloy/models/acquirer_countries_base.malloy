// acquirer_countries_base.malloy
// Base source for the acquirer_countries lookup table.
// Maps each acquirer to its country of operation (ISO-2 country code).
// Used to determine intracountry vs international transactions
// (intracountry = issuer country == acquirer country).

source: acquirer_countries_base is duckdb.table('acquirer_countries') extend {

  // ---------- Dimensions ----------

  // Country grouping by region (per observed domain: FR, GB, IT, NL, US)
  dimension: region is
    pick 'North America' when country_code = 'US'
    pick 'Europe'        when country_code ? 'FR' | 'GB' | 'IT' | 'NL'
    else 'Other'

  // Friendly country name for the 5 observed ISO codes
  dimension: country_name is
    pick 'France'         when country_code = 'FR'
    pick 'United Kingdom' when country_code = 'GB'
    pick 'Italy'          when country_code = 'IT'
    pick 'Netherlands'    when country_code = 'NL'
    pick 'United States'  when country_code = 'US'
    else country_code

  // Is this a Eurozone acquirer? (FR, IT, NL among observed values)
  dimension: is_eurozone is country_code ? 'FR' | 'IT' | 'NL'

  // ---------- Measures ----------

  measure: row_count is count()
  measure: acquirer_count is count(acquirer)
  measure: country_count is count(country_code)
}
