source: acquirer_countries_base is duckdb.table('acquirer_countries') extend {
  primary_key: acquirer

  measure: acquirer_count is count()
  measure: country_count is count(country_code)

  view: by_country is {
    group_by: country_code
    aggregate: acquirer_count
    order_by: acquirer_count desc
  }

  view: acquirer_lookup is {
    select: acquirer, country_code
    order_by: acquirer
  }
}
