##! experimental.parameters

// fact×rule fan-out. join_many on-clause references ONLY local columns of
// payments_enriched (attrs already materialized by projection) + rules' own
// columns + params. Every rule field has its wildcard branch:
// NULL scalar / empty list = applies to all.
source: fee_matching(
  card_scheme_override::string is null,   // what-if: reroute ALL scoped traffic to this scheme
  aci_override::string is null,           // what-if: reprocess scoped traffic under this ACI
  merchant_mcc_override::number is null,  // what-if: merchant had a different MCC
  rule_account_type_scope::string is null, // what-if: rules restricted to ONE account type (replaces list/wildcard match)
  new_rate::number is null                // what-if: rule rate changed (feeds delta measure)
) is payments_enriched extend {

  join_many: rules is fees_base(notional is null) on
    rules.card_scheme = coalesce(card_scheme_override, card_scheme)
    and (
      (rule_account_type_scope is null
        and (len!number(rules.account_type) = 0
          or list_contains!boolean(rules.account_type, merchant_account_type)))
      or merchant_account_type = rule_account_type_scope
    )
    and (rules.capture_delay is null or rules.capture_delay = capture_delay_bucket)
    and (rules.monthly_fraud_level is null or rules.monthly_fraud_level = fraud_tier)
    and (rules.monthly_volume is null or rules.monthly_volume = volume_tier)
    and (len!number(rules.merchant_category_code) = 0
      or list_contains!boolean(rules.merchant_category_code,
          coalesce(merchant_mcc_override, merchant_mcc)))
    and (rules.is_credit is null or rules.is_credit = is_credit)
    and (len!number(rules.aci) = 0
      or list_contains!boolean(rules.aci, coalesce(aci_override, aci)))
    // rules.intracountry is DOUBLE {0,1,NULL}; intracountry_num is the 0/1 cast
    and (rules.intracountry is null or rules.intracountry = intracountry_num)

  // match-grain alias over the join — never reuse in a further join on-clause
  dimension: fee_amount is rules.fixed_amount + rules.rate * eur_amount / 10000

  // base-grain-safe: distinct keys dedupe the fan-out
  measure: matched_transaction_count is count(psp_reference)
  measure: applicable_fee_id_count is count(rules.ID)

  // match-grain: computed at rules locality — fan-out (one row per txn×rule) is intended
  measure: matched_pair_count is rules.count()
  measure: total_fees_eur is rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: fixed_fees_eur is rules.sum(rules.fixed_amount)
  measure: variable_fees_eur is rules.sum(rules.rate * eur_amount / 10000)
  measure: avg_fee_per_match is rules.avg(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: matched_amount_eur is rules.sum(eur_amount) // Σ eur_amount over matched pairs (rate-delta basis)
  measure: avg_fee_per_transaction is total_fees_eur / matched_transaction_count
  // Σ (new_rate − rate) · amount / 10000 over matched pairs; null unless new_rate param set
  measure: total_fee_delta_at_new_rate is rules.sum((new_rate - rules.rate) * eur_amount / 10000)

  view: total_fees is {
    aggregate:
      total_fees_eur, matched_transaction_count, matched_pair_count,
      applicable_fee_id_count, avg_fee_per_transaction
  }

  view: fees_per_transaction is {
    group_by: psp_reference, merchant, transaction_date, card_scheme, aci, eur_amount
    aggregate: applicable_fee_id_count, total_fees_eur
    order_by: psp_reference asc
  }

  view: applicable_fee_ids is {
    group_by: fee_id is rules.ID
    aggregate: matched_transaction_count
    order_by: fee_id asc
  }

  view: applicable_fee_ids_by_merchant is {
    group_by: merchant, fee_id is rules.ID
    aggregate: matched_transaction_count
    order_by: merchant asc, fee_id asc
  }

  view: merchants_affected is {
    group_by: merchant
    aggregate: matched_transaction_count, matched_pair_count, total_fees_eur
    order_by: merchant asc
  }

  view: total_fees_by_merchant is {
    group_by: merchant
    aggregate: total_fees_eur, matched_transaction_count, avg_fee_per_transaction
    order_by: total_fees_eur desc
  }

  view: fees_by_card_scheme is {
    group_by: card_scheme
    aggregate: total_fees_eur, matched_transaction_count, avg_fee_per_transaction
    order_by: total_fees_eur asc, card_scheme asc
  }

  view: fees_by_aci is {
    group_by: aci
    aggregate: total_fees_eur, matched_transaction_count, avg_fee_per_transaction
    order_by: total_fees_eur asc, aci asc
  }

  view: fees_by_month is {
    group_by: month_of_year
    aggregate: total_fees_eur, matched_transaction_count, applicable_fee_id_count
    order_by: month_of_year asc
  }

  view: rate_change_delta is {
    group_by: fee_id is rules.ID, current_rate is rules.rate
    aggregate: matched_amount_eur, total_fees_eur, total_fee_delta_at_new_rate
    order_by: fee_id asc
  }

  view: matched_pair_detail is {
    select:
      psp_reference, merchant, transaction_date, card_scheme, aci,
      is_credit, eur_amount,
      fee_id is rules.ID,
      rule_fixed_amount is rules.fixed_amount,
      rule_rate is rules.rate,
      fee_amount
    order_by: psp_reference asc, fee_id asc
  }
}
