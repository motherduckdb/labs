// c1_payments.malloy
// ONE focused source: payments enriched with the per-transaction merchant
// attributes (account_type, capture_delay, MCC, MCC description) and a
// verified intracountry flag. These are the fields every downstream fee
// rule needs to match against `fees.account_type`, `fees.capture_delay`,
// `fees.merchant_category_code`, and `fees.intracountry`.
//
// Joins only — no fee logic here. Fee matching lives in a separate source.

source: c1_payments is payments_base extend {

  //------------------------------------------------------------------
  // Joins
  //------------------------------------------------------------------

  // N payments : 1 merchant. Pulls in account_type, capture_delay,
  // acquirer list, and MCC for the merchant of each transaction.
  join_one: merchants is merchants_base
    on merchant = merchants.merchant

  // N payments : 1 MCC. The merchant's MCC -> the human-readable
  // category description (used for MCC-by-description questions and
  // for industry-group rollups).
  // mcc is stored as a 4-digit string in merchant_category_codes;
  // merchant_category_code is an integer on merchants, so cast.
  join_one: mcc is merchant_category_codes_base
    on merchants.merchant_category_code::string = mcc.mcc

  // Acquirer-country directory. payments already carries
  // `acquirer_country` directly, so this lookup exists for completeness
  // / validation rather than as a required path. country_code is not
  // unique in this table (many acquirers per country), so we match on
  // it as a many-to-one *reference* for the country code only.
  // We deliberately do NOT join on `acquirer` because payments does
  // not carry a single acquirer per transaction — the merchant's
  // `acquirer` field on merchants_base is a list.

  //------------------------------------------------------------------
  // Per-transaction merchant attributes (exposed at txn grain so fee
  // matching can read them without re-traversing the join).
  //------------------------------------------------------------------
  dimension: account_type             is merchants.account_type
  dimension: account_type_label       is merchants.account_type_label
  dimension: account_segment          is merchants.account_segment
  dimension: capture_delay            is merchants.capture_delay
  dimension: capture_delay_bucket     is merchants.capture_delay_bucket
  dimension: merchant_category_code   is merchants.merchant_category_code
  dimension: mcc_description          is mcc.description
  dimension: mcc_industry_group       is mcc.mcc_industry_group
  dimension: merchant_acquirers       is merchants.acquirer

  //------------------------------------------------------------------
  // Verified intracountry flag.
  //
  // payments_base already exposes `is_intracountry` as a boolean.
  // fees.intracountry is stored as 0/1 (with NULL = wildcard), so we
  // expose an integer form for direct equality against the fee rule.
  //------------------------------------------------------------------
  dimension: intracountry_int is
    pick 1 when is_intracountry
    else 0
}
