// Materialize every rule-matching attribute as a REAL local column (projection),
// so downstream fee-rule fan-out can join_many on local columns only.
source: payments_enriched is payments_base extend {
  join_one: md is merchant_dimensions on merchant = md.merchant
  // composite merchant|month key back to the pre-aggregated month stats
  join_one: mm is merchant_monthly_activity
    on concat(merchant, '|', txn_month::string) = mm.merchant_month_key
} -> {
  select:
    psp_reference
    merchant
    card_scheme
    `year`
    hour_of_day
    minute_of_hour
    day_of_year
    is_credit
    eur_amount
    ip_country
    issuing_country
    device_type
    shopper_interaction
    card_bin
    card_number
    email_address
    has_fraudulent_dispute
    is_refused_by_adyen
    aci
    acquirer_country
    txn_date
    txn_month
    txn_month_num
    is_intracountry
    intracountry_flag
    account_type is md.account_type
    merchant_category_code is md.merchant_category_code
    mcc_description is md.mcc_description
    capture_delay is md.capture_delay
    capture_delay_bucket is md.capture_delay_bucket
    monthly_volume_eur is mm.monthly_volume
    monthly_volume_bucket is mm.monthly_volume_bucket
    monthly_fraud_ratio is mm.monthly_fraud_ratio
    monthly_fraud_bucket is mm.monthly_fraud_bucket
} extend {
  primary_key: psp_reference

  measure: transaction_count is count()
  measure: merchant_count is count(merchant)
  measure: card_count is count(card_number)
  measure: shopper_count is count(email_address)

  measure: total_amount is eur_amount.sum()
  measure: avg_amount is eur_amount.avg()
  measure: min_amount is eur_amount.min()
  measure: max_amount is eur_amount.max()

  // fraud numerator is euro VOLUME per the manual, count kept for completeness
  measure: fraud_count is count() { where: has_fraudulent_dispute }
  measure: fraud_amount is eur_amount.sum() { where: has_fraudulent_dispute }
  measure: fraud_rate_by_volume is
    eur_amount.sum() { where: has_fraudulent_dispute } / eur_amount.sum()
  measure: fraud_rate_by_count is
    count() { where: has_fraudulent_dispute } / count()

  measure: credit_count is count() { where: is_credit }
  measure: credit_share is count() { where: is_credit } / count()
  measure: intracountry_count is count() { where: is_intracountry }
  measure: intracountry_share is count() { where: is_intracountry } / count()
  measure: refused_count is count() { where: is_refused_by_adyen }
  measure: refusal_rate is count() { where: is_refused_by_adyen } / count()

  // one row per transaction: the full input vector the fee-rule predicate consumes
  view: rule_matching_inputs is {
    select:
      psp_reference
      merchant
      txn_date
      `year`
      day_of_year
      eur_amount
      card_scheme
      aci
      is_credit
      intracountry_flag
      is_intracountry
      account_type
      merchant_category_code
      capture_delay_bucket
      monthly_volume_bucket
      monthly_fraud_bucket
      has_fraudulent_dispute
    order_by: psp_reference
  }

  view: avg_value_by_issuing_country is {
    group_by: issuing_country
    aggregate: transaction_count, total_amount, avg_amount
    order_by: avg_amount asc
  }

  view: avg_value_by_scheme is {
    group_by: card_scheme
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
    order_by: avg_amount asc
  }

  view: avg_value_by_aci is {
    group_by: aci
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume
    order_by: avg_amount asc
  }

  view: avg_value_by_merchant is {
    group_by: merchant
    aggregate: transaction_count, total_amount, avg_amount, fraud_rate_by_volume, refusal_rate
    order_by: merchant
  }

  view: merchant_scheme_mix is {
    group_by: merchant, card_scheme
    aggregate: transaction_count, total_amount, avg_amount, credit_share, intracountry_share
    order_by: merchant, card_scheme
  }

  // fraud slice at the same attribute grain steering scenarios re-match on
  view: fraudulent_transaction_profile is {
    where: has_fraudulent_dispute
    group_by:
      merchant
      card_scheme
      aci
      is_credit
      is_intracountry
    aggregate: transaction_count, total_amount, avg_amount
    order_by: merchant, card_scheme, aci
  }

  view: monthly_traffic is {
    group_by: merchant, txn_month, monthly_volume_bucket, monthly_fraud_bucket
    aggregate: transaction_count, total_amount, fraud_amount, fraud_rate_by_volume
    order_by: merchant, txn_month
  }
}
