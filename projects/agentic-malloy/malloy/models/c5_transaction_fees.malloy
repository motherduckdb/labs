##! experimental.parameters
// Transaction × fee-rule matching with multi-rule fan-out.
// Each enriched transaction (c3) is matched to every fee rule whose characteristic
// constraints all hold; wildcard encoding = empty list (len=0) for list fields,
// NULL for scalar fields. Fee per (transaction,rule) = fixed_amount + rate*eur_amount/10000,
// summed AT THE JOINED GRAIN so the base row isn't double-counted by the fan-out.

// fee rules with a key so symmetric aggregates dedupe across the join_many fan-out
source: fee_rules_keyed is fees_base extend { primary_key: ID }

// observed ACI universe (A..G) for the re-routing counterfactual
source: aci_universe is duckdb.sql("SELECT DISTINCT aci AS aci_value FROM payments")

// ============================================================================
// MAIN: applicable fee rules, per-transaction & total fees, single-rule
//       parameter-override delta, merchants-affected-by-rule.
//   override_fee_id + override_rate/override_fixed: counterfactual on ONE rule's
//     pricing (rule SET unchanged) -> fee_delta is exact within one query.
//   override_mcc: counterfactual merchant MCC (changes the matched rule SET) ->
//     caller diffs two instantiations (with vs without override_mcc).
// ============================================================================
source: c5_transaction_fees(
  override_fee_id::number is null,
  override_rate::number is null,
  override_fixed::number is null,
  override_mcc::number is null
) is c3_transactions_enriched extend {

  // every match field carries a wildcard branch (list -> len=0 ; scalar -> NULL)
  join_many: fees is fee_rules_keyed on
    (fees.card_scheme is null or fees.card_scheme = card_scheme)
    and (len!number(fees.account_type) = 0
         or list_contains!boolean(fees.account_type, account_type))
    and (len!number(fees.merchant_category_code) = 0
         or list_contains!boolean(fees.merchant_category_code,
              (pick override_mcc when override_mcc is not null
               else merchant_category_code::number)))   // counterfactual MCC
    and (len!number(fees.aci) = 0
         or list_contains!boolean(fees.aci, aci))
    and (fees.is_credit is null or fees.is_credit = is_credit)
    and (fees.capture_delay is null or fees.capture_delay = capture_delay_band)
    and (fees.monthly_volume is null or fees.monthly_volume = monthly_volume_band)
    and (fees.monthly_fraud_level is null or fees.monthly_fraud_level = monthly_fraud_band)
    and (fees.intracountry is null or fees.is_intracountry = is_intracountry)

  // ---- measures ----
  measure: applicable_rule_count is count(fees.ID)          // distinct matched rules

  // per-match fee computed AT the fees grain (expr over joined + base cols)
  measure: total_fee is fees.sum(fees.fixed_amount + fees.rate * eur_amount / 10000)
  measure: avg_fee   is fees.avg(fees.fixed_amount + fees.rate * eur_amount / 10000)
  measure: min_fee   is min(fees.fixed_amount + fees.rate * eur_amount / 10000)
  measure: max_fee   is max(fees.fixed_amount + fees.rate * eur_amount / 10000)

  // same total but applying a single-rule pricing override (rule set unchanged)
  measure: total_fee_scenario is fees.sum(
    (pick override_fixed when fees.ID = override_fee_id and override_fixed is not null
       else fees.fixed_amount)
    + (pick override_rate when fees.ID = override_fee_id and override_rate is not null
         else fees.rate) * eur_amount / 10000)
  measure: fee_delta is total_fee_scenario - total_fee

  // ---- views (thin: caller scopes by merchant + time then selects) ----

  // distinct applicable fee IDs for the scoped transactions
  view: applicable_fee_ids is {
    group_by: fee_id is fees.ID
    order_by: fee_id
  }

  // total fees per merchant over the scoped window
  view: fees_by_merchant is {
    group_by: merchant
    aggregate: transaction_count, total_fee
  }

  // one row per transaction with its fee (scope by merchant + day/month)
  view: per_transaction_fee is {
    group_by: psp_reference, merchant, day_of_year, card_scheme, eur_amount
    aggregate: fee is total_fee
    order_by: psp_reference
  }

  // merchants whose transactions match a rule (scope: where fees.ID = X [+ extra rule scope])
  view: affected_merchants is {
    group_by: merchant
    aggregate: transaction_count
    order_by: merchant
  }
}

// ============================================================================
// STEERING: counterfactual reallocation of a merchant's transactions to each
// candidate card scheme. card_scheme is dropped from the match; grouping by the
// rule's scheme yields the total fee as if all transactions used that scheme.
// (No NULL-scheme rules exist in the data, so grouping is clean.)
// ============================================================================
source: c5_steering is c3_transactions_enriched extend {

  join_many: fees is fee_rules_keyed on
    (len!number(fees.account_type) = 0
         or list_contains!boolean(fees.account_type, account_type))
    and (len!number(fees.merchant_category_code) = 0
         or list_contains!boolean(fees.merchant_category_code, merchant_category_code))
    and (len!number(fees.aci) = 0
         or list_contains!boolean(fees.aci, aci))
    and (fees.is_credit is null or fees.is_credit = is_credit)
    and (fees.capture_delay is null or fees.capture_delay = capture_delay_band)
    and (fees.monthly_volume is null or fees.monthly_volume = monthly_volume_band)
    and (fees.monthly_fraud_level is null or fees.monthly_fraud_level = monthly_fraud_band)
    and (fees.intracountry is null or fees.is_intracountry = is_intracountry)

  measure: total_fee is fees.sum(fees.fixed_amount + fees.rate * eur_amount / 10000)
  measure: avg_fee   is fees.avg(fees.fixed_amount + fees.rate * eur_amount / 10000)

  // total fee per candidate scheme (scope by merchant + time;
  // order total_fee asc -> steer-to-min, desc -> steer-to-max, limit 1)
  view: fee_by_scheme is {
    group_by: candidate_scheme is fees.card_scheme
    aggregate: transaction_count, total_fee, avg_fee
    order_by: total_fee asc
  }
}

// ============================================================================
// ACI RE-ROUTING: counterfactual reassignment of a transaction subset (usually
// fraudulent) to each candidate ACI. Candidate ACI is materialized as a real
// local column (cross join + projection) so the fee join_many references only
// local columns; the rule's ACI list is matched against the candidate.
// ============================================================================
source: c5_aci_rerouting is c3_transactions_enriched extend {
  join_cross: aci_candidate is aci_universe
} -> {
  select: *, candidate_aci is aci_candidate.aci_value   // materialize for downstream match
} extend {

  join_many: fees is fee_rules_keyed on
    (fees.card_scheme is null or fees.card_scheme = card_scheme)
    and (len!number(fees.account_type) = 0
         or list_contains!boolean(fees.account_type, account_type))
    and (len!number(fees.merchant_category_code) = 0
         or list_contains!boolean(fees.merchant_category_code, merchant_category_code))
    and (len!number(fees.aci) = 0
         or list_contains!boolean(fees.aci, candidate_aci))   // counterfactual ACI
    and (fees.is_credit is null or fees.is_credit = is_credit)
    and (fees.capture_delay is null or fees.capture_delay = capture_delay_band)
    and (fees.monthly_volume is null or fees.monthly_volume = monthly_volume_band)
    and (fees.monthly_fraud_level is null or fees.monthly_fraud_level = monthly_fraud_band)
    and (fees.intracountry is null or fees.is_intracountry = is_intracountry)

  measure: transaction_count is count(psp_reference)
  measure: total_fee is fees.sum(fees.fixed_amount + fees.rate * eur_amount / 10000)
  measure: avg_fee   is fees.avg(fees.fixed_amount + fees.rate * eur_amount / 10000)

  // fee per candidate ACI (scope by merchant + time + has_fraudulent_dispute;
  // order total_fee asc, candidate_aci asc, limit 1 -> preferred ACI)
  // DEDUP the rule fan-out: collapse to one applicable rule per (txn,candidate ACI)
  // FIRST, then aggregate per ACI -- raw fees.sum over the fan-out double-counts.
  view: fee_by_candidate_aci is {
    group_by: candidate_aci, psp_reference
    aggregate: txn_fee is min(fees.fixed_amount + fees.rate * eur_amount / 10000)
  } -> {
    group_by: candidate_aci
    aggregate:
      transaction_count is count()
      total_fee is txn_fee.sum()
      avg_fee is txn_fee.avg()
    order_by: total_fee asc, candidate_aci asc
  }
}
