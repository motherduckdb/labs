// c1_payments_enriched.malloy
// Payments joined with the merchant dimension and the MCC reference so that
// every transaction row carries the merchant attributes that fee rules match
// on: account_type, the fee-rule-shaped capture_delay bucket, the merchant's
// MCC (as an integer, to match fees.merchant_category_code's element type),
// and a friendly MCC description / industry group.
//
// Acquirer country and the intracountry flag already exist on payments_base
// (acquirer_country + is_intracountry), so they are simply inherited.
//
// NOTE on pass-through dimensions: the dimensions added below are aliases for
// columns reached through `m` / `mcc_ref`. They are SAFE to use anywhere
// EXCEPT inside a downstream `join_many ... on (...)` predicate — that fails
// at execution time. The downstream fee-matching source therefore re-projects
// these into real local columns before fanning out to the rules table.

source: payments_enriched is payments_base extend {

  // ── Joins ──────────────────────────────────────────────────────────
  // merchants.merchant is the PK of the merchants table.
  join_one: m is merchants_base on merchant = m.merchant

  // MCC reference: merchants.merchant_category_code is an INT, MCC table's
  // `mcc` is VARCHAR — use the derived mcc_int dimension on the MCC base.
  join_one: mcc_ref is merchant_category_codes_base
    on m.merchant_category_code = mcc_ref.mcc_int

  // ── Pass-through dimensions from the merchant dimension ────────────
  dimension: account_type        is m.account_type
  dimension: account_type_label  is m.account_type_label
  dimension: business_channel    is m.business_channel

  // Merchant MCC as INT — same type as the elements of fees.merchant_category_code,
  // so downstream `list_contains!boolean(rules.merchant_category_code, merchant_mcc)`
  // works without casting.
  dimension: merchant_mcc        is m.merchant_category_code
  dimension: merchant_mcc_str    is m.mcc_str

  // Raw merchant capture_delay ('1','2','7','immediate','manual') and the
  // version mapped onto the fee-rule vocabulary ('<3','>5','immediate','manual').
  dimension: capture_delay_raw   is m.capture_delay
  dimension: capture_delay_rule  is m.capture_delay_rule

  // ── Pass-through dimensions from the MCC reference ─────────────────
  dimension: mcc_description     is mcc_ref.description
  dimension: mcc_industry_group  is mcc_ref.mcc_industry_group

  // ── Convenience: acquirer-country region (payments.acquirer_country
  //    is already a real column on payments_base).
  dimension: acquirer_region is
    pick 'North America' when acquirer_country = 'US'
    pick 'Europe'        when acquirer_country ? 'FR' | 'GB' | 'IT' | 'NL'
    else 'Other'

  // ── Reusable views ─────────────────────────────────────────────────

  view: by_merchant is {
    group_by:  merchant, account_type_label, capture_delay_rule
    aggregate: transaction_count, total_eur, fraud_count, fraud_eur,
               authorization_rate, fraud_rate
    order_by:  total_eur desc
  }

  view: by_merchant_and_card_scheme is {
    group_by:  merchant, card_scheme
    aggregate: transaction_count, total_eur, fraud_count
    order_by:  merchant, total_eur desc
  }

  view: by_account_type is {
    group_by:  account_type, account_type_label
    aggregate: transaction_count, total_eur, fraud_rate
    order_by:  total_eur desc
  }

  view: by_mcc is {
    group_by:  merchant_mcc, mcc_description
    aggregate: transaction_count, total_eur
    order_by:  total_eur desc
  }
}
