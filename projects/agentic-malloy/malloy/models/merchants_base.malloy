source: merchants_base is duckdb.table('merchants') extend {

  // ---------- dimensions ----------
  dimension: account_type_label is pick 'Enterprise - Retail' when account_type = 'R'
    pick 'Enterprise - Digital' when account_type = 'D'
    pick 'Enterprise - Hospitality' when account_type = 'H'
    pick 'Platform - Franchise' when account_type = 'F'
    pick 'Platform - SaaS' when account_type = 'S'
    else 'Other'

  // merchant numeric capture days mapped onto fee-rule bands.
  // safe-cast ::: yields null for 'immediate'/'manual' so the numeric
  // branches stay false instead of erroring on a non-numeric string.
  dimension: capture_delay_band is
    pick 'immediate' when capture_delay = 'immediate'
    pick 'manual' when capture_delay = 'manual'
    pick '<3' when capture_delay:::number < 3
    pick '3-5' when capture_delay:::number >= 3 and capture_delay:::number <= 5
    pick '>5' when capture_delay:::number > 5
    else null

  dimension: capture_delay_days is capture_delay:::number  // null for immediate/manual

  dimension: acquirer_count is len!number(acquirer)

  // ---------- measures ----------
  measure: merchant_count is count()
  measure: account_type_count is count(account_type)
  measure: mcc_count is count(merchant_category_code)
  measure: avg_acquirer_count is acquirer_count.avg()
  measure: min_acquirer_count is acquirer_count.min()
  measure: max_acquirer_count is acquirer_count.max()

  // ---------- views ----------
  view: by_account_type is {
    group_by: account_type, account_type_label
    aggregate: merchant_count
  }

  view: by_capture_delay is {
    group_by: capture_delay, capture_delay_band
    aggregate: merchant_count
  }

  view: by_mcc is {
    group_by: merchant_category_code
    aggregate: merchant_count
  }
}
