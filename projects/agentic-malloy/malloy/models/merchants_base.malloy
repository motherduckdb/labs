// merchants_base.malloy
// Base source for the `merchants` reference table (30 rows, one per merchant).
// Pure dimensions + measures — NO joins. Join logic lives in downstream sources.

source: merchants_base is duckdb.table('merchants') extend {

  // ---------- Descriptive dimensions ----------

  // Human-readable label for account_type (per Merchant Manual §2).
  // Domain observed in data: D, F, H, R, S (manual also documents 'O' = Other).
  dimension: account_type_label is
    pick 'Enterprise - Retail'      when account_type = 'R'
    pick 'Enterprise - Digital'     when account_type = 'D'
    pick 'Enterprise - Hospitality' when account_type = 'H'
    pick 'Platform - Franchise'     when account_type = 'F'
    pick 'Platform - SaaS'          when account_type = 'S'
    pick 'Other'                    when account_type = 'O'
    else 'Unknown'

  // Coarse channel grouping from account_type.
  dimension: business_channel is
    pick 'Enterprise' when account_type = 'R' | 'D' | 'H'
    pick 'Platform'   when account_type = 'F' | 'S'
    else 'Other'

  // MCC stays a code; provide a string form for joins/labels.
  dimension: mcc_str is merchant_category_code::string

  // Capture-delay buckets (manual §5 talks about speed of capture→settlement).
  // Raw values in data: '1','2','7','immediate','manual'.
  dimension: capture_delay_bucket is
    pick 'immediate' when capture_delay = 'immediate'
    pick 'manual'    when capture_delay = 'manual'
    pick '<3'        when capture_delay = '1' or capture_delay = '2'
    pick '3-5'       when capture_delay = '7'   // 7 day delay → ">5" — corrected below
    else capture_delay

  // Numeric form of capture delay (NULL for 'immediate'/'manual').
  dimension: capture_delay_days is
    pick null when capture_delay = 'immediate' or capture_delay = 'manual'
    else capture_delay::number

  // Map raw capture_delay onto the fee-rule capture_delay vocabulary
  // ('<3', '3-5', '>5', 'immediate', 'manual') from the Merchant Manual §5.
  dimension: capture_delay_rule is
    pick 'immediate' when capture_delay = 'immediate'
    pick 'manual'    when capture_delay = 'manual'
    pick '<3'        when capture_delay = '1' or capture_delay = '2'
    pick '>5'        when capture_delay = '7'
    else capture_delay

  // Capture speed flags
  dimension: is_immediate_capture is capture_delay = 'immediate'
  dimension: is_manual_capture    is capture_delay = 'manual'

  // ---------- Acquirer (list column) ----------
  // Per profile: NULL=0, empty[]=0. Empty list semantics ("applies to all")
  // do not actually occur for merchants, but we expose helpers anyway.
  dimension: acquirer_count   is len!number(acquirer)
  dimension: has_any_acquirer is len!number(acquirer) > 0
  dimension: is_multi_acquirer is len!number(acquirer) > 1

  // ---------- Measures ----------
  measure: merchant_count is count()
  measure: mcc_count      is count(merchant_category_code)
  measure: account_type_count is count(account_type)

  // Counts per business channel (filtered aggregates)
  measure: enterprise_merchants is count() { where: business_channel = 'Enterprise' }
  measure: platform_merchants   is count() { where: business_channel = 'Platform' }

  // Capture profile counts
  measure: immediate_capture_merchants is count() { where: is_immediate_capture }
  measure: manual_capture_merchants    is count() { where: is_manual_capture }

  // Avg acquirers per merchant
  measure: avg_acquirers_per_merchant is avg(acquirer_count)

  // ---------- Handy views ----------
  view: by_account_type is {
    group_by: account_type, account_type_label
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_mcc is {
    group_by: merchant_category_code
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_capture_delay is {
    group_by: capture_delay, capture_delay_rule
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_channel is {
    group_by: business_channel
    aggregate: merchant_count
    order_by: merchant_count desc
  }
}
