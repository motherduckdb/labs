source: merchants_base is duckdb.table('merchants') extend {
  primary_key: merchant

  // maps concrete day settings to fee-rule capture_delay buckets ('<3','3-5','>5','immediate','manual')
  dimension: capture_delay_bucket is
    pick '<3' when capture_delay = '1' | '2'
    pick '3-5' when capture_delay = '3' | '4' | '5'
    pick '>5' when capture_delay = '7'
    else capture_delay

  dimension: account_type_description is
    pick 'Enterprise - Retail' when account_type = 'R'
    pick 'Enterprise - Digital' when account_type = 'D'
    pick 'Enterprise - Hospitality' when account_type = 'H'
    pick 'Platform - Franchise' when account_type = 'F'
    pick 'Platform - SaaS' when account_type = 'S'
    pick 'Other' when account_type = 'O'
    else 'Unknown'

  // mcc as string for joining a VARCHAR lookup table
  dimension: mcc_string is merchant_category_code::string

  // list columns: use len!number, never `is null`
  dimension: acquirer_count is len!number(acquirer)
  dimension: has_multiple_acquirers is len!number(acquirer) > 1

  measure: merchant_count is count()
  measure: account_type_count is count(account_type)
  measure: mcc_count is count(merchant_category_code)
  measure: capture_delay_setting_count is count(capture_delay)
  measure: avg_acquirer_count is acquirer_count.avg()
  measure: min_acquirer_count is acquirer_count.min()
  measure: max_acquirer_count is acquirer_count.max()

  view: by_account_type is {
    group_by: account_type, account_type_description
    aggregate: merchant_count, mcc_count
    order_by: merchant_count desc
  }

  view: by_mcc is {
    group_by: merchant_category_code
    aggregate: merchant_count, account_type_count
    order_by: merchant_count desc
  }

  view: by_capture_delay is {
    group_by: capture_delay, capture_delay_bucket
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: merchant_profile is {
    select:
      merchant,
      account_type,
      account_type_description,
      merchant_category_code,
      capture_delay,
      capture_delay_bucket,
      acquirer,
      acquirer_count
    order_by: merchant
  }
}
