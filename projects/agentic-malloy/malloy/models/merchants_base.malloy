source: merchants_base is duckdb.table('merchants') extend {
  primary_key: merchant

  // fee rules bucket capture delay as '<3'/'3-5'/'>5'/'immediate'/'manual';
  // merchants store concrete values ('1','2','7','immediate','manual') — map before matching
  dimension: capture_delay_bucket is
    pick 'immediate' when capture_delay = 'immediate'
    pick 'manual' when capture_delay = 'manual'
    pick '<3' when capture_delay::number < 3
    pick '3-5' when capture_delay::number <= 5
    else '>5'

  dimension: account_type_description is account_type ?
    pick 'Enterprise - Retail' when 'R'
    pick 'Enterprise - Digital' when 'D'
    pick 'Enterprise - Hospitality' when 'H'
    pick 'Platform - Franchise' when 'F'
    pick 'Platform - SaaS' when 'S'
    pick 'Other' when 'O'
    else 'Unknown'

  // acquirer is a LIST column; len!number for size, list_contains!boolean for membership
  dimension: acquirer_count is len!number(acquirer)
  dimension: has_multiple_acquirers is len!number(acquirer) > 1
  // stable string form for grouping/display of the acquirer list
  dimension: acquirer_list is array_to_string!string(acquirer, ', ')

  measure: merchant_count is count()
  measure: avg_acquirers_per_merchant is avg(len!number(acquirer))

  view: by_account_type is {
    group_by: account_type, account_type_description
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_mcc is {
    group_by: merchant_category_code
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_capture_delay is {
    group_by: capture_delay, capture_delay_bucket
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: merchant_detail is {
    select: merchant, account_type, merchant_category_code,
      capture_delay, capture_delay_bucket, acquirer_list
  }
}
