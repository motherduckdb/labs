// merchant_category_codes_base.malloy
// Lookup table mapping 4-digit Merchant Category Codes (MCC) to their
// human-readable industry/business descriptions. Per the Merchant Manual,
// MCCs are 4-digit codes assigned by card schemes to classify merchant
// business type and are referenced in fee rules (fees.merchant_category_code)
// as integers, so we expose both the raw string mcc and a numeric form.

source: merchant_category_codes_base is duckdb.table('merchant_category_codes') extend {

  // ---------- Dimensions ----------

  // mcc as integer (fees.json stores merchant_category_code as integers, e.g. [8062, 8011, 8021])
  dimension: mcc_num is mcc::number

  // First two digits = high-level MCC category per the manual
  dimension: mcc_category_prefix is substr!string(mcc, 1, 2)

  // Short, lower-cased description for easier matching
  dimension: description_lower is lower(description)

  // ---------- Measures ----------

  measure: mcc_count is count()
  measure: distinct_descriptions is count(description)
  measure: distinct_categories is count(mcc_category_prefix)
}
