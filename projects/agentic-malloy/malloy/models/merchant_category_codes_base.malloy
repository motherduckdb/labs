// merchant_category_codes_base.malloy
// Base source for the merchant_category_codes lookup table.
// One row per Merchant Category Code (MCC) with a human-readable description.
// No joins here — downstream sources join to this on `mcc`.

source: merchant_category_codes_base is duckdb.table('merchant_category_codes') extend {

  //
  // ---------- Derived dimensions (NEW names only) ----------
  //

  // The MCC as an integer, which is how the payments table stores it.
  // Useful for joining to payments.mcc (BIGINT) without a cast on every query.
  dimension: mcc_num is mcc::number

  // First two digits = high-level category, last two = subcategory.
  dimension: mcc_category_prefix is substr(mcc, 1, 2)
  dimension: mcc_subcategory_suffix is substr(mcc, 3, 2)

  // Coarse industry bucket inferred from the standard MCC numeric ranges.
  // (Approximate — these ranges follow the ISO 18245 conventions referenced
  // in the Merchant Manual section 3.)
  dimension: industry_group is
    pick 'Agricultural Services'   when mcc_num >= 1   & mcc_num <= 1499
    pick 'Contracted Services'     when mcc_num >= 1500 & mcc_num <= 2999
    pick 'Airlines'                when mcc_num >= 3000 & mcc_num <= 3299
    pick 'Car Rental'              when mcc_num >= 3300 & mcc_num <= 3499
    pick 'Lodging'                 when mcc_num >= 3500 & mcc_num <= 3999
    pick 'Transportation'          when mcc_num >= 4000 & mcc_num <= 4799
    pick 'Utilities / Telecom'     when mcc_num >= 4800 & mcc_num <= 4999
    pick 'Retail Outlets'          when mcc_num >= 5000 & mcc_num <= 5599
    pick 'Clothing Stores'         when mcc_num >= 5600 & mcc_num <= 5699
    pick 'Misc Stores'             when mcc_num >= 5700 & mcc_num <= 7299
    pick 'Business Services'       when mcc_num >= 7300 & mcc_num <= 7999
    pick 'Professional / Membership' when mcc_num >= 8000 & mcc_num <= 8999
    pick 'Government Services'     when mcc_num >= 9000 & mcc_num <= 9999
    else 'Unknown'

  // Quick boolean flags for common segments referenced in the manual.
  dimension: is_hospitality is mcc_num >= 3500 & mcc_num <= 3999
  dimension: is_airline     is mcc_num >= 3000 & mcc_num <= 3299
  dimension: is_fuel        is mcc_num = 5541 | 5542 | 5983
  dimension: is_healthcare  is mcc_num >= 8000 & mcc_num <= 8099
  dimension: is_education   is mcc_num >= 8200 & mcc_num <= 8299
  dimension: is_government  is mcc_num >= 9000 & mcc_num <= 9999

  // Short label for charts: "5812 — Eating Places, Restaurants"
  dimension: mcc_label is concat(mcc, ' — ', description)

  //
  // ---------- Measures ----------
  //

  measure: mcc_count is count()
  measure: distinct_mcc_count is count(mcc)
  measure: distinct_industry_count is count(industry_group)
}
