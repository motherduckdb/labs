// c1_merchants_enriched.malloy
//
// One row per merchant. Enriches merchants_base-equivalent attributes with:
//   • account-type description (per the Merchant Guide)
//   • capture_delay bucket aligned to the fees.capture_delay vocabulary
//     ('immediate' | '<3' | '3-5' | '>5' | 'manual')
//   • MCC description (joined from merchant_category_codes)
//   • acquirer-country set — the list of distinct country codes in which this
//     merchant's acquirers operate (resolved via acquirer_countries)
//
// The acquirer-country set is what downstream sources need to evaluate the
// intracountry flag for transactions: a payment is "domestic" when its
// issuing_country matches the acquirer_country of the acquirer that routed
// it. At the merchant grain we expose the SET of acquirer countries the
// merchant uses, so questions can reason about whether a merchant has any
// same-country acquiring footprint.

source: c1_merchants_enriched is duckdb.sql("""
  SELECT
    m.merchant,
    m.account_type,
    m.merchant_category_code,
    m.capture_delay,
    m.acquirer,
    (
      SELECT list(DISTINCT ac.country_code)
      FROM acquirer_countries ac
      WHERE list_contains(m.acquirer, ac.acquirer)
    ) AS acquirer_country_codes
  FROM merchants m
""") extend {

  primary_key: merchant

  //
  // ── MCC lookup (merchants.merchant_category_code → description) ──────
  // merchant_category_codes_base exposes mcc_code (mcc::number); merchants
  // store MCC as BIGINT, so we join on the numeric form.
  //
  join_one: mcc_info is merchant_category_codes_base
    on merchant_category_code = mcc_info.mcc_code

  //
  // ── Derived dimensions ───────────────────────────────────────────────
  //

  dimension: account_type_description is
    pick 'Enterprise - Retail'      when account_type = 'R'
    pick 'Enterprise - Digital'     when account_type = 'D'
    pick 'Enterprise - Hospitality' when account_type = 'H'
    pick 'Platform - Franchise'     when account_type = 'F'
    pick 'Platform - SaaS'          when account_type = 'S'
    pick 'Other'                    when account_type = 'O'
    else 'Unknown'

  // Map merchants.capture_delay (literal labels + numeric-day strings) into
  // the bucket vocabulary used by fees.capture_delay.
  dimension: capture_delay_bucket is
    pick 'immediate' when capture_delay = 'immediate'
    pick 'manual'    when capture_delay = 'manual'
    pick '<3'        when capture_delay = '1' or capture_delay = '2'
    pick '3-5'       when capture_delay = '3' or capture_delay = '4' or capture_delay = '5'
    pick '>5'        when capture_delay = '6' or capture_delay = '7'
                       or capture_delay = '8' or capture_delay = '9'
    else capture_delay

  dimension: capture_delay_days is
    pick null when capture_delay = 'immediate'
    pick null when capture_delay = 'manual'
    else capture_delay::number

  // MCC description, surfaced as a first-class column on the enriched source.
  dimension: mcc_description is mcc_info.description

  // First two digits of the MCC = broad category (per the manual).
  dimension: mcc_category_prefix is mcc_info.mcc_category_prefix

  // Acquirer footprint.
  dimension: acquirer_count is len!number(acquirer)
  dimension: is_multi_acquirer is len!number(acquirer) > 1

  // Acquirer-country set: distinct country codes across all of the
  // merchant's acquirers. Empty list ⇒ no resolved acquirer country
  // (shouldn't occur in the seed data).
  dimension: acquirer_country_count is len!number(acquirer_country_codes)
  dimension: is_multi_country_acquirer is len!number(acquirer_country_codes) > 1

  // True iff this merchant has at least one acquirer in the given country.
  // Useful for asking "could this merchant route domestically for an
  // issuer in country X?".
  dimension: has_acquirer_in_fr is list_contains!boolean(acquirer_country_codes, 'FR')
  dimension: has_acquirer_in_gb is list_contains!boolean(acquirer_country_codes, 'GB')
  dimension: has_acquirer_in_it is list_contains!boolean(acquirer_country_codes, 'IT')
  dimension: has_acquirer_in_nl is list_contains!boolean(acquirer_country_codes, 'NL')
  dimension: has_acquirer_in_us is list_contains!boolean(acquirer_country_codes, 'US')

  //
  // ── Measures (merchant-grain) ────────────────────────────────────────
  //

  measure: merchant_count is count()
  measure: distinct_account_type_count is count(account_type)
  measure: distinct_mcc_count is count(merchant_category_code)
  measure: avg_acquirer_count is acquirer_count.avg()
  measure: avg_acquirer_country_count is acquirer_country_count.avg()

  //
  // ── Reusable views ───────────────────────────────────────────────────
  //

  // Full enriched directory — the row you want when answering
  // "tell me about this merchant".
  view: directory is {
    select:
      merchant,
      account_type,
      account_type_description,
      merchant_category_code,
      mcc_description,
      capture_delay,
      capture_delay_bucket,
      capture_delay_days,
      acquirer,
      acquirer_count,
      acquirer_country_codes,
      acquirer_country_count
    order_by: merchant asc
  }

  view: by_account_type is {
    group_by: account_type, account_type_description
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_mcc is {
    group_by: merchant_category_code, mcc_description
    aggregate: merchant_count
    order_by: merchant_count desc
  }

  view: by_capture_delay_bucket is {
    group_by: capture_delay_bucket
    aggregate: merchant_count
    order_by: merchant_count desc
  }
}
