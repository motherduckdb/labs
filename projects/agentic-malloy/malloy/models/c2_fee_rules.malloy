##! experimental.parameters

// -- exploded rule rows: one row per (rule, listed ACI); empty-list wildcard rules emit no rows
//    (participating universe for ACI rankings excludes wildcard-only rules by design)
source: fee_rule_aci_rows is fees_base -> {
  select:
    ID,
    card_scheme,
    account_type,
    capture_delay,
    monthly_fraud_level,
    monthly_volume,
    merchant_category_code,
    is_credit,
    intracountry,
    fixed_amount,
    rate,
    aci_value is unnest!string(aci)   // unnest fans out the list; needs raw escape
}

// -- one row per (rule, listed MCC); empty-list wildcard rules emit no rows
source: fee_rule_mcc_rows is fees_base -> {
  select:
    ID,
    card_scheme,
    account_type,
    capture_delay,
    monthly_fraud_level,
    monthly_volume,
    is_credit,
    aci,
    intracountry,
    fixed_amount,
    rate,
    mcc_value is unnest!number(merchant_category_code)
}

// -- one row per (rule, listed account type); empty-list wildcard rules emit no rows
source: fee_rule_account_type_rows is fees_base -> {
  select:
    ID,
    card_scheme,
    capture_delay,
    monthly_fraud_level,
    monthly_volume,
    merchant_category_code,
    is_credit,
    aci,
    intracountry,
    fixed_amount,
    rate,
    account_type_value is unnest!string(account_type)
}

// -- central rule-space source: wildcard-aware applicability filters + notional fee formula
source: fee_rules(
  notional::number is 100,
  filter_card_scheme::string is null,
  filter_account_type::string is null,
  filter_mcc::number is null,
  filter_aci::string is null,
  filter_is_credit::boolean is null,
  filter_capture_delay::string is null,
  filter_fraud_level::string is null,
  filter_volume::string is null,
  filter_intracountry::boolean is null
) is fees_base extend {

  // fee = fixed + rate(bps) * value / 10000
  dimension: scenario_fee is fixed_amount + rate * notional / 10000.0

  // wildcard branch on EVERY field: empty list / NULL scalar = applies to all
  dimension: matches_filters is
    (filter_card_scheme is null or card_scheme = filter_card_scheme)
    and (filter_account_type is null
         or len!number(account_type) = 0
         or list_contains!boolean(account_type, filter_account_type))
    and (filter_mcc is null
         or len!number(merchant_category_code) = 0
         or list_contains!boolean(merchant_category_code, filter_mcc))
    and (filter_aci is null
         or len!number(aci) = 0
         or list_contains!boolean(aci, filter_aci))
    and (filter_is_credit is null or is_credit is null or is_credit = filter_is_credit)
    and (filter_capture_delay is null or capture_delay is null or capture_delay = filter_capture_delay)
    and (filter_fraud_level is null or monthly_fraud_level is null or monthly_fraud_level = filter_fraud_level)
    and (filter_volume is null or monthly_volume is null or monthly_volume = filter_volume)
    and (filter_intracountry is null or intracountry is null
         or (filter_intracountry and intracountry = 1)
         or (not filter_intracountry and intracountry = 0))

  // every measure is computed AFTER the param filter (filtered aggregate), never over all rows
  measure: matching_rule_count is count() { where: matches_filters }
  measure: avg_scenario_fee is scenario_fee.avg() { where: matches_filters }
  measure: min_scenario_fee is scenario_fee.min() { where: matches_filters }
  measure: max_scenario_fee is scenario_fee.max() { where: matches_filters }
  measure: total_scenario_fee is scenario_fee.sum() { where: matches_filters }
  measure: avg_fixed_amount_matching is fixed_amount.avg() { where: matches_filters }
  measure: avg_rate_matching is rate.avg() { where: matches_filters }

  view: matching_fee_ids is {
    where: matches_filters
    group_by: ID
    order_by: ID asc
    limit: 10000
  }

  view: matching_rule_detail is {
    where: matches_filters
    select:
      ID, card_scheme, account_type, capture_delay, monthly_fraud_level,
      monthly_volume, merchant_category_code, is_credit, aci, intracountry,
      fixed_amount, rate, scenario_fee
    order_by: ID asc
    limit: 10000
  }

  view: scheme_fee_ranking is {
    group_by: card_scheme
    aggregate: matching_rule_count, avg_scenario_fee, min_scenario_fee, max_scenario_fee
    order_by: avg_scenario_fee asc
  }

  view: capture_delay_fee_ranking is {
    where: matches_filters and capture_delay is not null   // rank only specific (non-wildcard) tiers
    group_by: capture_delay
    aggregate:
      rule_count_in_tier is count(),
      avg_fee_in_tier is scenario_fee.avg(),
      min_fee_in_tier is scenario_fee.min(),
      max_fee_in_tier is scenario_fee.max()
    order_by: avg_fee_in_tier asc
  }
}

// -- ACI-level rule space (exploded); all params wired into matches_filters
source: fee_rules_by_aci(
  notional::number is 100,
  filter_card_scheme::string is null,
  filter_account_type::string is null,
  filter_mcc::number is null,
  filter_is_credit::boolean is null,
  filter_intracountry::boolean is null
) is fee_rule_aci_rows extend {

  dimension: scenario_fee is fixed_amount + rate * notional / 10000.0

  dimension: matches_filters is
    (filter_card_scheme is null or card_scheme = filter_card_scheme)
    and (filter_account_type is null
         or len!number(account_type) = 0
         or list_contains!boolean(account_type, filter_account_type))
    and (filter_mcc is null
         or len!number(merchant_category_code) = 0
         or list_contains!boolean(merchant_category_code, filter_mcc))
    and (filter_is_credit is null or is_credit is null or is_credit = filter_is_credit)
    and (filter_intracountry is null or intracountry is null
         or (filter_intracountry and intracountry = 1)
         or (not filter_intracountry and intracountry = 0))

  measure: matching_rule_count is count() { where: matches_filters }
  measure: avg_scenario_fee is scenario_fee.avg() { where: matches_filters }
  measure: min_scenario_fee is scenario_fee.min() { where: matches_filters }
  measure: max_scenario_fee is scenario_fee.max() { where: matches_filters }
  measure: total_scenario_fee is scenario_fee.sum() { where: matches_filters }

  view: aci_fee_ranking is {
    group_by: aci_value
    aggregate: matching_rule_count, avg_scenario_fee, min_scenario_fee, max_scenario_fee
    having: matching_rule_count > 0
    order_by: avg_scenario_fee asc, aci_value asc
  }
}

// -- MCC-level rule space (exploded) with description resolution
source: fee_rules_by_mcc(
  notional::number is 100,
  filter_card_scheme::string is null,
  filter_account_type::string is null,
  filter_aci::string is null,
  filter_is_credit::boolean is null,
  filter_intracountry::boolean is null
) is fee_rule_mcc_rows extend {

  // lookup stores mcc as VARCHAR; join on its numeric cast
  join_one: mcc_info is merchant_category_codes_base on mcc_value = mcc_info.mcc_code
  dimension: mcc_description is mcc_info.description

  dimension: scenario_fee is fixed_amount + rate * notional / 10000.0

  dimension: matches_filters is
    (filter_card_scheme is null or card_scheme = filter_card_scheme)
    and (filter_account_type is null
         or len!number(account_type) = 0
         or list_contains!boolean(account_type, filter_account_type))
    and (filter_aci is null
         or len!number(aci) = 0
         or list_contains!boolean(aci, filter_aci))
    and (filter_is_credit is null or is_credit is null or is_credit = filter_is_credit)
    and (filter_intracountry is null or intracountry is null
         or (filter_intracountry and intracountry = 1)
         or (not filter_intracountry and intracountry = 0))

  measure: matching_rule_count is count() { where: matches_filters }
  measure: avg_scenario_fee is scenario_fee.avg() { where: matches_filters }
  measure: min_scenario_fee is scenario_fee.min() { where: matches_filters }
  measure: max_scenario_fee is scenario_fee.max() { where: matches_filters }
  measure: total_scenario_fee is scenario_fee.sum() { where: matches_filters }

  view: mcc_fee_ranking is {
    group_by: mcc_value, mcc_description
    aggregate: matching_rule_count, avg_scenario_fee, min_scenario_fee, max_scenario_fee
    having: matching_rule_count > 0
    order_by: avg_scenario_fee desc, mcc_value asc
    limit: 10000
  }
}

// -- account-type-level rule space (exploded)
source: fee_rules_by_account_type(
  notional::number is 100,
  filter_card_scheme::string is null,
  filter_mcc::number is null,
  filter_aci::string is null,
  filter_is_credit::boolean is null,
  filter_intracountry::boolean is null
) is fee_rule_account_type_rows extend {

  dimension: scenario_fee is fixed_amount + rate * notional / 10000.0

  dimension: matches_filters is
    (filter_card_scheme is null or card_scheme = filter_card_scheme)
    and (filter_mcc is null
         or len!number(merchant_category_code) = 0
         or list_contains!boolean(merchant_category_code, filter_mcc))
    and (filter_aci is null
         or len!number(aci) = 0
         or list_contains!boolean(aci, filter_aci))
    and (filter_is_credit is null or is_credit is null or is_credit = filter_is_credit)
    and (filter_intracountry is null or intracountry is null
         or (filter_intracountry and intracountry = 1)
         or (not filter_intracountry and intracountry = 0))

  measure: matching_rule_count is count() { where: matches_filters }
  measure: avg_scenario_fee is scenario_fee.avg() { where: matches_filters }
  measure: min_scenario_fee is scenario_fee.min() { where: matches_filters }
  measure: max_scenario_fee is scenario_fee.max() { where: matches_filters }
  measure: total_scenario_fee is scenario_fee.sum() { where: matches_filters }

  view: account_type_fee_ranking is {
    group_by: account_type_value
    aggregate: matching_rule_count, avg_scenario_fee, min_scenario_fee, max_scenario_fee
    having: matching_rule_count > 0
    order_by: avg_scenario_fee asc, account_type_value asc
  }
}
