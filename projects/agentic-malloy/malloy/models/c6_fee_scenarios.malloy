##! experimental.parameters

// -------------------------------------------------------------------------
// Candidate universes (data-derived, never hardcoded)
// -------------------------------------------------------------------------
source: card_scheme_universe is payments_base -> {
  group_by: candidate_scheme is card_scheme
} extend {
  primary_key: candidate_scheme
}

// -------------------------------------------------------------------------
// Scheme steering: cross-fan each txn against every candidate scheme, then
// rematch rules with card_scheme := candidate. Candidate materialized as a
// REAL local column via projection so the rule join stays one level deep.
// -------------------------------------------------------------------------
source: fee_scheme_steering is payments_enriched extend {
  join_cross: schemes is card_scheme_universe
} -> {
  select:
    psp_reference
    merchant
    txn_date
    txn_month
    `year`
    day_of_year
    eur_amount
    card_scheme          // actual scheme, kept for reference/no-op comparison
    aci
    is_credit
    intracountry_flag
    is_intracountry
    account_type
    merchant_category_code
    capture_delay_bucket
    monthly_volume_bucket
    monthly_fraud_bucket
    has_fraudulent_dispute
    candidate_scheme is schemes.candidate_scheme
} extend {
  dimension: row_key is concat(psp_reference::string, '|', candidate_scheme)
  primary_key: row_key

  dimension: is_current_scheme is candidate_scheme = card_scheme

  // wildcard branch on every rule field; scheme matched against the CANDIDATE
  join_many: rules is fees_base(notional is null)
    on rules.card_scheme = candidate_scheme
    and (len!number(rules.account_type) = 0
         or list_contains!boolean(rules.account_type, account_type))
    and (len!number(rules.merchant_category_code) = 0
         or list_contains!boolean(rules.merchant_category_code, merchant_category_code))
    and (len!number(rules.aci) = 0
         or list_contains!boolean(rules.aci, aci))
    and (rules.capture_delay is null or rules.capture_delay = capture_delay_bucket)
    and (rules.monthly_volume is null or rules.monthly_volume = monthly_volume_bucket)
    and (rules.monthly_fraud_level is null or rules.monthly_fraud_level = monthly_fraud_bucket)
    and (rules.is_credit is null or rules.is_credit = is_credit)
    and (rules.intracountry is null or rules.intracountry = intracountry_flag)

  // match-grain fee measures; base-grain totals here would be inflated 4x by
  // the scheme sweep — use distinct-key counts only
  measure: candidate_total_fee is rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_avg_fee is rules.avg(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_min_fee is min(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_max_fee is max(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: matched_pair_count is rules.count()
  measure: matched_txn_count is count(psp_reference) { where: rules.ID is not null }
  measure: distinct_txn_count is count(psp_reference)

  // filter merchant + period last-mile; ties share rank = 1
  view: scheme_steering_ranking is {
    group_by: candidate_scheme
    aggregate: matched_txn_count, candidate_total_fee, candidate_avg_fee
    calculate: cheapest_rank is rank()
    order_by: candidate_total_fee asc, candidate_scheme asc
  }

  view: scheme_steering_ranking_desc is {
    group_by: candidate_scheme
    aggregate: matched_txn_count, candidate_total_fee, candidate_avg_fee
    calculate: most_expensive_rank is rank()
    order_by: candidate_total_fee desc, candidate_scheme asc
  }
}

// -------------------------------------------------------------------------
// ACI steering: cross-fan each txn against every observed ACI, rematch rules
// with aci := candidate (all other attributes held fixed). Typical use:
// filter has_fraudulent_dispute = true + merchant + period.
// -------------------------------------------------------------------------
source: fee_aci_steering is payments_enriched extend {
  join_cross: acis is payment_aci_universe
} -> {
  select:
    psp_reference
    merchant
    txn_date
    txn_month
    `year`
    day_of_year
    eur_amount
    card_scheme
    aci                  // actual ACI, needed for the candidate <> current guard
    is_credit
    intracountry_flag
    is_intracountry
    account_type
    merchant_category_code
    capture_delay_bucket
    monthly_volume_bucket
    monthly_fraud_bucket
    has_fraudulent_dispute
    candidate_aci is acis.candidate_aci
} extend {
  dimension: row_key is concat(psp_reference::string, '|', candidate_aci)
  primary_key: row_key

  dimension: is_current_aci is candidate_aci = aci

  join_many: rules is fees_base(notional is null)
    on rules.card_scheme = card_scheme
    and (len!number(rules.aci) = 0
         or list_contains!boolean(rules.aci, candidate_aci))
    and (len!number(rules.account_type) = 0
         or list_contains!boolean(rules.account_type, account_type))
    and (len!number(rules.merchant_category_code) = 0
         or list_contains!boolean(rules.merchant_category_code, merchant_category_code))
    and (rules.capture_delay is null or rules.capture_delay = capture_delay_bucket)
    and (rules.monthly_volume is null or rules.monthly_volume = monthly_volume_bucket)
    and (rules.monthly_fraud_level is null or rules.monthly_fraud_level = monthly_fraud_bucket)
    and (rules.is_credit is null or rules.is_credit = is_credit)
    and (rules.intracountry is null or rules.intracountry = intracountry_flag)

  measure: candidate_total_fee is rules.sum(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_avg_fee is rules.avg(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_min_fee is min(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: candidate_max_fee is max(rules.fixed_amount + rules.rate * eur_amount / 10000)
  measure: matched_pair_count is rules.count()
  measure: matched_txn_count is count(psp_reference) { where: rules.ID is not null }
  measure: distinct_txn_count is count(psp_reference)

  // guard: the no-op (current ACI) cannot win a reassignment ranking;
  // alphabetical secondary order = deterministic tie-break
  view: aci_steering_ranking is {
    where: candidate_aci != aci
    group_by: candidate_aci
    aggregate: matched_txn_count, candidate_total_fee, candidate_avg_fee
    calculate: cheapest_rank is rank()
    order_by: candidate_total_fee asc, candidate_aci asc
  }

  view: aci_steering_ranking_desc is {
    where: candidate_aci != aci
    group_by: candidate_aci
    aggregate: matched_txn_count, candidate_total_fee, candidate_avg_fee
    calculate: most_expensive_rank is rank()
    order_by: candidate_total_fee desc, candidate_aci asc
  }
}

// -------------------------------------------------------------------------
// Attribute / rule-parameter counterfactuals: baseline and scenario matches
// joined side by side so deltas come from ONE computation over ONE population.
// alt_* overrides re-run the MATCHING; new_rate / new_fixed_amount override a
// rule's price terms on the UNCHANGED baseline matches.
// -------------------------------------------------------------------------
source: fee_scenarios(
  alt_mcc::number is null,
  alt_account_type::string is null,
  alt_capture_delay_bucket::string is null,
  new_rate::number is null,
  new_fixed_amount::number is null
) is payments_enriched extend {

  // local-column picks only (params + real columns) — safe in join on-clauses
  dimension: scenario_mcc is
    pick alt_mcc when alt_mcc is not null else merchant_category_code
  dimension: scenario_account_type is
    pick alt_account_type when alt_account_type is not null else account_type
  dimension: scenario_capture_delay_bucket is
    pick alt_capture_delay_bucket when alt_capture_delay_bucket is not null else capture_delay_bucket

  join_many: baseline_rules is fees_base(notional is null)
    on baseline_rules.card_scheme = card_scheme
    and (len!number(baseline_rules.account_type) = 0
         or list_contains!boolean(baseline_rules.account_type, account_type))
    and (len!number(baseline_rules.merchant_category_code) = 0
         or list_contains!boolean(baseline_rules.merchant_category_code, merchant_category_code))
    and (len!number(baseline_rules.aci) = 0
         or list_contains!boolean(baseline_rules.aci, aci))
    and (baseline_rules.capture_delay is null or baseline_rules.capture_delay = capture_delay_bucket)
    and (baseline_rules.monthly_volume is null or baseline_rules.monthly_volume = monthly_volume_bucket)
    and (baseline_rules.monthly_fraud_level is null or baseline_rules.monthly_fraud_level = monthly_fraud_bucket)
    and (baseline_rules.is_credit is null or baseline_rules.is_credit = is_credit)
    and (baseline_rules.intracountry is null or baseline_rules.intracountry = intracountry_flag)

  // same predicate with counterfactual merchant attributes substituted
  join_many: scenario_rules is fees_base(notional is null)
    on scenario_rules.card_scheme = card_scheme
    and (len!number(scenario_rules.account_type) = 0
         or list_contains!boolean(scenario_rules.account_type, scenario_account_type))
    and (len!number(scenario_rules.merchant_category_code) = 0
         or list_contains!boolean(scenario_rules.merchant_category_code, scenario_mcc))
    and (len!number(scenario_rules.aci) = 0
         or list_contains!boolean(scenario_rules.aci, aci))
    and (scenario_rules.capture_delay is null or scenario_rules.capture_delay = scenario_capture_delay_bucket)
    and (scenario_rules.monthly_volume is null or scenario_rules.monthly_volume = monthly_volume_bucket)
    and (scenario_rules.monthly_fraud_level is null or scenario_rules.monthly_fraud_level = monthly_fraud_bucket)
    and (scenario_rules.is_credit is null or scenario_rules.is_credit = is_credit)
    and (scenario_rules.intracountry is null or scenario_rules.intracountry = intracountry_flag)

  // path-qualified sums use each join's pk, so the two fan-outs don't cross-inflate
  measure: baseline_total_fee is
    baseline_rules.sum(baseline_rules.fixed_amount + baseline_rules.rate * eur_amount / 10000)
  measure: scenario_total_fee is
    scenario_rules.sum(scenario_rules.fixed_amount + scenario_rules.rate * eur_amount / 10000)
  measure: total_fee_delta is
    scenario_rules.sum(scenario_rules.fixed_amount + scenario_rules.rate * eur_amount / 10000)
    - baseline_rules.sum(baseline_rules.fixed_amount + baseline_rules.rate * eur_amount / 10000)
  measure: baseline_avg_fee is
    baseline_rules.avg(baseline_rules.fixed_amount + baseline_rules.rate * eur_amount / 10000)
  measure: scenario_avg_fee is
    scenario_rules.avg(scenario_rules.fixed_amount + scenario_rules.rate * eur_amount / 10000)

  measure: baseline_matched_txn_count is count(psp_reference) { where: baseline_rules.ID is not null }
  measure: scenario_matched_txn_count is count(psp_reference) { where: scenario_rules.ID is not null }
  measure: baseline_rule_id_count is count(baseline_rules.ID)
  measure: scenario_rule_id_count is count(scenario_rules.ID)
  measure: affected_merchant_count is count(merchant) { where: baseline_rules.ID is not null }

  // price-term override on the SAME baseline matches; scope to one rule via
  // where: baseline_rules.ID = <id>
  measure: fee_delta_at_new_rate is
    baseline_rules.sum((new_rate - baseline_rules.rate) * eur_amount / 10000)
  measure: fee_delta_at_new_fixed_amount is
    baseline_rules.sum(new_fixed_amount - baseline_rules.fixed_amount)

  view: scenario_fee_delta_summary is {
    aggregate:
      baseline_matched_txn_count
      scenario_matched_txn_count
      baseline_total_fee
      scenario_total_fee
      total_fee_delta
  }

  view: scenario_fees_by_merchant is {
    group_by: merchant
    aggregate:
      baseline_matched_txn_count
      scenario_matched_txn_count
      baseline_total_fee
      scenario_total_fee
      total_fee_delta
    order_by: merchant asc
  }

  view: rule_override_delta_summary is {
    aggregate:
      baseline_matched_txn_count
      baseline_total_fee
      fee_delta_at_new_rate
      fee_delta_at_new_fixed_amount
  }

  // merchants whose matched-transaction population CHANGES under the overrides
  view: matching_membership_change is {
    group_by: merchant
    aggregate: baseline_matched_txn_count, scenario_matched_txn_count
    having: baseline_matched_txn_count != scenario_matched_txn_count
    order_by: merchant asc
  }

  // reverse lookup: merchants touched by baseline-matching rules; scope with
  // where: baseline_rules.ID = <id> (add attribute filters for restrictions)
  view: merchants_matching_rule is {
    where: baseline_rules.ID is not null
    group_by: merchant
    order_by: merchant asc
    limit: 100
  }
}
