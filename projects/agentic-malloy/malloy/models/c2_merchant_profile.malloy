source: merchant_profile is merchants_base extend {
  // MCC reference stores codes as VARCHAR; join on its numeric cast dimension
  join_one: mcc_info is merchant_category_codes_base
    on mcc_info.mcc_code = merchant_category_code

  // acquirer is a LIST column: list_contains = Malloy-side unnest (one row per acquirer)
  join_many: acquirer_map is acquirer_countries_base
    on list_contains!boolean(acquirer, acquirer_map.acquirer)

  // alias only — never usable in a further join_many on-clause
  dimension: mcc_description is mcc_info.description
  dimension: mcc_description_lower is mcc_info.description_lower

  // count(x) is distinct -> safe under acquirer fan-out; bare count() is NOT
  measure: distinct_merchant_count is count(merchant)
  measure: distinct_acquirer_count is count(acquirer_map.acquirer)
  measure: distinct_acquirer_country_count is count(acquirer_map.country_code)

  // one row per merchant: every merchant-side attribute needed for fee-rule matching
  view: merchant_attributes is {
    select:
      merchant, account_type, account_type_description,
      merchant_category_code, mcc_description,
      capture_delay, capture_delay_bucket, acquirer_list
    order_by: merchant asc
  }

  // one row per merchant × acquirer, with the acquirer's resolved country
  view: merchant_acquirer_countries is {
    group_by:
      merchant
      acquirer_name is acquirer_map.acquirer
      acquirer_country is acquirer_map.country_code
    order_by: merchant asc, acquirer_name asc
  }

  view: merchants_by_acquirer_country is {
    group_by: acquirer_country is acquirer_map.country_code
    aggregate: distinct_merchant_count, distinct_acquirer_count
    order_by: distinct_merchant_count desc
  }

  view: merchants_by_mcc is {
    group_by: merchant_category_code, mcc_description
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  view: merchants_by_account_type is {
    group_by: account_type, account_type_description
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  view: merchants_by_capture_delay_bucket is {
    group_by: capture_delay_bucket
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }
}
