source: merchant_dimensions is merchants_base extend {
  // mcc is VARCHAR in the lookup; mcc_string on merchants_base bridges the type gap
  join_one: mcc_lookup is merchant_category_codes_base on mcc_string = mcc_lookup.mcc

  // acquirer is a list column -> fan-out (one row per merchant x acquirer); 30-row table, cheap
  join_many: acquirer_geo is acquirer_countries_base
    on list_contains!boolean(acquirer, acquirer_geo.acquirer)

  dimension: mcc_description is mcc_lookup.description

  // grain caution: merchant_count uses count(distinct) so it survives the acquirer fan-out
  measure: distinct_merchant_count is count(merchant)
  measure: acquirer_country_count is count(acquirer_geo.country_code)
  measure: merchant_acquirer_pair_count is acquirer_geo.count()

  // one row per merchant: every attribute the fee rule-matching predicate consumes
  view: rule_matching_attributes is {
    select:
      merchant
      account_type
      account_type_description
      merchant_category_code
      mcc_description
      capture_delay
      capture_delay_bucket
    order_by: merchant
  }

  view: by_mcc_with_description is {
    group_by: merchant_category_code, mcc_description
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  view: by_account_type_described is {
    group_by: account_type, account_type_description
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  // merchant x acquirer grain (fanned): where each merchant's acquirers are located
  view: acquirer_geography is {
    group_by: merchant
    nest: acquirers is {
      group_by: acquirer_geo.acquirer, acquirer_geo.country_code
      order_by: acquirer asc
    }
    order_by: merchant
  }

  view: merchants_by_acquirer_country is {
    group_by: acquirer_geo.country_code
    aggregate: distinct_merchant_count, merchant_acquirer_pair_count
    order_by: distinct_merchant_count desc
  }
}
