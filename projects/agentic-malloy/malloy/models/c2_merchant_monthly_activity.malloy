// merchant × natural-month grain: collapse payments BEFORE any rule fan-out,
// then bucket volume/fraud into the exact fee-rule range strings
source: merchant_monthly_activity is payments_base -> {
  group_by:
    merchant
    txn_month
  aggregate:
    monthly_volume is eur_amount.sum()
    monthly_fraud_volume is eur_amount.sum() { where: has_fraudulent_dispute }
    monthly_txn_count is count()
    monthly_fraud_txn_count is count() { where: has_fraudulent_dispute }
} extend {
  primary_key: merchant_month_key
  // composite key so enriched payment rows can join_one back to their month stats
  dimension: merchant_month_key is concat(merchant, '|', txn_month::string)

  // fraud = fraudulent euro volume / total euro volume (volume-weighted, not row count)
  dimension: monthly_fraud_ratio is monthly_fraud_volume / monthly_volume
  dimension: monthly_fraud_ratio_pct is 100 * monthly_fraud_volume / monthly_volume

  // labels must EXACTLY match fees.monthly_volume domain: {'<100k','100k-1m','1m-5m','>5m'}
  dimension: monthly_volume_bucket is
    pick '<100k' when monthly_volume < 100000
    pick '100k-1m' when monthly_volume < 1000000
    pick '1m-5m' when monthly_volume < 5000000
    else '>5m'

  // labels must EXACTLY match fees.monthly_fraud_level domain: {'<7.2%','7.2%-7.7%','7.7%-8.3%','>8.3%'}
  dimension: monthly_fraud_bucket is
    pick '<7.2%' when monthly_fraud_ratio < 0.072
    pick '7.2%-7.7%' when monthly_fraud_ratio < 0.077
    pick '7.7%-8.3%' when monthly_fraud_ratio < 0.083
    else '>8.3%'

  measure: month_count is count()
  measure: merchant_count is count(merchant)

  measure: sum_monthly_volume is monthly_volume.sum()
  measure: avg_monthly_volume is monthly_volume.avg()
  measure: min_monthly_volume is monthly_volume.min()
  measure: max_monthly_volume is monthly_volume.max()

  measure: avg_monthly_fraud_ratio is monthly_fraud_ratio.avg()
  measure: min_monthly_fraud_ratio is monthly_fraud_ratio.min()
  measure: max_monthly_fraud_ratio is monthly_fraud_ratio.max()

  view: monthly_activity_detail is {
    select:
      merchant
      txn_month
      monthly_txn_count
      monthly_volume
      monthly_volume_bucket
      monthly_fraud_volume
      monthly_fraud_ratio
      monthly_fraud_bucket
    order_by: merchant, txn_month
  }

  view: by_volume_bucket is {
    group_by: monthly_volume_bucket
    aggregate:
      month_count
      merchant_count
      avg_monthly_volume
    order_by: month_count desc
  }

  view: by_fraud_bucket is {
    group_by: monthly_fraud_bucket
    aggregate:
      month_count
      merchant_count
      avg_monthly_fraud_ratio
    order_by: month_count desc
  }

  view: merchant_month_matrix is {
    group_by: merchant
    aggregate:
      month_count
      avg_monthly_volume
      avg_monthly_fraud_ratio
    nest: `months` is {
      group_by:
        txn_month
        monthly_volume_bucket
        monthly_fraud_bucket
      aggregate: sum_monthly_volume
      order_by: txn_month asc
    }
    order_by: merchant
  }
}
