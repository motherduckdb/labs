// merchant dimension enriched: MCC description + acquirer→country fan-out
// CAUTION: join_many on the acquirer list fans out rows (one per acquirer);
// use distinct_merchant_count (count(merchant)) — base merchant_count inflates here.
source: merchant_profiles is merchants_base extend {

  // BIGINT merchant code = numeric form of the VARCHAR lookup key
  join_one: mcc_lookup is merchant_category_codes_base
    on merchant_category_code = mcc_lookup.mcc_code

  // list membership join: acquirer is a VARCHAR[]; one matched row per acquirer
  join_many: acquirer_country is acquirer_countries_base
    on list_contains!boolean(acquirer, acquirer_country.acquirer)

  dimension: mcc_description is mcc_lookup.description
  dimension: acquiring_country is acquirer_country.country_code
  dimension: acquirer_name is acquirer_country.acquirer

  // fan-out-safe (distinct) counts
  measure: distinct_merchant_count is count(merchant)
  measure: acquiring_country_count is count(acquirer_country.country_code)
  measure: distinct_acquirer_count is count(acquirer_country.acquirer)

  // one row per merchant; acquirer fan-out collapsed into a nest
  view: profile is {
    group_by:
      merchant,
      account_type,
      account_type_description,
      merchant_category_code,
      mcc_description,
      capture_delay,
      capture_delay_bucket
    nest: acquirers is {
      group_by: acquirer_name, acquiring_country
      order_by: acquirer_name asc
    }
    order_by: merchant asc
  }

  view: by_acquiring_country is {
    group_by: acquiring_country
    aggregate: distinct_merchant_count, distinct_acquirer_count
    order_by: distinct_merchant_count desc
  }

  view: by_acquirer is {
    group_by: acquirer_name, acquiring_country
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  view: by_mcc_profile is {
    group_by: merchant_category_code, mcc_description
    aggregate: distinct_merchant_count
    order_by: distinct_merchant_count desc
  }

  view: by_account_type_profile is {
    group_by: account_type, account_type_description
    aggregate: distinct_merchant_count, acquiring_country_count
    order_by: distinct_merchant_count desc
  }
}
