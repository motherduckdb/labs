##! experimental.parameters

// ---------------------------------------------------------------------------
// Candidate universes for counterfactual fan-out (derived from the DATA).
// aci_universe already exists (c3); card_scheme_universe is new here.
// ---------------------------------------------------------------------------
source: card_scheme_universe is payments_base -> { group_by: card_scheme }


// ---------------------------------------------------------------------------
// STEERING: cross each transaction with every card-scheme candidate and
// MATERIALIZE candidate_scheme as a real local column (projection) so the fee
// fan-out can match on it without reaching through the cross join.
// ---------------------------------------------------------------------------
source: c5_txn_x_scheme is c4_txn_enriched extend {
  join_cross: scheme is card_scheme_universe
} -> {
  select:
    psp_reference
    merchant
    day_of_year
    transaction_month
    eur_amount
    is_credit
    aci
    is_intracountry
    account_type
    merchant_category_code
    capture_delay_band
    volume_band
    fraud_band
    candidate_scheme is scheme.card_scheme   // counterfactual routing target
}

source: c5_scheme_steering is c5_txn_x_scheme extend {
  // match every transaction as if routed through candidate_scheme; all other
  // attributes stay the transaction's actual values (wildcard-aware branches).
  join_many: fee is duckdb.table('fees') extend { primary_key: ID }
    on
      fee.card_scheme = candidate_scheme
      and (len!number(fee.account_type) = 0 or list_contains!boolean(fee.account_type, account_type))
      and (fee.capture_delay is null or fee.capture_delay = capture_delay_band)
      and (fee.monthly_fraud_level is null or fee.monthly_fraud_level = fraud_band)
      and (fee.monthly_volume is null or fee.monthly_volume = volume_band)
      and (len!number(fee.merchant_category_code) = 0 or list_contains!boolean(fee.merchant_category_code, merchant_category_code))
      and (fee.is_credit is null or fee.is_credit = is_credit)
      and (len!number(fee.aci) = 0 or list_contains!boolean(fee.aci, aci))
      and (fee.intracountry is null or (fee.intracountry = 1) = is_intracountry)

  measure: txn_count   is count(psp_reference)
  // per-match fee at fee grain (combines fee cols + base eur_amount)
  measure: total_fees is fee.sum(fee.fixed_amount + fee.rate * eur_amount / 10000)
  measure: avg_fee    is fee.avg(fee.fixed_amount + fee.rate * eur_amount / 10000)
  measure: min_fee    is min(fee.fixed_amount + fee.rate * eur_amount / 10000)
  measure: max_fee    is max(fee.fixed_amount + fee.rate * eur_amount / 10000)

  // total/avg fee per counterfactual scheme; caller filters merchant+period,
  // then order_by asc (minimum steer) or desc (maximum steer) + limit 1.
  view: steer_by_scheme is {
    group_by: candidate_scheme
    aggregate: txn_count, total_fees, avg_fee, min_fee, max_fee
    order_by: total_fees
  }
}


// ---------------------------------------------------------------------------
// FRAUD ACI REALLOCATION: for FRAUDULENT transactions only, cross with every
// ACI candidate and MATERIALIZE candidate_aci; recompute fees as if those
// transactions used that ACI (card_scheme stays actual).
// ---------------------------------------------------------------------------
source: c5_fraud_txn_x_aci is c4_txn_enriched extend {
  join_cross: aci_alt is aci_universe   // aci_universe field is `aci`
} -> {
  where: has_fraudulent_dispute
  select:
    psp_reference
    merchant
    day_of_year
    transaction_month
    eur_amount
    card_scheme
    is_credit
    is_intracountry
    account_type
    merchant_category_code
    capture_delay_band
    volume_band
    fraud_band
    candidate_aci is aci_alt.aci   // counterfactual ACI target
}

source: c5_aci_reallocation is c5_fraud_txn_x_aci extend {
  join_many: fee is duckdb.table('fees') extend { primary_key: ID }
    on
      fee.card_scheme = card_scheme
      and (len!number(fee.account_type) = 0 or list_contains!boolean(fee.account_type, account_type))
      and (fee.capture_delay is null or fee.capture_delay = capture_delay_band)
      and (fee.monthly_fraud_level is null or fee.monthly_fraud_level = fraud_band)
      and (fee.monthly_volume is null or fee.monthly_volume = volume_band)
      and (len!number(fee.merchant_category_code) = 0 or list_contains!boolean(fee.merchant_category_code, merchant_category_code))
      and (fee.is_credit is null or fee.is_credit = is_credit)
      // ACI reassigned to the candidate; empty list = applies to all
      and (len!number(fee.aci) = 0 or list_contains!boolean(fee.aci, candidate_aci))
      and (fee.intracountry is null or (fee.intracountry = 1) = is_intracountry)

  measure: txn_count   is count(psp_reference)
  measure: total_fees is fee.sum(fee.fixed_amount + fee.rate * eur_amount / 10000)
  measure: avg_fee    is fee.avg(fee.fixed_amount + fee.rate * eur_amount / 10000)

  // cost of routing the merchant's fraudulent transactions through each ACI;
  // caller filters merchant+period, order_by total_fees asc + limit 1 (cheapest).
  view: reallocate_by_aci is {
    group_by: candidate_aci
    aggregate: txn_count, total_fees, avg_fee
    order_by: total_fees
  }
}


// ---------------------------------------------------------------------------
// FEE-CHANGE DELTA: counterfactual override of a single rule's `rate`.
// Match transactions to ALL applicable rules (actual attributes), keep only
// the pairs for the target fee ID, and compute the per-transaction delta from
// the rate change (fixed_amount unchanged, so delta = (new-old)*amount/10000).
// ---------------------------------------------------------------------------
source: c5_fee_rate_delta(
  target_fee_id::number is null,
  new_rate::number      is null
) is c4_txn_enriched extend {
  join_many: fee is duckdb.table('fees') extend { primary_key: ID }
    on
      fee.card_scheme = card_scheme
      and (len!number(fee.account_type) = 0 or list_contains!boolean(fee.account_type, account_type))
      and (fee.capture_delay is null or fee.capture_delay = capture_delay_band)
      and (fee.monthly_fraud_level is null or fee.monthly_fraud_level = fraud_band)
      and (fee.monthly_volume is null or fee.monthly_volume = volume_band)
      and (len!number(fee.merchant_category_code) = 0 or list_contains!boolean(fee.merchant_category_code, merchant_category_code))
      and (fee.is_credit is null or fee.is_credit = is_credit)
      and (len!number(fee.aci) = 0 or list_contains!boolean(fee.aci, aci))
      and (fee.intracountry is null or (fee.intracountry = 1) = is_intracountry)

  measure: txn_count       is count(psp_reference)
  measure: original_fees   is fee.sum(fee.fixed_amount + fee.rate * eur_amount / 10000)
  measure: modified_fees   is fee.sum(fee.fixed_amount + new_rate * eur_amount / 10000)
  // signed delta (modified - original) attributable to the rate override
  measure: fee_delta       is fee.sum((new_rate - fee.rate) * eur_amount / 10000)

  // scope: instantiate target_fee_id + new_rate; caller adds merchant + period.
  view: rate_change_delta is {
    where: fee.ID = target_fee_id
    aggregate: txn_count, original_fees, modified_fees, fee_delta
  }
}
