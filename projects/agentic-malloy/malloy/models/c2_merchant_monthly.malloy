// c2_merchant_monthly.malloy
// Per-merchant per-month rollup of payments.
//
// Purpose: produce the inputs the fee model needs to bucket a merchant
// into the `monthly_volume` and `monthly_fraud_level` tier strings that
// fees.json keys on (manual §5):
//   * total monthly EUR volume       -> bucketed -> monthly_volume_tier
//   * monthly fraudulent EUR volume  -> ratio    -> monthly_fraud_level_tier
//
// Also carries the merchant's per-month account_type, capture_delay and
// merchant_category_code so the downstream fee join can match those
// fields without re-traversing merchants.
//
// One row per (merchant, year, month). Source-of-a-query pattern: the
// first stage materializes the rollup, then we `extend` it with the
// bucket dimensions.

source: c2_merchant_monthly is c1_payments -> {
  group_by:
    merchant
    `year` is `year`
    month_num is date_part!number('month', transaction_date)
    month_start is transaction_date.month
    account_type
    capture_delay
    merchant_category_code
  aggregate:
    total_eur_volume is eur_amount.sum()
    fraud_eur_volume is eur_amount.sum() { where: has_fraudulent_dispute }
    txn_count is count()
    fraud_txn_count is count() { where: has_fraudulent_dispute }
} extend {

  //----------------------------------------------------------------------
  // Derived ratios
  //----------------------------------------------------------------------
  dimension: fraud_rate is
    pick 0.0 when total_eur_volume = 0
    else fraud_eur_volume / total_eur_volume

  dimension: fraud_txn_rate is
    pick 0.0 when txn_count = 0
    else fraud_txn_count * 1.0 / txn_count

  //----------------------------------------------------------------------
  // monthly_volume tier (matches fees.monthly_volume string values).
  //
  // Fees.json uses tier strings like '100k-1m', '1m-5m'. We bucket the
  // merchant's *actual* total EUR volume for the month into those
  // boundaries. Order matters (first matching `pick` wins).
  //----------------------------------------------------------------------
  dimension: monthly_volume_tier is
    pick '<100k'   when total_eur_volume < 100000
    pick '100k-1m' when total_eur_volume < 1000000
    pick '1m-5m'   when total_eur_volume < 5000000
    pick '5m-10m'  when total_eur_volume < 10000000
    pick '10m-50m' when total_eur_volume < 50000000
    else '50m+'

  //----------------------------------------------------------------------
  // monthly_fraud_level tier (matches fees.monthly_fraud_level strings).
  //
  // The manual gives '7.7%-8.3%' as an example; tiers in fees.json are
  // contiguous percent bands. We bucket the merchant's monthly fraud
  // ratio (fraud volume / total volume) into the same bands so the fee
  // rule can match by string equality. First matching `pick` wins.
  //----------------------------------------------------------------------
  dimension: monthly_fraud_level_tier is
    pick '<1%'       when fraud_rate < 0.01
    pick '1%-3%'     when fraud_rate < 0.03
    pick '3%-5%'     when fraud_rate < 0.05
    pick '5%-7.7%'   when fraud_rate < 0.077
    pick '7.7%-8.3%' when fraud_rate < 0.083
    pick '8.3%-9.3%' when fraud_rate < 0.093
    else '>9.3%'

  //----------------------------------------------------------------------
  // Convenience helpers
  //----------------------------------------------------------------------
  dimension: merchant_month_key is
    concat(merchant, '|', `year`::string, '|', month_num::string)

  dimension: is_high_fraud is fraud_rate >= 0.05
  dimension: is_high_volume is total_eur_volume >= 1000000

  //----------------------------------------------------------------------
  // Measures (aggregate across many merchant-months)
  //----------------------------------------------------------------------
  measure: merchant_month_count is count()
  measure: distinct_merchants    is count(merchant)
  measure: total_volume_eur      is total_eur_volume.sum()
  measure: total_fraud_volume_eur is fraud_eur_volume.sum()
  measure: total_txn_count        is txn_count.sum()
  measure: total_fraud_txn_count  is fraud_txn_count.sum()
  measure: avg_monthly_volume     is total_eur_volume.avg()
  measure: avg_monthly_fraud_rate is fraud_rate.avg()

  //----------------------------------------------------------------------
  // Views
  //----------------------------------------------------------------------
  view: by_merchant_month is {
    select:
      merchant
      `year`
      month_num
      account_type
      capture_delay
      merchant_category_code
      total_eur_volume
      fraud_eur_volume
      fraud_rate
      monthly_volume_tier
      monthly_fraud_level_tier
    order_by: merchant asc, `year` asc, month_num asc
  }

  view: by_volume_tier is {
    group_by: monthly_volume_tier
    aggregate:
      merchant_month_count
      distinct_merchants
      total_volume_eur
    order_by: total_volume_eur desc
  }

  view: by_fraud_tier is {
    group_by: monthly_fraud_level_tier
    aggregate:
      merchant_month_count
      distinct_merchants
      total_volume_eur
      total_fraud_volume_eur
    order_by: total_fraud_volume_eur desc
  }
}
