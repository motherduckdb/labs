# OpenRouter API key (LLM routing for author/fixer models)
OPENROUTER_API_KEY=

# MotherDuck read-scaling token — exploration + scored-answer execution run on
# MotherDuck via MCP (see README). Build-time `load` also uses it if you build
# the MotherDuck DB; the local DuckDB build (Malloy compile) does not need it.
MOTHERDUCK_TOKEN=

# MotherDuck database name to query (defaults to agentic_malloy)
MD_DATABASE=agentic_malloy
