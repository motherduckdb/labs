# OpenRouter API key (LLM routing for author/fixer models)
OPENROUTER_API_KEY=

# MotherDuck read-scaling token — exploration + scored-answer execution run on
# MotherDuck via MCP (see README). Build-time `load` also uses it if you build
# the MotherDuck DB; the local DuckDB build (Malloy compile) does not need it.
MOTHERDUCK_TOKEN=

# MotherDuck database the agent queries + executes the compiled answer against.
# Defaults to the baseline's existing DB (agentic_sql_claude) — identical data,
# already loaded — so no separate MotherDuck build is needed for a first run.
MD_DATABASE=agentic_sql_claude
